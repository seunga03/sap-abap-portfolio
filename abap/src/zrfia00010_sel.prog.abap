*&---------------------------------------------------------------------*
*& Include ZRFIA00010_SEL - SCR 1000
*&---------------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK b0 WITH FRAME TITLE TEXT-t00.   " 프로그램 안내
  SELECTION-SCREEN COMMENT /1(79) TEXT-i01.
  SELECTION-SCREEN COMMENT /1(79) TEXT-i02.
SELECTION-SCREEN END OF BLOCK b0.

SELECTION-SCREEN BEGIN OF BLOCK b1 WITH FRAME TITLE TEXT-t01.   " 빠른 조회
  SELECTION-SCREEN BEGIN OF LINE.
    PARAMETERS p_q_np RADIOBUTTON GROUP gq DEFAULT 'X'.
    SELECTION-SCREEN COMMENT 4(18) TEXT-q01 FOR FIELD p_q_np.   " 확인서 미출력
    PARAMETERS p_q_op RADIOBUTTON GROUP gq.
    SELECTION-SCREEN COMMENT 26(18) TEXT-q02 FOR FIELD p_q_op.  " 잔액 남은 건
    PARAMETERS p_q_al RADIOBUTTON GROUP gq.
    SELECTION-SCREEN COMMENT 48(10) TEXT-q03 FOR FIELD p_q_al.  " 전체
  SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN END OF BLOCK b1.

SELECTION-SCREEN BEGIN OF BLOCK b2 WITH FRAME TITLE TEXT-t02.   " 조회 대상
  SELECTION-SCREEN BEGIN OF LINE.
    PARAMETERS p_ap RADIOBUTTON GROUP g1 DEFAULT 'X' USER-COMMAND ucg1.
    SELECTION-SCREEN COMMENT 4(18) TEXT-g01 FOR FIELD p_ap.     " 매입채무(AP)
    PARAMETERS p_ar RADIOBUTTON GROUP g1.
    SELECTION-SCREEN COMMENT 26(18) TEXT-g02 FOR FIELD p_ar.    " 매출채권(AR)
    PARAMETERS p_all RADIOBUTTON GROUP g1.
    SELECTION-SCREEN COMMENT 48(10) TEXT-g03 FOR FIELD p_all.   " 전체
  SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN END OF BLOCK b2.

SELECTION-SCREEN BEGIN OF BLOCK b3 WITH FRAME TITLE TEXT-t03.   " 기본 조건
  SELECT-OPTIONS: s_clrdt FOR gv_clrdt OBLIGATORY,
                  s_lifnr FOR gv_lifnr MODIF ID lif,
                  s_kunnr FOR gv_kunnr MODIF ID kun.
  SELECTION-SCREEN PUSHBUTTON /1(24) btn_dtl USER-COMMAND tgdt.   " [+ 상세조건 열기]
SELECTION-SCREEN END OF BLOCK b3.

SELECTION-SCREEN BEGIN OF BLOCK b4 WITH FRAME TITLE TEXT-t04.   " 상세 조건
  SELECT-OPTIONS: s_clrnr FOR gv_clrnr MODIF ID dtl,
                  s_orgnr FOR gv_orgnr MODIF ID dtl.
  PARAMETERS:     p_waers TYPE waers DEFAULT 'KRW' MODIF ID dtl,
                  p_adj   AS CHECKBOX DEFAULT 'X' MODIF ID dtl.
SELECTION-SCREEN END OF BLOCK b4.

SELECTION-SCREEN FUNCTION KEY 1.                                  " [초기화]
