<mvc:View controllerName="zsd.salesboard.controller.Main"                                                                                                                                                                                                      
    xmlns:mvc="sap.ui.core.mvc"                                                                                                                                                                                                                                
    xmlns:core="sap.ui.core"                                                                                                                                                                                                                                   
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"                                                                                                                                                                               
    xmlns="sap.m">                                                                                                                                                                                                                                             
    <Page id="page" title="판매 프로세스 대시보드" class="sapUiNoContentPadding" enableScrolling="false">                                                                                                                                                                
        <subHeader>                                                                                                                                                                                                                                            
            <OverflowToolbar id="filterBar">                                                                                                                                                                                                                   
                <Label id="label1" text="주문일" labelFor="drs"/>                                                                                                                                                                                                 
                <DateRangeSelection id="drs" width="15rem" displayFormat="yyyy.MM.dd"                                                                                                                                                                          
                    dateValue="{dash>/from}" secondDateValue="{dash>/to}" change=".onSearch"/>                                                                                                                                                                 
                <Button id="button2" text="이번 달" press=".onQuick" app:key="TM"/>                                                                                                                                                                               
                <Button id="button3" text="지난 달" press=".onQuick" app:key="LM"/>                                                                                                                                                                               
                <Button id="button4" text="올해" press=".onQuick" app:key="TY"/>                                                                                                                                                                                 
                <ToolbarSpacer id="toolbarSpacer5"/>                                                                                                                                                                                                           
                <Button id="button6" text="조회" type="Emphasized" icon="sap-icon://search" press=".onSearch"/>                                                                                                                                                  
            </OverflowToolbar>                                                                                                                                                                                                                                 
        </subHeader>                                                                                                                                                                                                                                           
        <content>                                                                                                                                                                                                                                              
          <!-- 위 대시보드는 고정, 아래 목록만 스크롤 -->                                                                                                                                                                                                                      
          <FlexBox id="flexMain" direction="Column" fitContainer="true" renderType="Bare">                                                                                                                                                                     
            <!-- 카드 + 차트 (ZCL_CM_KPI_HTML 과 같은 디자인) -->                                                                                                                                                                                                        
            <core:HTML id="dashHtml" content="{dash>/html}" sanitizeContent="false" preferDOM="false"                                                                                                                                                          
                afterRendering=".onHtmlRendered"/>                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            <!-- 판매오더 목록 (이 부분만 스크롤) -->                                                                                                                                                                                                                       
            <ScrollContainer id="listScroll" vertical="true" horizontal="false" height="100%">                                                                                                                                                                 
              <layoutData>                                                                                                                                                                                                                                     
                <FlexItemData id="flexItemList" growFactor="1" baseSize="0" minHeight="0"/>                                                                                                                                                                    
              </layoutData>                                                                                                                                                                                                                                    
            <Table id="list" items="{dash>/rows}"                                                                                                                                                                                                              
                sticky="ColumnHeaders" noDataText="조회 기간에 주문이 없어요"                                                                                                                                                                                             
                class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">                                                                                                                                                                                       
                <headerToolbar>                                                                                                                                                                                                                                
                    <OverflowToolbar id="overflowToolbar7">                                                                                                                                                                                                    
                        <Title id="title8" text="{dash>/listTitle}" level="H2"/>                                                                                                                                                                               
                        <ToolbarSpacer id="toolbarSpacer9"/>                                                                                                                                                                                                   
                        <SegmentedButton id="sortBtn" selectedKey="URG" selectionChange=".onSortChange">                                                                                                                                                       
                            <items>                                                                                                                                                                                                                            
                                <SegmentedButtonItem id="sortUrg" key="URG" text="급한 순"/>                                                                                                                                                                      
                                <SegmentedButtonItem id="sortReq" key="REQ" text="납기순"/>                                                                                                                                                                       
                                <SegmentedButtonItem id="sortNew" key="NEW" text="최신순"/>                                                                                                                                                                       
                                <SegmentedButtonItem id="sortStep" key="STEP" text="진행단계순"/>                                                                                                                                                                   
                            </items>                                                                                                                                                                                                                           
                        </SegmentedButton>                                                                                                                                                                                                                     
                        <SearchField id="searchField10" width="16rem" placeholder="판매문서 · 고객명 검색" liveChange=".onListSearch"/>                                                                                                                                 
                    </OverflowToolbar>                                                                                                                                                                                                                         
                </headerToolbar>                                                                                                                                                                                                                               
                <columns>                                                                                                                                                                                                                                      
                    <Column id="column11" width="9rem"><Text id="text12" text="SO상태"/></Column>                                                                                                                                                                
                    <Column id="column13" width="20rem"><Text id="text14" text="진행 상황 · 지연 사유"/></Column>                                                                                                                                                      
                    <Column id="column15"><Text id="text16" text="판매문서"/></Column>                                                                                                                                                                             
                    <Column id="column17"><Text id="text18" text="주문일"/></Column>                                                                                                                                                                              
                    <Column id="column17b"><Text id="text18b" text="요청납기일"/></Column>                                                                                                                                                                          
                    <Column id="column19"><Text id="text20" text="고객명"/></Column>                                                                                                                                                                              
                    <Column id="column21" hAlign="End"><Text id="text22" text="합계금액"/></Column>                                                                                                                                                                
                    <Column id="column23" minScreenWidth="Desktop" demandPopin="true"><Text id="text24" text="출고일"/></Column>                                                                                                                                  
                    <Column id="column25" minScreenWidth="Desktop" demandPopin="true"><Text id="text26" text="청구일"/></Column>                                                                                                                                  
                </columns>                                                                                                                                                                                                                                     
                <items>                                                                                                                                                                                                                                        
                    <ColumnListItem id="columnListItem27" type="Active" press=".onRowPress">                                                                                                                                                                   
                        <customData>                                                                                                                                                                                                                           
                            <core:CustomData key="done" value="{dash>done}" writeToDom="true"/>                                                                                                                                                                
                            <core:CustomData key="act" value="{dash>act}" writeToDom="true"/>                                                                                                                                                                  
                        </customData>                                                                                                                                                                                                                          
                        <cells>                                                                                                                                                                                                                                
                            <ObjectStatus id="objectStatus28" text="{dash>stageText}" state="{dash>stageState}" inverted="true"/>                                                                                                                              
                            <VBox id="vbox29">                                                                                                                                                                                                                 
                                <ObjectStatus id="objectStatus29" text="{dash>progMain}" state="{dash>progState}" icon="{dash>progIcon}"/>                                                                                                                     
                                <Text id="text29b" text="{dash>progSub}" class="sapUiTinyMarginTop"/>                                                                                                                                                          
                            </VBox>                                                                                                                                                                                                                            
                            <Link id="text30" text="{dash>SoNumber}" press=".onRowPress"/>                                                                                                                                                                     
                            <Text id="text31" text="{dash>orderDate}"/>                                                                                                                                                                                        
                            <VBox id="vbox31b">                                                                                                                                                                                                                
                                <Text id="text31b" text="{dash>reqDate}"/>                                                                                                                                                                                     
                                <ObjectStatus id="objectStatus31c" text="{dash>dText}" state="{dash>dState}"/>                                                                                                                                                 
                            </VBox>                                                                                                                                                                                                                            
                            <Text id="text32" text="{dash>CustomerName}"/>                                                                                                                                                                                     
                            <ObjectNumber id="objectNumber33" number="{dash>amountText}" unit="{dash>Currency}" state="Information" emphasized="true"/>                                                                                                        
                            <Text id="text34" text="{dash>giText}"/>                                                                                                                                                                                           
                            <Text id="text35" text="{dash>biText}"/>                                                                                                                                                                                           
                        </cells>                                                                                                                                                                                                                               
                    </ColumnListItem>                                                                                                                                                                                                                          
                </items>                                                                                                                                                                                                                                       
            </Table>                                                                                                                                                                                                                                           
            </ScrollContainer>                                                                                                                                                                                                                                 
          </FlexBox>                                                                                                                                                                                                                                           
        </content>                                                                                                                                                                                                                                             
    </Page>                                                                                                                                                                                                                                                    
</mvc:View>                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               