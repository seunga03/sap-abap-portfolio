        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                               
        // 정확도 평가 데이터 및 KPI 갱신                                                                                                                                                                                                                                 
        _refreshAccuracyEvaluation: function () {                                                                                                                                                                                                              
            const oDash = this.getView().getModel("dash");                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            if (!this._accuracyLoaded) {                                                                                                                                                                                                                       
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 공통 검색조건 적용                                                                                                                                                                                                                                      
            const rows = this._getFilteredAccuracyRows();                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            // 활성 예측만 평가                                                                                                                                                                                                                                       
            const active = ForecastAnalyzer                                                                                                                                                                                                                    
                .getActiveForecasts(rows);                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            const kpi = ForecastAnalyzer                                                                                                                                                                                                                       
                .calculateAccuracyKpi(rows);                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            // AI와 최종 예측의 WAPE 차이로 전체 조정 효과 판정                                                                                                                                                                                                                 
            let verdictText = "평가 완료 후 조정 효과를 확인할 수 있습니다.";                                                                                                                                                                                                    
            let verdictState = "Information";                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (kpi.wapeAvailable) {                                                                                                                                                                                                                           
                const diff = kpi.aiWape - kpi.finalWape;                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                if (diff > 0.000001) {                                                                                                                                                                                                                         
                    verdictText =                                                                                                                                                                                                                              
                        `담당자 조정 후 전체 오차율이 ` +                                                                                                                                                                                                                  
                        `${diff.toFixed(2)}%p 감소했습니다. ` +                                                                                                                                                                                                      
                        `조정 기준의 유지 여부를 검토하세요.`;                                                                                                                                                                                                                
                    verdictState = "Success";                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                } else if (diff < -0.000001) {                                                                                                                                                                                                                 
                    verdictText =                                                                                                                                                                                                                              
                        `담당자 조정 후 전체 오차율이 ` +                                                                                                                                                                                                                  
                        `${Math.abs(diff).toFixed(2)}%p 증가했습니다. ` +                                                                                                                                                                                            
                        `AI 예측값과 담당자 조정 기준을 재검토하세요.`;                                                                                                                                                                                                          
                    verdictState = "Warning";                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                } else {                                                                                                                                                                                                                                       
                    verdictText =                                                                                                                                                                                                                              
                        "AI와 최종 예측의 전체 오차율이 동일합니다. " +                                                                                                                                                                                                         
                        "자재별 조정 결과를 확인하세요.";                                                                                                                                                                                                                   
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            const percentText = value => {                                                                                                                                                                                                                     
                return value == null                                                                                                                                                                                                                           
                    ? "—"                                                                                                                                                                                                                                      
                    : value.toFixed(2) + "%";                                                                                                                                                                                                                  
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            const effectText = value => {                                                                                                                                                                                                                      
                if (value == null) {                                                                                                                                                                                                                           
                    return "—";                                                                                                                                                                                                                                
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                return (value > 0 ? "+" : "") +                                                                                                                                                                                                                
                    formatQty(value) +                                                                                                                                                                                                                         
                    (kpi.unit ? " " + kpi.unit : "");                                                                                                                                                                                                          
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            let message = "";                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (active.length === 0) {                                                                                                                                                                                                                         
                message =                                                                                                                                                                                                                                      
                    "검색조건에 해당하는 활성 예측이 없습니다.";                                                                                                                                                                                                                 
            } else if (kpi.completedCount === 0) {                                                                                                                                                                                                             
                message =                                                                                                                                                                                                                                      
                    "평가 완료된 활성 예측이 없습니다. " +                                                                                                                                                                                                                   
                    "예측기간 종료 후 정확도 평가가 가능합니다.";                                                                                                                                                                                                                
            } else if (kpi.mixedUnits) {                                                                                                                                                                                                                       
                message =                                                                                                                                                                                                                                      
                    "평가 완료 데이터에 서로 다른 수량 단위가 " +                                                                                                                                                                                                               
                    "포함되어 있어 통합 WAPE를 표시하지 않습니다.";                                                                                                                                                                                                             
            } else if (!kpi.wapeAvailable) {                                                                                                                                                                                                                   
                message =                                                                                                                                                                                                                                      
                    "평가 완료 데이터의 실제 수요량 합계가 " +                                                                                                                                                                                                                 
                    "0이므로 WAPE를 계산할 수 없습니다.";                                                                                                                                                                                                                  
            } else {                                                                                                                                                                                                                                           
                message =                                                                                                                                                                                                                                      
                    "평가 완료된 활성 예측을 기준으로 " +                                                                                                                                                                                                                    
                    "정확도 지표를 계산했습니다.";                                                                                                                                                                                                                         
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // KPI 모델 설정                                                                                                                                                                                                                                       
            // oDash.setProperty("/accuracyKpi", {                                                                                                                                                                                                             
            //     completedCount: kpi.completedCount,                                                                                                                                                                                                         
            //     inProgressCount: kpi.inProgressCount,                                                                                                                                                                                                       
            //     waitingCount: kpi.waitingCount,                                                                                                                                                                                                             
            //     aiWapeText: percentText(kpi.aiWape),                                                                                                                                                                                                        
            //     finalWapeText: percentText(kpi.finalWape),                                                                                                                                                                                                  
            //     effectText: effectText(                                                                                                                                                                                                                     
            //         kpi.adjustmentEffect                                                                                                                                                                                                                    
            //     ),                                                                                                                                                                                                                                          
            //     evaluationMessage: message                                                                                                                                                                                                                  
            // });                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            oDash.setProperty("/accuracyKpi", {                                                                                                                                                                                                                
                completedCount: kpi.completedCount,                                                                                                                                                                                                            
                inProgressCount: kpi.inProgressCount,                                                                                                                                                                                                          
                waitingCount: kpi.waitingCount,                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                aiWapeText: percentText(kpi.aiWape),                                                                                                                                                                                                           
                finalWapeText: percentText(kpi.finalWape),                                                                                                                                                                                                     
                effectText: effectText(kpi.adjustmentEffect),                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                // 전체 조정 효과 판정                                                                                                                                                                                                                                 
                verdictText: verdictText,                                                                                                                                                                                                                      
                verdictState: verdictState,                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                evaluationMessage: message                                                                                                                                                                                                                     
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 상세 목록: 평가 대기 포함, 활성 예측 전체                                                                                                                                                                                                                       
            const detailRows = active.map(function (row) {                                                                                                                                                                                                     
                const eligible =                                                                                                                                                                                                                               
                    row.EvalStatus === "DONE" &&                                                                                                                                                                                                               
                    row.EvalEligible === "X";                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                const apeAvailable =                                                                                                                                                                                                                           
                    eligible &&                                                                                                                                                                                                                                
                    row.ApeAvailable === "X";                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                let statusText = "평가 대기";                                                                                                                                                                                                                      
                let statusState = "Information";                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                if (row.EvalStatus === "PROG") {                                                                                                                                                                                                               
                    statusText = "진행 중";                                                                                                                                                                                                                       
                    statusState = "Warning";                                                                                                                                                                                                                   
                } else if (eligible) {                                                                                                                                                                                                                         
                    statusText = "평가 완료";                                                                                                                                                                                                                      
                    statusState = "Success";                                                                                                                                                                                                                   
                } else if (row.EvalStatus === "DONE") {                                                                                                                                                                                                        
                    statusText = "평가 불가";                                                                                                                                                                                                                      
                    statusState = "Warning";                                                                                                                                                                                                                   
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                // 실제 담당자 조정 여부                                                                                                                                                                                                                                
                const adjusted =                                                                                                                                                                                                                               
                    Math.abs(                                                                                                                                                                                                                                  
                        toNumber(row.Aiqty) - toNumber(row.Fiqty)                                                                                                                                                                                              
                    ) > 0.000001;                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                // 평가가 완료된 조정 항목의 절대오차 비교                                                                                                                                                                                                                      
                const worsened =                                                                                                                                                                                                                               
                    eligible &&                                                                                                                                                                                                                                
                    adjusted &&                                                                                                                                                                                                                                
                    toNumber(row.FiAbsErr) >                                                                                                                                                                                                                   
                        toNumber(row.AiAbsErr) + 0.000001;                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                const improved =                                                                                                                                                                                                                               
                    eligible &&                                                                                                                                                                                                                                
                    adjusted &&                                                                                                                                                                                                                                
                    toNumber(row.FiAbsErr) <                                                                                                                                                                                                                   
                        toNumber(row.AiAbsErr) - 0.000001;                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                // 업무 판정                                                                                                                                                                                                                                       
                let judgmentText = "미평가";                                                                                                                                                                                                                      
                let judgmentState = "None";                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                if (eligible) {                                                                                                                                                                                                                                
                    if (!adjusted) {                                                                                                                                                                                                                           
                        judgmentText = "조정 없음";                                                                                                                                                                                                                
                    } else if (worsened) {                                                                                                                                                                                                                     
                        judgmentText = "조정 후 악화";                                                                                                                                                                                                              
                        judgmentState = "Error";                                                                                                                                                                                                               
                    } else if (improved) {                                                                                                                                                                                                                     
                        judgmentText = "조정 후 개선";                                                                                                                                                                                                              
                        judgmentState = "Success";                                                                                                                                                                                                             
                    } else {                                                                                                                                                                                                                                   
                        judgmentText = "오차 변화 없음";                                                                                                                                                                                                             
                    }                                                                                                                                                                                                                                          
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                return {                                                                                                                                                                                                                                       
                    Fcsno: row.Fcsno,                                                                                                                                                                                                                          
                    Iteno: row.Iteno,                                                                                                                                                                                                                          
                    Werks: row.Werks,                                                                                                                                                                                                                          
                    Matnr: row.Matnr,                                                                                                                                                                                                                          
                    periodText:                                                                                                                                                                                                                                
                        String(row.Fcdat || "") +                                                                                                                                                                                                              
                        " ~ " +                                                                                                                                                                                                                                
                        String(row.Tcdat || ""),                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                    aiText: formatQty(row.Aiqty),                                                                                                                                                                                                              
                    finalText: formatQty(row.Fiqty),                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
                    // 기간이 종료되지 않았으면 실제 실적과                                                                                                                                                                                                                    
                    // 오차값을 평가 결과처럼 표시하지 않음                                                                                                                                                                                                                    
                    actualText: eligible                                                                                                                                                                                                                       
                        ? formatQty(row.ActualQty)                                                                                                                                                                                                             
                        : "—",                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                    aiApeText: apeAvailable &&                                                                                                                                                                                                                 
                        row.AiApe != null                                                                                                                                                                                                                      
                            ? toNumber(row.AiApe).toFixed(2) + "%"                                                                                                                                                                                             
                            : "—",                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                    finalApeText: apeAvailable &&                                                                                                                                                                                                              
                        row.FiApe != null                                                                                                                                                                                                                      
                            ? toNumber(row.FiApe).toFixed(2) + "%"                                                                                                                                                                                             
                            : "—",                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                    statusText: statusText,                                                                                                                                                                                                                    
                    statusState: statusState,                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                    // 조정 결과 판정                                                                                                                                                                                                                                
                    judgmentText: judgmentText,                                                                                                                                                                                                                
                    judgmentState: judgmentState                                                                                                                                                                                                               
                };                                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            oDash.setProperty(                                                                                                                                                                                                                                 
                "/accuracyDetailRows",                                                                                                                                                                                                                         
                detailRows                                                                                                                                                                                                                                     
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            oDash.setProperty(                                                                                                                                                                                                                                 
                "/accuracyDetailTitle",                                                                                                                                                                                                                        
                "수요예측 정확도 상세 목록 (" +                                                                                                                                                                                                                           
                detailRows.length + "건)"                                                                                                                                                                                                                       
            );                                                                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
        // ForecastComparison 데이터 조회                                                                                                                                                                                                                           
        // _loadComparisonRows: async function (oModel) {                                                                                                                                                                                                      
        _loadComparisonRows: async function (oModel, aFilters) {                                                                                                                                                                                               
            let oBinding;                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            try {                                                                                                                                                                                                                                              
                oBinding = oModel.bindList(                                                                                                                                                                                                                    
