                    {                                                                                                                                                                                                                                          
                        "$select": [                                                                                                                                                                                                                           
                            "Fcsno",                                                                                                                                                                                                                           
                            "Iteno",                                                                                                                                                                                                                           
                            "Werks",                                                                                                                                                                                                                           
                            "Matnr",                                                                                                                                                                                                                           
                            "Fcdat",                                                                                                                                                                                                                           
                            "AiForecastQty",                                                                                                                                                                                                                   
                            "FinalForecastQty",                                                                                                                                                                                                                
                            "ActualDemandQty"                                                                                                                                                                                                                  
                        ].join(","),                                                                                                                                                                                                                           
                        "$$operationMode": "Server"                                                                                                                                                                                                            
                    }                                                                                                                                                                                                                                          
                );                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                const aData = [];                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                for (                                                                                                                                                                                                                                          
                    let offset = 0;                                                                                                                                                                                                                            
                    offset < MAX_ROWS;                                                                                                                                                                                                                         
                    offset += PAGE_SIZE                                                                                                                                                                                                                        
                ) {                                                                                                                                                                                                                                            
                    const aContexts =                                                                                                                                                                                                                          
                        await oBinding.requestContexts(                                                                                                                                                                                                        
                            offset,                                                                                                                                                                                                                            
                            Math.min(                                                                                                                                                                                                                          
                                PAGE_SIZE,                                                                                                                                                                                                                     
                                MAX_ROWS - offset                                                                                                                                                                                                              
                            )                                                                                                                                                                                                                                  
                        );                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                    const aPage = await Promise.all(                                                                                                                                                                                                           
                        aContexts.map(function (oContext) {                                                                                                                                                                                                    
                            return oContext.requestObject();                                                                                                                                                                                                   
                        })                                                                                                                                                                                                                                     
                    );                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                    aData.push(...aPage);                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                    if (aContexts.length < PAGE_SIZE) {                                                                                                                                                                                                        
                        break;                                                                                                                                                                                                                                 
                    }                                                                                                                                                                                                                                          
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                if (aData.length >= MAX_ROWS) {                                                                                                                                                                                                                
                    throw new Error(                                                                                                                                                                                                                           
                        "ForecastComparison 조회 상한 " +                                                                                                                                                                                                          
                        "5,000건에 도달했습니다."                                                                                                                                                                                                                      
                    );                                                                                                                                                                                                                                         
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                return aData;                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            } finally {                                                                                                                                                                                                                                        
                if (oBinding) {                                                                                                                                                                                                                                
                    oBinding.destroy();                                                                                                                                                                                                                        
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // OData 서버에서 적용할 검색 필터 생성                                                                                                                                                                                                                             
        _buildSearchFilters: function (period) {                                                                                                                                                                                                               
            const filters = [];                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            const plant = this.byId("inpPlant")                                                                                                                                                                                                                
                .getValue().trim().toUpperCase();                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            const material = this.byId("inpMaterial")                                                                                                                                                                                                          
                .getValue().trim().toUpperCase();                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            if (plant) {                                                                                                                                                                                                                                       
                filters.push(new Filter(                                                                                                                                                                                                                       
                    "Werks",                                                                                                                                                                                                                                   
                    FilterOperator.EQ,                                                                                                                                                                                                                         
                    plant                                                                                                                                                                                                                                      
                ));                                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (material) {                                                                                                                                                                                                                                    
                filters.push(new Filter(                                                                                                                                                                                                                       
                    "Matnr",                                                                                                                                                                                                                                   
                    FilterOperator.Contains,                                                                                                                                                                                                                   
                    material                                                                                                                                                                                                                                   
                ));                                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 월별/기간별 모두 예측 시작일 기준                                                                                                                                                                                                                             
            filters.push(new Filter(                                                                                                                                                                                                                           
                "Fcdat",                                                                                                                                                                                                                                       
                FilterOperator.BT,                                                                                                                                                                                                                             
                `${period.from.slice(0, 4)}-${period.from.slice(4, 6)}-${period.from.slice(6, 8)}`,                                                                                                                                                            
                `${period.to.slice(0, 4)}-${period.to.slice(4, 6)}-${period.to.slice(6, 8)}`                                                                                                                                                                   
            ));                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            return filters;                                                                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            