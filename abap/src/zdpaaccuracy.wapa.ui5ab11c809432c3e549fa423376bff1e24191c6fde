        // 현재 차트는 이벤트 연결 없이 렌더링&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                
        onHtmlRendered: function () {                                                                                                                                                                                                                          
            // 추후 KPI 클릭, 차트 선택 이벤트 구현                                                                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 현재 검색조건을 ForecastAccuracy에 적용                                                                                                                                                                                                                       
        _getFilteredAccuracyRows: function () {                                                                                                                                                                                                                
            const plant = this.byId("inpPlant")                                                                                                                                                                                                                
                .getValue().trim().toUpperCase();                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            const material = this.byId("inpMaterial")                                                                                                                                                                                                          
                .getValue().trim().toUpperCase();                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            // const period = this.byId("drsPeriod");                                                                                                                                                                                                          
            // const from = dateKey(period.getDateValue());                                                                                                                                                                                                    
            // const to = dateKey(period.getSecondDateValue());                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 월별 / 기간별 공통 검색기간 적용                                                                                                                                                                                                                             
            const period = this._getSearchPeriod();                                                                                                                                                                                                            
            const from = period.from;                                                                                                                                                                                                                          
            const to = period.to;                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            return this._accuracyRows.filter(function (row) {                                                                                                                                                                                                  
                const rowPlant =                                                                                                                                                                                                                               
                    String(row.Werks || "").toUpperCase();                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                const rowMaterial =                                                                                                                                                                                                                            
                    String(row.Matnr || "").toUpperCase();                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                const rowDate = dateKey(row.Fcdat);                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                if (plant && rowPlant !== plant) {                                                                                                                                                                                                             
                    return false;                                                                                                                                                                                                                              
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                if (material &&                                                                                                                                                                                                                                
                    !rowMaterial.includes(material)) {                                                                                                                                                                                                         
                    return false;                                                                                                                                                                                                                              
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                // 검색기간과 예측대상기간의 겹침 여부                                                                                                                                                                                                                         
                if (from && (!rowDate || rowDate < from)) {                                                                                                                                                                                                    
                    return false;                                                                                                                                                                                                                              
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                if (to && (!rowDate || rowDate > to)) {                                                                                                                                                                                                        
                    return false;                                                                                                                                                                                                                              
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                return true;                                                                                                                                                                                                                                   
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 버전 비교 그룹 목록 갱신                                                                                                                                                                                                                                      
        _refreshVersionGroups: function () {                                                                                                                                                                                                                   
            const oDash = this.getView().getModel("dash");                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            const groups =                                                                                                                                                                                                                                     
                ForecastAnalyzer.groupForecastVersions(                                                                                                                                                                                                        
                    this._getFilteredAccuracyRows()                                                                                                                                                                                                            
                );                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            const previousKey =                                                                                                                                                                                                                                
                oDash.getProperty("/selectedVersionKey");                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            const selectedGroup = groups.find(function (g) {                                                                                                                                                                                                   
                return g.key === previousKey;                                                                                                                                                                                                                  
            }) || groups[0];                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            oDash.setProperty("/versionGroups", groups);                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            oDash.setProperty(                                                                                                                                                                                                                                 
                "/selectedVersionKey",                                                                                                                                                                                                                         
                selectedGroup ? selectedGroup.key : ""                                                                                                                                                                                                         
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            this._updateVersionRows();                                                                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 선택한 그룹의 모든 버전 출력                                                                                                                                                                                                                                    
        _updateVersionRows: function () {                                                                                                                                                                                                                      
            const oDash = this.getView().getModel("dash");                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            const groups =                                                                                                                                                                                                                                     
                oDash.getProperty("/versionGroups") || [];                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            const selectedKey =                                                                                                                                                                                                                                
                oDash.getProperty("/selectedVersionKey");                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            const group = groups.find(function (g) {                                                                                                                                                                                                           
                return g.key === selectedKey;                                                                                                                                                                                                                  
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            if (!group) {                                                                                                                                                                                                                                      
                oDash.setProperty("/versionRows", []);                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                this._renderVersionAnalysis(null);                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                oDash.setProperty(                                                                                                                                                                                                                             
                    "/versionTitle",                                                                                                                                                                                                                           
                    "예측 버전 목록 (0건)"                                                                                                                                                                                                                            
                );                                                                                                                                                                                                                                             
                oDash.setProperty(                                                                                                                                                                                                                             
                    "/versionMessage",                                                                                                                                                                                                                         
                    "검색조건에 해당하는 예측 버전이 없습니다."                                                                                                                                                                                                                  
                );                                                                                                                                                                                                                                             
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            const versionRows = group.rows.map(function (row) {                                                                                                                                                                                                
                return {                                                                                                                                                                                                                                       
                    Fcsno: row.Fcsno,                                                                                                                                                                                                                          
                    Iteno: row.Iteno,                                                                                                                                                                                                                          
                    Cdate: row.Cdate,                                                                                                                                                                                                                          
                    Ctime: row.Ctime,                                                                                                                                                                                                                          
                    Activ: row.Activ,                                                                                                                                                                                                                          
                    activeText:                                                                                                                                                                                                                                
                        row.Activ === "X" ? "활성" : "비활성",                                                                                                                                                                                                      
                    aiText: formatQty(row.Aiqty),                                                                                                                                                                                                              
                    finalText: formatQty(row.Fiqty),                                                                                                                                                                                                           
                    actualText: formatQty(row.ActualQty),                                                                                                                                                                                                      
                    Meins: row.Meins                                                                                                                                                                                                                           
                };                                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            oDash.setProperty("/versionRows", versionRows);                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            oDash.setProperty(                                                                                                                                                                                                                                 
                "/versionTitle",                                                                                                                                                                                                                               
                "예측 버전 목록 (" +                                                                                                                                                                                                                                 
                    versionRows.length + "건)"                                                                                                                                                                                                                  
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            oDash.setProperty(                                                                                                                                                                                                                                 
                "/versionMessage",                                                                                                                                                                                                                             
                group.activeCount === 1                                                                                                                                                                                                                        
                    ? "활성 버전이 1건 확인되었습니다."                                                                                                                                                                                                                     
                    : "주의: 활성 버전이 " +                                                                                                                                                                                                                          
                      group.activeCount + "건입니다."                                                                                                                                                                                                              
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // 선택한 그룹의 KPI와 추이 차트 갱신                                                                                                                                                                                                                           
            this._renderVersionAnalysis(group);                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
        // 선택한 예측 그룹의 변화량 KPI와 추이 차트 생성                                                                                                                                                                                                                        
        _renderVersionAnalysis: function (group) {                                                                                                                                                                                                             
            const oDash = this.getView().getModel("dash");                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            if (!group || !group.rows.length) {                                                                                                                                                                                                                
                oDash.setProperty("/versionHtml", "");                                                                                                                                                                                                         
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // group.rows는 Cdate + Ctime 오름차순 정렬된 상태                                                                                                                                                                                                           
            const rows = group.rows;                                                                                                                                                                                                                           
            const activeRows = rows.filter(                                                                                                                                                                                                                    
                row => row.Activ === "X"                                                                                                                                                                                                                       
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            const active = activeRows.length === 1                                                                                                                                                                                                             
                ? activeRows[0]                                                                                                                                                                                                                                
                : null;                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            const activeIndex = active                                                                                                                                                                                                                         
                ? rows.indexOf(active)                                                                                                                                                                                                                         
                : -1;                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            const previous = activeIndex > 0                                                                                                                                                                                                                   
                ? rows[activeIndex - 1]                                                                                                                                                                                                                        
                : null;                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            const unit = escapeHtml(group.meins || "");                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            // 수량 변화에 부호 표시                                                                                                                                                                                                                                    
            const formatChange = value => {                                                                                                                                                                                                                    
                if (value == null) {                                                                                                                                                                                                                           
                    return "—";                                                                                                                                                                                                                                
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                const prefix = value > 0 ? "+" : "";                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
                return prefix + formatQty(value);                                                                                                                                                                                                              
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // KPI 카드 HTML                                                                                                                                                                                                                                     
            const card = (label, value, note) => `                                                                                                                                                                                                             
                <div class="dpa-version-card">                                                                                                                                                                                                                 
                    <div class="dpa-version-label">                                                                                                                                                                                                            
                        ${escapeHtml(label)}                                                                                                                                                                                                                   
                    </div>                                                                                                                                                                                                                                     
                    <div class="dpa-version-value">                                                                                                                                                                                                            
                        ${escapeHtml(value)}                                                                                                                                                                                                                   
                    </div>                                                                                                                                                                                                                                     
                    <div class="dpa-version-note">                                                                                                                                                                                                             
                        ${escapeHtml(note)}                                                                                                                                                                                                                    
                    </div>                                                                                                                                                                                                                                     
                </div>                                                                                                                                                                                                                                         
            `;                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            const aiChange = active && previous                                                                                                                                                                                                                
                ? Number(active.Aiqty) - Number(previous.Aiqty)                                                                                                                                                                                                
                : null;                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            const finalChange = active && previous                                                                                                                                                                                                             
                ? Number(active.Fiqty) - Number(previous.Fiqty)                                                                                                                                                                                                
                : null;                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            const adjustment = active                                                                                                                                                                                                                          
                ? Number(active.Fiqty) - Number(active.Aiqty)                                                                                                                                                                                                  
                : null;                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            const aiNote = active && previous                                                                                                                                                                                                                  
                ? `직전 ${formatQty(previous.Aiqty)} → 활성 ${formatQty(active.Aiqty)}`                                                                                                                                                                            
                : "비교 가능한 직전 버전이 없습니다.";                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            const finalNote = active && previous                                                                                                                                                                                                               
                ? `직전 ${formatQty(previous.Fiqty)} → 활성 ${formatQty(active.Fiqty)}`                                                                                                                                                                            
                : "비교 가능한 직전 버전이 없습니다.";                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            const adjustNote = active                                                                                                                                                                                                                          
                ? `AI ${formatQty(active.Aiqty)} → 확정 ${formatQty(active.Fiqty)}`                                                                                                                                                                              
                : "활성 버전을 확인할 수 없습니다.";                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            // SVG 추이 차트                                                                                                                                                                                                                                       
            const width = Math.max(740, rows.length * 110);                                                                                                                                                                                                    
            const height = 270;                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            const left = 60;                                                                                                                                                                                                                                   
            const right = 30;                                                                                                                                                                                                                                  
            const top = 30;                                                                                                                                                                                                                                    
            const bottom = 210;                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            const plotWidth = width - left - right;                                                                                                                                                                                                            
            const plotHeight = bottom - top;                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            const values = rows.flatMap(row => [                                                                                                                                                                                                               
                Number(row.Aiqty) || 0,                                                                                                                                                                                                                        
                Number(row.Fiqty) || 0                                                                                                                                                                                                                         
            ]);                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            const maxValue = Math.max(1, ...values);                                                                                                                                                                                                           
            const minValue = Math.min(0, ...values);                                                                                                                                                                                                           
            const range = Math.max(1, maxValue - minValue);                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            const x = i => rows.length === 1                                                                                                                                                                                                                   
                ? left + plotWidth / 2                                                                                                                                                                                                                         
                : left + i * plotWidth / (rows.length - 1);                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            const y = value => bottom -                                                                                                                                                                                                                        
                ((value - minValue) / range) * plotHeight;                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            const series = [                                                                                                                                                                                                                                   
                {                                                                                                                                                                                                                                              
                    field: "Aiqty",                                                                                                                                                                                                                            
                    name: "AI 예측수량",                                                                                                                                                                                                                           
                    color: "#3574d6"                                                                                                                                                                                                                           
                },                                                                                                                                                                                                                                             
                {                                                                                                                                                                                                                                              
                    field: "Fiqty",                                                                                                                                                                                                                            
                    name: "최종 확정수량",                                                                                                                                                                                                                           
                    color: "#25a178"                                                                                                                                                                                                                           
                }                                                                                                                                                                                                                                              
            ];                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // 가로 보조선                                                                                                                                                                                                                                          
            let gridLines = "";                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            for (let i = 0; i <= 4; i++) {                                                                                                                                                                                                                     
                const value = minValue + range * i / 4;                                                                                                                                                                                                        
                const gy = y(value);                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
                gridLines += `                                                                                                                                                                                                                                 
                    <line                                                                                                                                                                                                                                      
                        x1="${left}"                                                                                                                                                                                                                           
                        y1="${gy}"                                                                                                                                                                                                                             
                        x2="${width - right}"                                                                                                                                                                                                                  
                        y2="${gy}"                                                                                                                                                                                                                             
                        stroke="#e4e9f1"/>                                                                                                                                                                                                                     
                    <text                                                                                                                                                                                                                                      
                        x="${left - 8}"                                                                                                                                                                                                                        
                        y="${gy + 4}"                                                                                                                                                                                                                          
                        font-size="11"                                                                                                                                                                                                                         
                        text-anchor="end"                                                                                                                                                                                                                      
                        fill="#748096">                                                                                                                                                                                                                        
                        ${escapeHtml(value.toFixed(1))}                                                                                                                                                                                                        
                    </text>                                                                                                                                                                                                                                    
                `;                                                                                                                                                                                                                                             
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            let chartLines = "";                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            series.forEach(s => {                                                                                                                                                                                                                              
                const points = rows.map((row, i) => {                                                                                                                                                                                                          
                    return [                                                                                                                                                                                                                                   
                        x(i),                                                                                                                                                                                                                                  
                        y(Number(row[s.field]) || 0)                                                                                                                                                                                                           
                    ];                                                                                                                                                                                                                                         
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                chartLines += `                                                                                                                                                                                                                                
                    <polyline                                                                                                                                                                                                                                  
                        points="${points.map(p => p.join(",")).join(" ")}"                                                                                                                                                                                     
                        fill="none"                                                                                                                                                                                                                            
                        stroke="${s.color}"                                                                                                                                                                                                                    
                        stroke-width="3"                                                                                                                                                                                                                       
                        stroke-linejoin="round"                                                                                                                                                                                                                
                        stroke-linecap="round"/>                                                                                                                                                                                                               
                `;                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                points.forEach((point, i) => {                                                                                                                                                                                                                 
                    const row = rows[i];                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                    chartLines += `                                                                                                                                                                                                                            
                        <circle                                                                                                                                                                                                                                
                            cx="${point[0]}"                                                                                                                                                                                                                   
                            cy="${point[1]}"                                                                                                                                                                                                                   
                            r="5"                                                                                                                                                                                                                              
                            fill="${s.color}"                                                                                                                                                                                                                  
                            stroke="white"                                                                                                                                                                                                                     
                            stroke-width="1.5">                                                                                                                                                                                                                
                            <title>${escapeHtml(s.name)}                                                                                                                                                                                                       
                            예측번호: ${escapeHtml(row.Fcsno)}                                                                                                                                                                                                     
                            수량: ${formatQty(row[s.field])} ${unit}</title>                                                                                                                                                                                     
                        </circle>                                                                                                                                                                                                                              
                    `;                                                                                                                                                                                                                                         
                });                                                                                                                                                                                                                                            
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // X축 예측번호                                                                                                                                                                                                                                         
            const labels = rows.map((row, i) => `                                                                                                                                                                                                              
                <text                                                                                                                                                                                                                                          
                    x="${x(i)}"                                                                                                                                                                                                                                
                    y="${bottom + 25}"                                                                                                                                                                                                                         
                    text-anchor="middle"                                                                                                                                                                                                                       
                    font-size="10"                                                                                                                                                                                                                             
                    fill="#58667d">                                                                                                                                                                                                                            
                    ${escapeHtml(row.Fcsno)}                                                                                                                                                                                                                   
                </text>                                                                                                                                                                                                                                        
            `).join("");                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            const warning = activeRows.length !== 1                                                                                                                                                                                                            
                ? "활성 버전이 정확히 1건이 아니므로 변화량 일부를 계산하지 않았습니다."                                                                                                                                                                                                    
                : activeIndex !== rows.length - 1                                                                                                                                                                                                              
                    ? "활성 버전 이후에 저장된 비활성 버전이 존재합니다. 활성 기준 변화량을 확인해 주세요."                                                                                                                                                                                       
                    : "";                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            const html = `                                                                                                                                                                                                                                     
                <div id="${this.byId("versionAnalysisHtml").getId()}">                                                                                                                                                                                         
                <style>                                                                                                                                                                                                                                        
                    .dpa-version-analysis {                                                                                                                                                                                                                    
                        font-family: Arial, sans-serif;                                                                                                                                                                                                        
                        color: #233047;                                                                                                                                                                                                                        
                        margin: 16px 0 24px;                                                                                                                                                                                                                   
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    .dpa-version-kpis {                                                                                                                                                                                                                        
                        display: grid;                                                                                                                                                                                                                         
                        grid-template-columns: repeat(3, minmax(0, 1fr));                                                                                                                                                                                      
                        gap: 12px;                                                                                                                                                                                                                             
                        margin-bottom: 16px;                                                                                                                                                                                                                   
