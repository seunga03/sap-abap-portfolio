sap.ui.define(["sap/m/MessageToast"], function (MessageToast) {                                                                                                                                                                                                
	"use strict";                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
	var SEMANTIC_OBJECT = "ZException";                                                                                                                                                                                                                           
	var ACTION = "manage";                                                                                                                                                                                                                                        
	var CM03_HASH = "#ZException-manage";                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
	// 개발용(BAS 프리뷰): CM05와 cm03app은 서로 다른 포트에서 돈다.                                                                                                                                                                                                                
	// 지금 앱이 8081이면 CM03는 8080, 8080이면 8081로 간주한다.                                                                                                                                                                                                                
	// 다른 포트를 쓰면 콘솔에서 window.__cm03Port = "8082" 로 덮어쓸 수 있다.                                                                                                                                                                                                      
	function getCm03DevUrl(sExnum) {                                                                                                                                                                                                                              
		var m = /port(\d+)-/.exec(window.location.origin);                                                                                                                                                                                                           
		if (!m) {                                                                                                                                                                                                                                                    
			return null; // 프리뷰 주소가 아님                                                                                                                                                                                                                                  
		}                                                                                                                                                                                                                                                            
		var sCur = m[1];                                                                                                                                                                                                                                             
		var sTarget = window.__cm03Port || (sCur === "8081" ? "8080" : "8081");                                                                                                                                                                                      
		if (sTarget === sCur) {                                                                                                                                                                                                                                      
			return null;                                                                                                                                                                                                                                                
		}                                                                                                                                                                                                                                                            
		var sOrigin = window.location.origin.replace(/port\d+-/, "port" + sTarget + "-");                                                                                                                                                                            
		var sUrl = sOrigin + "/test/flp.html?sap-ui-xx-viewCache=false" + CM03_HASH;                                                                                                                                                                                 
		if (sExnum && /^EX\d+/.test(sExnum)) {                                                                                                                                                                                                                       
			sUrl += "?exnum=" + encodeURIComponent(sExnum);                                                                                                                                                                                                             
		}                                                                                                                                                                                                                                                            
		return sUrl;                                                                                                                                                                                                                                                 
	}                                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
	function devFallback(sExnum) {                                                                                                                                                                                                                                
		var sUrl = getCm03DevUrl(sExnum);                                                                                                                                                                                                                            
		if (sUrl) {                                                                                                                                                                                                                                                  
			window.open(sUrl, "_blank");                                                                                                                                                                                                                                
			return true;                                                                                                                                                                                                                                                
		}                                                                                                                                                                                                                                                            
		return false;                                                                                                                                                                                                                                                
	}                                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
	function toast(sExnum) {                                                                                                                                                                                                                                      
		MessageToast.show("CM03으로 이동할 수 없어요" + (sExnum ? " (" + sExnum + ")" : ""));                                                                                                                                                                                 
	}                                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
	return {                                                                                                                                                                                                                                                      
		toCm03: function (sExnum) {                                                                                                                                                                                                                                  
			var oUshell = sap.ushell;                                                                                                                                                                                                                                   
			if (!oUshell || !oUshell.Container) {                                                                                                                                                                                                                       
				if (!devFallback(sExnum)) { toast(sExnum); }                                                                                                                                                                                                               
				return;                                                                                                                                                                                                                                                    
			}                                                                                                                                                                                                                                                           
			var mParams = (sExnum && /^EX\d+/.test(sExnum)) ? { exnum: [sExnum] } : {};                                                                                                                                                                                 
			var oTarget = { target: { semanticObject: SEMANTIC_OBJECT, action: ACTION }, params: mParams };                                                                                                                                                             
                                                                                                                                                                                                                                                               
			oUshell.Container.getServiceAsync("Navigation").then(function (oNav) {                                                                                                                                                                                      
				return oNav.isNavigationSupported([oTarget]).then(function (aRes) {                                                                                                                                                                                        
					if (aRes && aRes[0] && aRes[0].supported) {                                                                                                                                                                                                               
						oNav.navigate(oTarget);                                                                                                                                                                                                                                  
					} else if (!devFallback(sExnum)) {                                                                                                                                                                                                                        
						toast(sExnum);                                                                                                                                                                                                                                           
					}                                                                                                                                                                                                                                                         
				});                                                                                                                                                                                                                                                        
			}).catch(function () {                                                                                                                                                                                                                                      
				if (!devFallback(sExnum)) { toast(sExnum); }                                                                                                                                                                                                               
			});                                                                                                                                                                                                                                                         
		}                                                                                                                                                                                                                                                            
	};                                                                                                                                                                                                                                                            
});                                                                                                                                                                                                                                                            