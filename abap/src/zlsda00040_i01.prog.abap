*---------------------------------------------------------------------*
* EXIT_0100
*---------------------------------------------------------------------*
MODULE exit_0100 INPUT.

  CASE sy-ucomm.

    WHEN 'BACK'.
      LEAVE TO SCREEN 0.

    WHEN 'EXIT'
      OR 'CANC'.
      LEAVE PROGRAM.

  ENDCASE.

ENDMODULE.


*---------------------------------------------------------------------*
* USER_COMMAND_0100
*---------------------------------------------------------------------*
MODULE user_command_0100 INPUT.

  gv_okcode = sy-ucomm.
  CLEAR sy-ucomm.

  CASE gv_okcode.

*---------------------------------------------------------------------*
* 조회
*---------------------------------------------------------------------*
    WHEN 'SRCH'.

      IF gv_s_acgfr IS NOT INITIAL
         AND gv_s_acgto IS NOT INITIAL
         AND gv_s_acgfr > gv_s_acgto.

        MESSAGE s026(zmsga) DISPLAY LIKE 'E'.

      ELSE.

        PERFORM search_billing_target.

        IF gt_target IS INITIAL.
          MESSAGE s040(zmsga) DISPLAY LIKE 'E'.
        ENDIF.

      ENDIF.

*---------------------------------------------------------------------*
* 입력값 초기화
*---------------------------------------------------------------------*
    WHEN 'CLER'.

      PERFORM clear_search_condition.

*---------------------------------------------------------------------*
* 새로고침
*---------------------------------------------------------------------*
    WHEN 'REFR'.

      CLEAR gt_new_bill.

      PERFORM refresh_screen.

*---------------------------------------------------------------------*
* Application Toolbar - 판매오더
*---------------------------------------------------------------------*
    WHEN 'SD01'.

      CALL TRANSACTION 'ZSD01L'.

      PERFORM refresh_screen.

*---------------------------------------------------------------------*
* Application Toolbar - 출고문서
*---------------------------------------------------------------------*
    WHEN 'SD02'.

      CALL TRANSACTION 'ZSD02'.

      PERFORM refresh_screen.

*---------------------------------------------------------------------*
* Application Toolbar - 출하처리
*---------------------------------------------------------------------*
    WHEN 'SD03'.

      CALL TRANSACTION 'ZSD03'.

      PERFORM refresh_screen.

*---------------------------------------------------------------------*
* Application Toolbar - 청구
*---------------------------------------------------------------------*
    WHEN 'SD04'.

      " 현재 화면

  ENDCASE.

ENDMODULE.

