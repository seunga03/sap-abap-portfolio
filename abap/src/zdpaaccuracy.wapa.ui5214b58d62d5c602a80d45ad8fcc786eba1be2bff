                                                                                                                                                                                                                                                               
sap.ui.define([], function () {                                                                                                                                                                                                                                
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    const PAGE_SIZE = 200;                                                                                                                                                                                                                                     
    const MAX_ROWS = 5000;                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
        // ForecastAccuracy 전체 데이터 조회                                                                                                                                                                                                                          
        // getForecastAccuracy: async function (oModel) {                                                                                                                                                                                                      
        getForecastAccuracy: async function (oModel, aFilters) {                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            if (!oModel ||                                                                                                                                                                                                                                     
                typeof oModel.bindList !== "function") {                                                                                                                                                                                                       
                throw new Error(                                                                                                                                                                                                                               
                    "OData V4 모델을 찾을 수 없습니다."                                                                                                                                                                                                                  
                );                                                                                                                                                                                                                                             
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            let oBinding;                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            try {                                                                                                                                                                                                                                              
                // ForecastAccuracy Entity 조회                                                                                                                                                                                                                  
                oBinding = oModel.bindList(                                                                                                                                                                                                                    
                    "/ForecastAccuracy",                                                                                                                                                                                                                       
                    undefined,                                                                                                                                                                                                                                 
                    undefined,                                                                                                                                                                                                                                 
                    aFilters,                                                                                                                                                                                                                                  
                    {                                                                                                                                                                                                                                          
                        "$select": [                                                                                                                                                                                                                           
                            "Fcsno",                                                                                                                                                                                                                           
                            "Iteno",                                                                                                                                                                                                                           
                            "Werks",                                                                                                                                                                                                                           
                            "Matnr",                                                                                                                                                                                                                           
                            "Fcdat",                                                                                                                                                                                                                           
                            "Tcdat",                                                                                                                                                                                                                           
                            "Activ",                                                                                                                                                                                                                           
                            "Cdate",                                                                                                                                                                                                                           
                            "Ctime",                                                                                                                                                                                                                           
                            "EvalStatus",                                                                                                                                                                                                                      
                            "Aiqty",                                                                                                                                                                                                                           
                            "Fiqty",                                                                                                                                                                                                                           
                            "ActualQty",                                                                                                                                                                                                                       
                            "AiErrQty",                                                                                                                                                                                                                        
                            "FiErrQty",                                                                                                                                                                                                                        
                            "AiAbsErr",                                                                                                                                                                                                                        
                            "FiAbsErr",                                                                                                                                                                                                                        
                            "AdjEffect",                                                                                                                                                                                                                       
                            "AiApe",                                                                                                                                                                                                                           
                            "FiApe",                                                                                                                                                                                                                           
                            "EvalEligible",                                                                                                                                                                                                                    
                            "ApeAvailable",                                                                                                                                                                                                                    
                            "Meins"                                                                                                                                                                                                                            
                        ].join(","),                                                                                                                                                                                                                           
                        "$$operationMode": "Server"                                                                                                                                                                                                            
                    }                                                                                                                                                                                                                                          
                );                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                const aData = [];                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                // OData 데이터를 200건씩 나누어 조회                                                                                                                                                                                                                     
                for (                                                                                                                                                                                                                                          
                    let offset = 0;                                                                                                                                                                                                                            
                    offset < MAX_ROWS;                                                                                                                                                                                                                         
                    offset += PAGE_SIZE                                                                                                                                                                                                                        
                ) {                                                                                                                                                                                                                                            
                    const aContexts =                                                                                                                                                                                                                          
                        await oBinding.requestContexts(                                                                                                                                                                                                        
                            offset,                                                                                                                                                                                                                            
                            Math.min(                                                                                                                                                                                                                          
                                PAGE_SIZE,                                                                                                                                                                                                                     
                                MAX_ROWS - offset                                                                                                                                                                                                              
                            )                                                                                                                                                                                                                                  
                        );                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                    const aPage = await Promise.all(                                                                                                                                                                                                           
                        aContexts.map(function (oContext) {                                                                                                                                                                                                    
                            return oContext.requestObject();                                                                                                                                                                                                   
                        })                                                                                                                                                                                                                                     
                    );                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                    aData.push(...aPage);                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                    if (aContexts.length < PAGE_SIZE) {                                                                                                                                                                                                        
                        break;                                                                                                                                                                                                                                 
                    }                                                                                                                                                                                                                                          
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                // 조회 상한 도달 시 불완전한 집계 방지                                                                                                                                                                                                                       
                if (aData.length >= MAX_ROWS) {                                                                                                                                                                                                                
                    throw new Error(                                                                                                                                                                                                                           
                        "조회 상한 5,000건에 도달했습니다. " +                                                                                                                                                                                                             
                        "조회 조건을 좁혀 주세요."                                                                                                                                                                                                                       
                    );                                                                                                                                                                                                                                         
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                return aData;                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            } finally {                                                                                                                                                                                                                                        
                // 조회가 끝나면 바인딩 정리                                                                                                                                                                                                                              
                if (oBinding) {                                                                                                                                                                                                                                
                    oBinding.destroy();                                                                                                                                                                                                                        
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            