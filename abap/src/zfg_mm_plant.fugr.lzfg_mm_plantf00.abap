FORM GET_DATA_ZVMMA00040.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZTCMA00140 WHERE
(VIM_WHERETAB) .
    CLEAR ZVMMA00040 .
ZVMMA00040-MANDT =
ZTCMA00140-MANDT .
ZVMMA00040-WERKS =
ZTCMA00140-WERKS .
ZVMMA00040-NAME1 =
ZTCMA00140-NAME1 .
ZVMMA00040-ADRNR =
ZTCMA00140-ADRNR .
ZVMMA00040-REGIO =
ZTCMA00140-REGIO .
ZVMMA00040-BUKRS =
ZTCMA00140-BUKRS .
ZVMMA00040-ACTYN =
ZTCMA00140-ACTYN .
ZVMMA00040-ERDAT =
ZTCMA00140-ERDAT .
ZVMMA00040-ERZET =
ZTCMA00140-ERZET .
ZVMMA00040-ERNAM =
ZTCMA00140-ERNAM .
ZVMMA00040-AEDAT =
ZTCMA00140-AEDAT .
ZVMMA00040-AEZET =
ZTCMA00140-AEZET .
ZVMMA00040-AENAM =
ZTCMA00140-AENAM .
<VIM_TOTAL_STRUC> = ZVMMA00040.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZVMMA00040 .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZVMMA00040.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZVMMA00040-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZTCMA00140 WHERE
  WERKS = ZVMMA00040-WERKS .
    IF SY-SUBRC = 0.
    DELETE ZTCMA00140 .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZTCMA00140 WHERE
  WERKS = ZVMMA00040-WERKS .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZTCMA00140.
    ENDIF.
ZTCMA00140-MANDT =
ZVMMA00040-MANDT .
ZTCMA00140-WERKS =
ZVMMA00040-WERKS .
ZTCMA00140-NAME1 =
ZVMMA00040-NAME1 .
ZTCMA00140-ADRNR =
ZVMMA00040-ADRNR .
ZTCMA00140-REGIO =
ZVMMA00040-REGIO .
ZTCMA00140-BUKRS =
ZVMMA00040-BUKRS .
ZTCMA00140-ACTYN =
ZVMMA00040-ACTYN .
ZTCMA00140-ERDAT =
ZVMMA00040-ERDAT .
ZTCMA00140-ERZET =
ZVMMA00040-ERZET .
ZTCMA00140-ERNAM =
ZVMMA00040-ERNAM .
ZTCMA00140-AEDAT =
ZVMMA00040-AEDAT .
ZTCMA00140-AEZET =
ZVMMA00040-AEZET .
ZTCMA00140-AENAM =
ZVMMA00040-AENAM .
    IF SY-SUBRC = 0.
    UPDATE ZTCMA00140 ##WARN_OK.
    ELSE.
    INSERT ZTCMA00140 .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZVMMA00040-UPD_FLAG,
STATUS_ZVMMA00040-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
