sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/mvc/Controller",                                                                                                                                                                                                                              
    "sap/ui/model/odata/v2/ODataModel",                                                                                                                                                                                                                        
    "sap/ui/model/Filter",                                                                                                                                                                                                                                     
    "sap/ui/model/FilterOperator",                                                                                                                                                                                                                             
    "sap/ui/model/Sorter",                                                                                                                                                                                                                                     
    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "cm05ovp/ext/common/FilterHelper",                                                                                                                                                                                                                         
    "cm05ovp/ext/common/NavHelper"                                                                                                                                                                                                                             
], function (Controller, ODataModel, Filter, FilterOperator, Sorter, MessageToast, FilterHelper, NavHelper) {                                                                                                                                                  
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var SERVICE_URL = "/sap/opu/odata/sap/ZUI_EXCEPTION_O2/";                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
    var SRC_NAME = { SUBC: "외주 정합성", QM: "품질 검사", INVC: "송장 정산", RISK: "납기 리스크", PO: "PO" };                                                                                                                                                                   
    var OWN_NAME = { MM: "자재(MM)", FI: "재무(FI)", BOTH: "공동", QM: "QM" };                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
    return Controller.extend("cm05ovp.ext.urgentList.UrgentList", {                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
        onInit: function () {                                                                                                                                                                                                                                  
            this._oModel = new ODataModel(SERVICE_URL, { useBatch: false });                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            // 행 클릭 → CM03 이동 (문서 전체에서 한 번만 연결)                                                                                                                                                                                                                
            console.log("[URG] init");                                                                                                                                                                                                                         
            if (!window.__urgClickBound) {                                                                                                                                                                                                                     
                window.__urgClickBound = true;                                                                                                                                                                                                                 
                document.addEventListener("click", function (e) {                                                                                                                                                                                              
                    var el = e.target.closest && e.target.closest("[data-exnum]");                                                                                                                                                                             
                    console.log("[URG] click:", el && el.getAttribute("data-exnum"));                                                                                                                                                                          
                    if (el) { NavHelper.toCm03(el.getAttribute("data-exnum")); return; }                                                                                                                                                                       
                    if (e.target.closest && e.target.closest("[data-more]")) { NavHelper.toCm03("전체 목록"); }                                                                                                                                                    
                }, true);                                                                                                                                                                                                                                      
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            FilterHelper.subscribe(this._load.bind(this));                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _set: function (sHtml) {                                                                                                                                                                                                                               
            this.byId("listHtml").setContent(sHtml);                                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _load: function (aIgnored, mCond) {                                                                                                                                                                                                                    
            // 발생월(crmon)은 CM03 쪽에 없어서 발생일자(crdat) 범위로 바꿔요                                                                                                                                                                                                     
            var aF = FilterHelper.toFilters(mCond, ["crmon"]);                                                                                                                                                                                                 
            var c = ((mCond && mCond.crmon) || []).filter(function (x) { return x.operator === "EQ"; })[0];                                                                                                                                                    
            if (c) {                                                                                                                                                                                                                                           
                var y = +c.values[0].slice(0, 4), m = +c.values[0].slice(4, 6);                                                                                                                                                                                
                aF.push(new Filter("crdat", FilterOperator.BT,                                                                                                                                                                                                 
                    new Date(Date.UTC(y, m - 1, 1)), new Date(Date.UTC(y, m, 0))));                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
            aF.push(new Filter("prsta", FilterOperator.EQ, "OPEN"));   // 접수대기 = 바로 처리 필요                                                                                                                                                                      
            this._oModel.read("/Exception", {                                                                                                                                                                                                                  
                filters: aF,                                                                                                                                                                                                                                   
                sorters: [new Sorter("crdat", false)],                  // 오래된 것부터                                                                                                                                                                             
                urlParameters: { "$top": 5, "$inlinecount": "allpages" },                                                                                                                                                                                      
                success: function (oData) { this._render(oData.results || [], Number(oData.__count) || 0); }.bind(this),                                                                                                                                       
                error: function (e) {                                                                                                                                                                                                                          
                    this._set("<div style='padding:16px;color:#cf5555'>데이터 로딩 실패: " +                                                                                                                                                                          
                              (e && e.message ? e.message : "") + "</div>");                                                                                                                                                                                   
                }.bind(this)                                                                                                                                                                                                                                   
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _render: function (rows, total) {                                                                                                                                                                                                                      
            var now = Date.now();                                                                                                                                                                                                                              
            var html = rows.map(function (r) {                                                                                                                                                                                                                 
                var days = r.crdat ? Math.max(0, Math.floor((now - new Date(r.crdat).getTime()) / 86400000)) : 0;                                                                                                                                              
                var hot = days >= 7;                                                                                                                                                                                                                           
                return "<div data-exnum='" + r.exnum + "' style='display:flex;align-items:center;gap:8px;" +                                                                                                                                                   
                       "padding:10px 0;border-top:1px solid #eceff5;cursor:pointer'>" +                                                                                                                                                                        
                         "<span style='width:5px;height:30px;border-radius:3px;background:" + (hot ? "#ee7d7d" : "#eab94d") + "'></span>" +                                                                                                                    
                         "<div style='flex:1;min-width:0'>" +                                                                                                                                                                                                  
                           "<div style='font-size:13px;font-weight:600;color:#2c3347'>" + r.exnum + "</div>" +                                                                                                                                                 
                           "<div style='font-size:11px;color:#7a8296'>" + (SRC_NAME[r.srtyp] || r.srtyp) + " · " + (OWN_NAME[r.owgrp] || r.owgrp) + "</div>" +                                                                                                 
                         "</div>" +                                                                                                                                                                                                                            
                         "<span style='padding:2px 8px;border-radius:999px;font-size:11px;" +                                                                                                                                                                  
                           (hot ? "background:#fdeaea;color:#cf5555" : "background:#fdf3dc;color:#b8860b") + "'>" + days + "일</span>" +                                                                                                                        
                         "<span style='color:#a3abbd'>›</span>" +                                                                                                                                                                                              
                       "</div>";                                                                                                                                                                                                                               
            }).join("");                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            var more = total > rows.length                                                                                                                                                                                                                     
                ? "<div data-more='1' style='padding:12px 0 2px;border-top:1px solid #eceff5;font-size:12px;color:#3563c9;cursor:pointer'>외 " +                                                                                                                
                  (total - rows.length) + "건 더 보기 ›</div>"                                                                                                                                                                                                     
                : "";                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            this._set(                                                                                                                                                                                                                                         
                "<div style='padding:8px 16px 16px;font-family:Malgun Gothic,sans-serif;color:#3b4358'>" +                                                                                                                                                     
                  "<div style='font-size:12px;color:#7a8296;margin-bottom:4px'>접수 대기 · 오래된 순 (7일 이상 빨강)</div>" +                                                                                                                                               
                  (html || "<div style='padding:24px 0;text-align:center;color:#7a8296'>접수 대기 건이 없어요</div>") +                                                                                                                                                 
                  more +                                                                                                                                                                                                                                       
                "</div>");                                                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _navigate: function (sExnum) {                                                                                                                                                                                                                         
            NavHelper.toCm03(sExnum);                                                                                                                                                                                                                          
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            