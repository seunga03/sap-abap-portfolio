ZTCMA00060-ERDAT .
ZV_SD_COND-ERZET =
ZTCMA00060-ERZET .
ZV_SD_COND-ERNAM =
ZTCMA00060-ERNAM .
ZV_SD_COND-AEDAT =
ZTCMA00060-AEDAT .
ZV_SD_COND-AEZET =
ZTCMA00060-AEZET .
ZV_SD_COND-AENAM =
ZTCMA00060-AENAM .
<VIM_TOTAL_STRUC> = ZV_SD_COND.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZV_SD_COND .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZV_SD_COND.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZV_SD_COND-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZTCMA00060 WHERE
  MATNR = ZV_SD_COND-MATNR AND
  KUNNR = ZV_SD_COND-KUNNR AND
  VKORG = ZV_SD_COND-VKORG AND
  VTWEG = ZV_SD_COND-VTWEG AND
  VFROM = ZV_SD_COND-VFROM .
    IF SY-SUBRC = 0.
    DELETE ZTCMA00060 .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZTCMA00060 WHERE
  MATNR = ZV_SD_COND-MATNR AND
  KUNNR = ZV_SD_COND-KUNNR AND
  VKORG = ZV_SD_COND-VKORG AND
  VTWEG = ZV_SD_COND-VTWEG AND
  VFROM = ZV_SD_COND-VFROM .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZTCMA00060.
    ENDIF.
ZTCMA00060-MANDT =
ZV_SD_COND-MANDT .
ZTCMA00060-MATNR =
ZV_SD_COND-MATNR .
ZTCMA00060-KUNNR =
ZV_SD_COND-KUNNR .
ZTCMA00060-VKORG =
ZV_SD_COND-VKORG .
ZTCMA00060-VTWEG =
ZV_SD_COND-VTWEG .
ZTCMA00060-VFROM =
ZV_SD_COND-VFROM .
ZTCMA00060-UNITP =
ZV_SD_COND-UNITP .
ZTCMA00060-WAERS =
ZV_SD_COND-WAERS .
ZTCMA00060-DISRT =
ZV_SD_COND-DISRT .
ZTCMA00060-TAXRT =
ZV_SD_COND-TAXRT .
ZTCMA00060-MINLF =
ZV_SD_COND-MINLF .
ZTCMA00060-MEINS =
ZV_SD_COND-MEINS .
ZTCMA00060-VTO =
ZV_SD_COND-VTO .
ZTCMA00060-ACTYN =
ZV_SD_COND-ACTYN .
ZTCMA00060-ERDAT =
ZV_SD_COND-ERDAT .
ZTCMA00060-ERZET =
ZV_SD_COND-ERZET .
ZTCMA00060-ERNAM =
ZV_SD_COND-ERNAM .
ZTCMA00060-AEDAT =
ZV_SD_COND-AEDAT .
ZTCMA00060-AEZET =
ZV_SD_COND-AEZET .
ZTCMA00060-AENAM =
ZV_SD_COND-AENAM .
    IF SY-SUBRC = 0.
    UPDATE ZTCMA00060 ##WARN_OK.
    ELSE.
    INSERT ZTCMA00060 .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZV_SD_COND-UPD_FLAG,
STATUS_ZV_SD_COND-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
