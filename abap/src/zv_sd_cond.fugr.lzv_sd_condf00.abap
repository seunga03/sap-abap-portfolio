FORM GET_DATA_ZV_SD_COND.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZTCMA00060 WHERE
(VIM_WHERETAB) .
