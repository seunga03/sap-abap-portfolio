*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: ZVCMA00160......................................*
FORM GET_DATA_ZVCMA00160.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZTCMA00160 WHERE
(VIM_WHERETAB) .
    CLEAR ZVCMA00160 .
ZVCMA00160-MANDT =
ZTCMA00160-MANDT .
ZVCMA00160-WERKS =
ZTCMA00160-WERKS .
ZVCMA00160-PERIO =
ZTCMA00160-PERIO .
ZVCMA00160-WRKDY =
ZTCMA00160-WRKDY .
ZVCMA00160-REMARK =
ZTCMA00160-REMARK .
<VIM_TOTAL_STRUC> = ZVCMA00160.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZVCMA00160 .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZVCMA00160.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZVCMA00160-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZTCMA00160 WHERE
  WERKS = ZVCMA00160-WERKS AND
  PERIO = ZVCMA00160-PERIO .
    IF SY-SUBRC = 0.
    DELETE ZTCMA00160 .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZTCMA00160 WHERE
  WERKS = ZVCMA00160-WERKS AND
  PERIO = ZVCMA00160-PERIO .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZTCMA00160.
    ENDIF.
ZTCMA00160-MANDT =
ZVCMA00160-MANDT .
ZTCMA00160-WERKS =
ZVCMA00160-WERKS .
ZTCMA00160-PERIO =
ZVCMA00160-PERIO .
ZTCMA00160-WRKDY =
ZVCMA00160-WRKDY .
ZTCMA00160-REMARK =
ZVCMA00160-REMARK .
    IF SY-SUBRC = 0.
    UPDATE ZTCMA00160 ##WARN_OK.
    ELSE.
    INSERT ZTCMA00160 .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZVCMA00160-UPD_FLAG,
STATUS_ZVCMA00160-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
*---------------------------------------------------------------------*
FORM READ_SINGLE_ENTRY_ZVCMA00160.
  SELECT SINGLE * FROM ZTCMA00160 WHERE
WERKS = ZVCMA00160-WERKS AND
PERIO = ZVCMA00160-PERIO .
ZVCMA00160-MANDT =
ZTCMA00160-MANDT .
ZVCMA00160-WERKS =
ZTCMA00160-WERKS .
ZVCMA00160-PERIO =
ZTCMA00160-PERIO .
ZVCMA00160-WRKDY =
ZTCMA00160-WRKDY .
ZVCMA00160-REMARK =
ZTCMA00160-REMARK .
ENDFORM.
*---------------------------------------------------------------------*
FORM CORR_MAINT_ZVCMA00160 USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE ZVCMA00160-WERKS TO
ZTCMA00160-WERKS .
MOVE ZVCMA00160-PERIO TO
ZTCMA00160-PERIO .
MOVE ZVCMA00160-MANDT TO
ZTCMA00160-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZTCMA00160'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZTCMA00160 TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZTCMA00160'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
