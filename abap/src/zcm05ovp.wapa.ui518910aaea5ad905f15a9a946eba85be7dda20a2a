sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/mvc/Controller",                                                                                                                                                                                                                              
    "sap/ui/model/odata/v4/ODataModel",                                                                                                                                                                                                                        
    "cm05ovp/ext/common/FilterHelper",                                                                                                                                                                                                                         
    "cm05ovp/ext/detail/DetailDialog"                                                                                                                                                                                                                          
], function (Controller, ODataModel, FilterHelper, DetailDialog) {                                                                                                                                                                                             
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var SERVICE_URL = "/sap/opu/odata4/sap/zui_exception_stat_o4/srvd/sap/zui_exception_stat/0001/";                                                                                                                                                           
                                                                                                                                                                                                                                                               
        var SRC_NAME = {                                                                                                                                                                                                                                       
        SUBC: "외주 정합성",                                                                                                                                                                                                                                        
        QM:   "품질 검사",                                                                                                                                                                                                                                         
        INVC: "송장 정산",                                                                                                                                                                                                                                         
        RISK: "납기 리스크",                                                                                                                                                                                                                                        
        PO:   "PO"                                                                                                                                                                                                                                             
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    return Controller.extend("cm05ovp.ext.sourceTable.SourceTable", {                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
        onInit: function () {                                                                                                                                                                                                                                  
            this._oModel = new ODataModel({                                                                                                                                                                                                                    
                serviceUrl: SERVICE_URL,                                                                                                                                                                                                                       
                synchronizationMode: "None",                                                                                                                                                                                                                   
                operationMode: "Server",                                                                                                                                                                                                                       
                groupId: "$direct"                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
            FilterHelper.subscribe(this._load.bind(this));                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            // 발생출처 행 클릭 → 상세 화면 (문서 전체에서 한 번만 연결)                                                                                                                                                                                                             
            console.log("[SRC] init");                                                                                                                                                                                                                         
            if (!window.__srcClickBound) {                                                                                                                                                                                                                     
                window.__srcClickBound = true;                                                                                                                                                                                                                 
                document.addEventListener("click", function (e) {                                                                                                                                                                                              
                    var tr = e.target.closest && e.target.closest("tr[data-src]");                                                                                                                                                                             
                    console.log("[SRC] click row:", tr && tr.getAttribute("data-src"));                                                                                                                                                                        
                    if (tr) {                                                                                                                                                                                                                                  
                        console.log("[SRC] cond", window.__cm05Cond);                                                                                                                                                                                          
                        DetailDialog.open(tr.getAttribute("data-src"), tr.getAttribute("data-name"), window.__cm05Cond);                                                                                                                                       
                    }                                                                                                                                                                                                                                          
                }, true);                                                                                                                                                                                                                                      
            }                                                                                                                                                                                                                                                  
        },&nbsp;&nbsp;                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
        _load: function (aFilters, mCond) {                                                                                                                                                                                                                    
            window.__cm05Cond = mCond;                                                                                                                                                                                                                         
           this._oModel.bindList("/ExceptionStat", null, null, aFilters)                                                                                                                                                                                       
                .requestContexts(0, 1000)                                                                                                                                                                                                                      
                .then(function (aCtx) {                                                                                                                                                                                                                        
                    this._render(aCtx.map(function (c) { return c.getObject(); }));                                                                                                                                                                            
                }.bind(this))                                                                                                                                                                                                                                  
                .catch(function (e) {                                                                                                                                                                                                                          
                    this._set("<div style='padding:16px;color:#cf5555'>데이터 로딩 실패: " + e.message + "</div>");                                                                                                                                                   
                }.bind(this));                                                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _set: function (sHtml) {                                                                                                                                                                                                                               
            this.byId("srcHtml").setContent(sHtml);                                                                                                                                                                                                            
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _bindClick: function (o) {                                                                                                                                                                                                                             
            var dom = o.getDomRef();                                                                                                                                                                                                                           
            console.log("[SRC] bindClick dom:", dom);                                                                                                                                                                                                          
            if (!dom || dom.__srcBound) { return; }                                                                                                                                                                                                            
            dom.__srcBound = true;                                                                                                                                                                                                                             
            dom.addEventListener("click", function (e) {                                                                                                                                                                                                       
                var tr = e.target.closest("tr[data-src]");                                                                                                                                                                                                     
                console.log("[SRC] click row:", tr && tr.getAttribute("data-src"));                                                                                                                                                                            
                if (tr) {                                                                                                                                                                                                                                      
                    e.stopPropagation();                                                                                                                                                                                                                       
                    DetailDialog.open(tr.getAttribute("data-src"), tr.getAttribute("data-name"));                                                                                                                                                              
                }                                                                                                                                                                                                                                              
            }, true);                                                                                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _render: function (rows) {                                                                                                                                                                                                                             
            var g = {};                                                                                                                                                                                                                                        
            rows.forEach(function (r) {                                                                                                                                                                                                                        
                var k = r.srtyp;                                                                                                                                                                                                                               
                g[k] = g[k] || { total: 0, open: 0, done: 0 };                                                                                                                                                                                                 
                g[k].total += Number(r.TotalCnt) || 0;                                                                                                                                                                                                         
                g[k].open += (Number(r.OpenCnt) || 0) + (Number(r.ProgCnt) || 0) + (Number(r.ActnCnt) || 0);                                                                                                                                                   
                g[k].done += (Number(r.ClosedCnt) || 0) + (Number(r.RjctCnt) || 0);                                                                                                                                                                            
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var list = Object.keys(g).map(function (k) {                                                                                                                                                                                                       
                var v = g[k];                                                                                                                                                                                                                                  
                return { code: k, name: SRC_NAME[k] || k, total: v.total, open: v.open,                                                                                                                                                                        
                            rate: v.total ? Math.round(v.done / v.total * 1000) / 10 : 0 };                                                                                                                                                                    
            }).sort(function (a, b) { return b.total - a.total; });                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            var th = "padding:8px 10px;font-size:12px;font-weight:500;color:#7a8296;text-align:";                                                                                                                                                              
            var body = list.map(function (x) {                                                                                                                                                                                                                 
                return "<tr data-src='" + x.code + "' data-name='" + x.name + "' style='border-top:1px solid #eceff5;cursor:pointer'>" +                                                                                                                       
                    "<td style='padding:10px;font-weight:600;color:#2c3347'>" + x.name + "</td>" +                                                                                                                                                             
                    "<td style='padding:10px;text-align:right'>" + x.total + "</td>" +                                                                                                                                                                         
                    "<td style='padding:10px;text-align:right;font-weight:700;color:" + (x.open ? "#b8860b" : "#7a8296") + "'>" + x.open + "</td>" +                                                                                                           
                    "<td style='padding:10px;width:34%'><div style='display:flex;align-items:center;gap:8px'>" +                                                                                                                                               
                        "<div style='flex:1;height:8px;background:#eceff5;border-radius:4px'>" +                                                                                                                                                               
                        "<div style='width:" + x.rate + "%;height:8px;background:#5fb98f;border-radius:4px'></div></div>" +                                                                                                                                    
                        "<span style='width:42px;text-align:right;font-size:12px;color:#2a8a60'>" + x.rate + "%</span></div></td>" +                                                                                                                           
                    "<td style='padding:10px 6px;width:20px;text-align:right;color:#a3abbd;font-size:18px;line-height:1'><span class='cm05Chev'>›</span></td>" +                                                                                               
                    "</tr>";                                                                                                                                                                                                                                   
            }).join("");                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            this._set(                                                                                                                                                                                                                                         
                "<div style='min-height:220px;padding:8px 16px 16px;font-family:Malgun Gothic,sans-serif;color:#3b4358'>" +                                                                                                                                    
                "<table style='width:100%;border-collapse:collapse;font-size:13px'>" +                                                                                                                                                                         
                "<thead><tr>" +                                                                                                                                                                                                                                
                  "<th style='" + th + "left'>발생출처</th>" +                                                                                                                                                                                                     
                  "<th style='" + th + "right'>전체</th>" +                                                                                                                                                                                                      
                  "<th style='" + th + "right'>미결</th>" +                                                                                                                                                                                                      
                  "<th style='" + th + "left'>처리율</th>" +                                                                                                                                                                                                      
                 "<th></th>" +                                                                                                                                                                                                                                 
                "</tr></thead><tbody>" + body + "</tbody></table></div>");                                                                                                                                                                                     
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            