@Metadata.layer: #CORE
@UI: {
  headerInfo: { typeName: '예외',
                typeNamePlural: 'CM03 Exception Control Tower · 처리 대기 예외',
                title: { value: 'exnum' },
                description: { value: 'srnum' } },
  presentationVariant: [ { sortOrder: [ { by: 'exnum', direction: #DESC } ],
                           visualizations: [ { type: #AS_LINEITEM } ] } ]
}

annotate entity ZC_EXCEPTION with
{
  @UI.facet: [     { id: 'General', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                   label: '기본 정보', position: 10 } ,
                   { id: 'History', purpose: #STANDARD, type: #LINEITEM_REFERENCE, 
                   label: '처리 이력', position: 20, targetElement: '_History' },

                   { id: 'Request', purpose: #STANDARD, type: #LINEITEM_REFERENCE,
                   label: '후속 요청', position: 25, targetElement: '_Request' },                   
                   { id:              'RiskDetail', purpose: #STANDARD,
                   type:            #FIELDGROUP_REFERENCE,
                   label:           '납기 리스크 상세',
                   targetQualifier: 'Risk',
                   position:        30,
                   hidden:          #(hide_risk)} ,
                   { id:              'InvcDetail', purpose: #STANDARD,
                   type:            #FIELDGROUP_REFERENCE,
                   label:           '송장 정산 상세',
                   targetQualifier: 'Invc',
                   position:        35,
                   hidden:          #(hide_invc) },
                   { id: 'QmDetail', purpose: #STANDARD, 
                    type: #FIELDGROUP_REFERENCE,
                    label: '입고검사 상세', targetQualifier: 'Qm', 
                    position: 36,
                    hidden: #(hide_qm)},
                   { id: 'SubcDetail', purpose: #STANDARD,
                    type: #FIELDGROUP_REFERENCE,
                    label: '외주 정합성 상세', targetQualifier: 'Subc',
                    position: 37,
                    hidden: #(hide_subc) }                                  ]
  @UI: { lineItem: [ { position: 10, label: '예외번호' },
                     { type: #FOR_ACTION, dataAction: 'assignToMe',  label: '담당자 지정' },
                     { type: #FOR_ACTION, dataAction: 'assignTo', label: '담당자 재배정' },
                     { type: #FOR_ACTION, dataAction: 'releaseHold', label: 'Hold 해제' },
                     { type: #FOR_ACTION, dataAction: 'reject',      label: '반려' },
                     { type: #FOR_ACTION, dataAction: 'decideAction', label: '조치 결정' },
                     { type: #FOR_ACTION, dataAction: 'recheck', label: '재검증' },
                     { type: #FOR_ACTION, dataAction: 'close',       label: '종료' } ],
                  identification: [ { position: 10, label: '예외번호' },
    { type: #FOR_ACTION, dataAction: 'assignTo',    label: '다른 담당자에게 넘기기', hidden: #(hide_reassign) },
    { type: #FOR_ACTION, dataAction: 'aiRecommend', label: 'AI 추천', hidden: #(hide_early) },
    { type: #FOR_ACTION, dataAction: 'reject',      label: '반려',    hidden: #(hide_early) } ] }
  exnum;

  @UI: { lineItem: [ { position: 20, label: '발생출처' } ],
         selectionField: [ { position: 30 } ],                          // ★ 50 → 30
         identification: [ { position: 20, label: '발생출처' } ] ,
         textArrangement: #TEXT_ONLY }
  srtyp;

  @UI.identification: [ { position: 30, label: '원문서번호' } ]
  srnum;

  @UI.identification: [ { position: 40, label: '원문서 Item' } ]
  sritm;

  @UI: { lineItem: [ { position: 30, label: '담당그룹' } ],
         selectionField: [ { position: 40 } ],                          // ★ 10 → 40
         identification: [ { position: 50, label: '담당그룹' } ] ,
         textArrangement: #TEXT_ONLY }
  owgrp;

  @UI: { lineItem: [ { position: 40, label: '예외유형' } ],             // ★ selectionField 제거
         identification: [ { position: 60, label: '예외유형' } ] ,
         textArrangement: #TEXT_ONLY }
  extyp;
  
  @UI.hidden: true
  srtyp_text;
  @UI.hidden: true
  extyp_text;
  @UI.hidden: true
  owgrp_text;

  @UI: { lineItem: [ { position: 50, label: '처리상태', criticality: 'status_crit' } ],
         selectionField: [ { position: 20 } ],                          // ★ 30 → 20
         identification: [ { position: 70, label: '처리상태', criticality: 'status_crit' } ],
         textArrangement: #TEXT_ONLY }
  prsta;

  @UI.hidden: true
  prsta_text;

  @UI: { lineItem: [ { position: 60, label: '담당자' } ],               // ★ selectionField 제거
         identification: [ { position: 80, label: '담당자' } ] }
  uname;

  @UI: { lineItem: [ { position: 70, label: '발생일자' } ],
         identification: [ { position: 90, label: '발생일자' } ] }
  crdat;

  @UI: { lineItem: [ { position: 80, label: '경과일', criticality: 'age_crit' } ],
         identification: [ { position: 100, label: '경과일', criticality: 'age_crit' } ] }
  age_days;

  @UI.hidden: true
  age_crit;
  @UI.hidden: true
  status_crit;
  @UI.selectionField: [ { position: 10 } ]                              // ★ 5 → 10
  is_open;
  @UI.hidden: true
  hide_risk;

  @UI.fieldGroup: [ { qualifier: 'Risk', position: 10, label: '자재' } ]
  rk_matnr;

  @UI.fieldGroup: [ { qualifier: 'Risk', position: 20, label: '공급업체' } ]
  rk_lifnr;

  @UI.fieldGroup: [ { qualifier: 'Risk', position: 30, label: '공급업체명' } ]
  rk_name1;

  @UI.fieldGroup: [ { qualifier: 'Risk', position: 40, label: '예정입고일' } ]
  rk_pldat;

  @UI.fieldGroup: [ { qualifier: 'Risk', position: 50, label: '실제입고일' } ]
  rk_acdat;

  @UI.fieldGroup: [ { qualifier: 'Risk', position: 60, label: '지연일수' } ]
  rk_dlday;

  @UI: { fieldGroup: [ { qualifier: 'Risk', position: 70, label: '위험등급' } ],
         textArrangement: #TEXT_ONLY }
  rk_rkgrd;

  @UI.hidden: true
  rk_rkgrd_text;
   @UI.hidden: true
  hide_invc;

  @UI.fieldGroup: [ { qualifier: 'Invc', position: 10, label: '공급업체' } ]
  iv_lifnr;
  @UI.fieldGroup: [ { qualifier: 'Invc', position: 20, label: '공급업체명' } ]
