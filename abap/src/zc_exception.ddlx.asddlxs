  @UI.fieldGroup: [ { qualifier: 'Invc', position: 80, label: '송장 금액' } ]
  iv_wrbtr;
  @UI.fieldGroup: [ { qualifier: 'Invc', position: 75, label: 'PO 단가' } ]
  iv_ponetpr;
  @UI.fieldGroup: [ { qualifier: 'Invc', position: 85, label: '차이금액' } ]
  iv_diff;  
  @UI: { fieldGroup: [ { qualifier: 'Invc', position: 90, label: '대사상태' } ],
