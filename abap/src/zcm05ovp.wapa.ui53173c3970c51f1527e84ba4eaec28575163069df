sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/mvc/Controller",                                                                                                                                                                                                                              
    "sap/ui/model/odata/v4/ODataModel",                                                                                                                                                                                                                        
    "cm05ovp/ext/common/FilterHelper"                                                                                                                                                                                                                          
], function (Controller, ODataModel, FilterHelper) {                                                                                                                                                                                                           
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var SERVICE_URL = "/sap/opu/odata4/sap/zui_exception_stat_o4/srvd/sap/zui_exception_stat/0001/";                                                                                                                                                           
                                                                                                                                                                                                                                                               
    return Controller.extend("cm05ovp.ext.groupStatus.GroupStatus", {                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
        onInit: function () {                                                                                                                                                                                                                                  
            this._oModel = new ODataModel({                                                                                                                                                                                                                    
                serviceUrl: SERVICE_URL,                                                                                                                                                                                                                       
                synchronizationMode: "None",                                                                                                                                                                                                                   
                operationMode: "Server",                                                                                                                                                                                                                       
                groupId: "$direct"                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
            FilterHelper.subscribe(this._load.bind(this));                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _load: function (aFilters) {                                                                                                                                                                                                                           
            this._oModel.bindList("/ExceptionStat", null, null, aFilters)                                                                                                                                                                                      
                .requestContexts(0, 1000)                                                                                                                                                                                                                      
                .then(function (aCtx) {                                                                                                                                                                                                                        
                    this._render(aCtx.map(function (c) { return c.getObject(); }));                                                                                                                                                                            
                }.bind(this))                                                                                                                                                                                                                                  
                .catch(function (e) {                                                                                                                                                                                                                          
                    this._set("<div style='padding:16px;color:#cf5555'>데이터 로딩 실패: " + e.message + "</div>");                                                                                                                                                   
                }.bind(this));                                                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _set: function (sHtml) {                                                                                                                                                                                                                               
            var o = this.byId("groupHtml");                                                                                                                                                                                                                    
            if (!o) {                                                                                                                                                                                                                                          
                console.log("[GROUP] view id:", this.getView().getId(),                                                                                                                                                                                        
                    "content:", this.getView().getContent().map(function (c) { return c.getId(); }));                                                                                                                                                          
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
            o.setContent(sHtml);                                                                                                                                                                                                                               
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _render: function (rows) {                                                                                                                                                                                                                             
            var NAME = { MM: "자재(MM)", FI: "재무(FI)", QM: "품질(QM)", BOTH: "공동(BOTH)" };                                                                                                                                                                         
            var m = {};                                                                                                                                                                                                                                        
            rows.forEach(function (r) {                                                                                                                                                                                                                        
                var g = r.owgrp || "-";                                                                                                                                                                                                                        
                m[g] = m[g] || { t: 0, d: 0 };                                                                                                                                                                                                                 
                m[g].t += Number(r.TotalCnt) || 0;                                                                                                                                                                                                             
                m[g].d += (Number(r.ClosedCnt) || 0) + (Number(r.RjctCnt) || 0);                                                                                                                                                                               
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var html = "<div style='min-height:120px;padding:16px;font-family:Malgun Gothic,sans-serif;color:#3b4358'>";                                                                                                                                       
            var keys = Object.keys(m).sort(function (a, b) { return m[b].t - m[a].t; });                                                                                                                                                                       
            if (!keys.length) {                                                                                                                                                                                                                                
                html += "<div style='color:#7a8296'>표시할 데이터가 없어요</div>";                                                                                                                                                                                       
            }                                                                                                                                                                                                                                                  
            keys.forEach(function (k) {                                                                                                                                                                                                                        
                var v = m[k];                                                                                                                                                                                                                                  
                var open = v.t - v.d;                                                                                                                                                                                                                          
                var dw = v.t ? (v.d / v.t * 100) : 0;                                                                                                                                                                                                          
                html += "<div style='margin-bottom:18px'>" +                                                                                                                                                                                                   
                          "<div style='display:flex;font-size:13px;margin-bottom:6px'>" +                                                                                                                                                                      
                            "<b style='color:#2c3347;flex:1'>" + (NAME[k] || k) + "</b>" +                                                                                                                                                                     
                            "<span style='color:#7a8296;font-size:12px'>" + v.t + "건 · 미결 " + open + "</span>" +                                                                                                                                               
                          "</div>" +                                                                                                                                                                                                                           
                          "<div style='display:flex;height:14px;border-radius:7px;overflow:hidden;background:#eceff5'>" +                                                                                                                                      
                            "<div style='width:" + (100 - dw) + "%;background:#eab94d'></div>" +                                                                                                                                                               
                            "<div style='width:" + dw + "%;background:#5fb98f'></div>" +                                                                                                                                                                       
                          "</div></div>";                                                                                                                                                                                                                      
            });                                                                                                                                                                                                                                                
            html += "<div style='font-size:11px;color:#7a8296'>노랑 = 미결 · 초록 = 종료·반려</div></div>";                                                                                                                                                              
            this._set(html);                                                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            