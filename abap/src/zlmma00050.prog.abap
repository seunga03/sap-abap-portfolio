START-OF-SELECTION.
  PERFORM zz_get_data.
*&---------------------------------------------------------------------*
*& END-OF-SELECTION.
*&---------------------------------------------------------------------*
END-OF-SELECTION.
  IF sy-batch = 0.
    DATA(lv_count) = lines( gt_alv_top ).
    IF lv_count = 0.
      MESSAGE s040 DISPLAY LIKE 'E'.
*      RETURN.
    ENDIF.
    CALL SCREEN 100.
  ELSE.

ENDIF.
