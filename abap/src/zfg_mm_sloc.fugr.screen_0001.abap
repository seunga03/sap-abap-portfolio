PROCESS AFTER INPUT.
 MODULE LISTE_EXIT_COMMAND AT EXIT-COMMAND.
 MODULE LISTE_BEFORE_LOOP.
 LOOP AT EXTRACT.
   MODULE LISTE_INIT_WORKAREA.
   CHAIN.
    FIELD ZVMMA00050-LGORT .
    FIELD ZVMMA00050-WERKS .
    FIELD ZVMMA00050-LGOBE .
    FIELD ZVMMA00050-VSTEL .
    FIELD ZVMMA00050-LAND1 .
    FIELD ZVMMA00050-ACTYN .
    FIELD ZVMMA00050-ERNAM .
    FIELD ZVMMA00050-AENAM .
    MODULE SET_UPDATE_FLAG ON CHAIN-REQUEST.
   ENDCHAIN.
   FIELD VIM_MARKED MODULE LISTE_MARK_CHECKBOX.
   CHAIN.
    FIELD ZVMMA00050-LGORT .
    FIELD ZVMMA00050-WERKS .
    MODULE LISTE_UPDATE_LISTE.
   ENDCHAIN.
 ENDLOOP.
 MODULE LISTE_AFTER_LOOP.
