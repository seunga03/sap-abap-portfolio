sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/Element",                                                                                                                                                                                                                                     
    "sap/ui/model/Filter",                                                                                                                                                                                                                                     
    "sap/ui/model/FilterOperator"                                                                                                                                                                                                                              
], function (Element, Filter, FilterOperator) {                                                                                                                                                                                                                
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var OP = {                                                                                                                                                                                                                                                 
        EQ: FilterOperator.EQ, EEQ: FilterOperator.EQ, NE: FilterOperator.NE,                                                                                                                                                                                  
        GT: FilterOperator.GT, LT: FilterOperator.LT,                                                                                                                                                                                                          
        GE: FilterOperator.GE, LE: FilterOperator.LE,                                                                                                                                                                                                          
        Contains: FilterOperator.Contains, StartsWith: FilterOperator.StartsWith,                                                                                                                                                                              
        EndsWith: FilterOperator.EndsWith                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    // OVP 전역 필터바(MDC FilterBar) 찾기 (값 도움말용 FilterBar는 제외)                                                                                                                                                                                                     
    function findBar() {                                                                                                                                                                                                                                       
        var aBars = Element.registry.filter(function (o) {                                                                                                                                                                                                     
            var n = o.getMetadata().getName();                                                                                                                                                                                                                 
            return o.isA("sap.ui.mdc.filterbar.FilterBarBase") && n.indexOf(".vh.") < 0;                                                                                                                                                                       
        });                                                                                                                                                                                                                                                    
        return aBars.length ? aBars[0] : null;                                                                                                                                                                                                                 
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    // MDC 조건 → OData Filter 배열 (필드 사이 AND, 같은 필드 안 OR)                                                                                                                                                                                                        
     function toFilters(mCond, aExclude) {                                                                                                                                                                                                                     
        var aAnd = [];                                                                                                                                                                                                                                         
        Object.keys(mCond || {}).forEach(function (sProp) {                                                                                                                                                                                                    
            if (aExclude && aExclude.indexOf(sProp) >= 0) { return; }                                                                                                                                                                                          
            var aOr = [];                                                                                                                                                                                                                                      
            (mCond[sProp] || []).forEach(function (c) {                                                                                                                                                                                                        
                var v = c.values || [];                                                                                                                                                                                                                        
                if (c.operator === "BT" && v.length === 2) {                                                                                                                                                                                                   
                    aOr.push(new Filter(sProp, FilterOperator.BT, v[0], v[1]));                                                                                                                                                                                
                } else if (OP[c.operator] && v.length) {                                                                                                                                                                                                       
                    aOr.push(new Filter(sProp, OP[c.operator], v[0]));                                                                                                                                                                                         
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
            if (aOr.length === 1) {                                                                                                                                                                                                                            
                aAnd.push(aOr[0]);                                                                                                                                                                                                                             
            } else if (aOr.length > 1) {                                                                                                                                                                                                                       
                aAnd.push(new Filter({ filters: aOr, and: false }));                                                                                                                                                                                           
            }                                                                                                                                                                                                                                                  
        });                                                                                                                                                                                                                                                    
        return aAnd;                                                                                                                                                                                                                                           
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
        toFilters: toFilters,                                                                                                                                                                                                                                  
        subscribe: function (fnApply) {                                                                                                                                                                                                                        
            var iTry = 0, iTimer;                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            var poll = function () {                                                                                                                                                                                                                           
                var oBar = findBar();                                                                                                                                                                                                                          
                if (!oBar) {                                                                                                                                                                                                                                   
                    if (iTry++ < 40) { setTimeout(poll, 250); } else { fnApply([]); }                                                                                                                                                                          
                    return;                                                                                                                                                                                                                                    
                }                                                                                                                                                                                                                                              
                var run = function () {                                                                                                                                                                                                                        
                    clearTimeout(iTimer);                                                                                                                                                                                                                      
                    iTimer = setTimeout(function () {                                                                                                                                                                                                          
                        var mCond = oBar.getConditions();                                                                                                                                                                                                      
                        console.log("[CM05 filter]", JSON.stringify(mCond));                                                                                                                                                                                   
                        fnApply(toFilters(mCond), mCond);                                                                                                                                                                                                      
                    }, 300);                                                                                                                                                                                                                                   
                };                                                                                                                                                                                                                                             
                oBar.attachEvent("search", run);                                                                                                                                                                                                               
                oBar.attachEvent("filtersChanged", run);                                                                                                                                                                                                       
                console.log("[CM05 filter] bound to", oBar.getId());                                                                                                                                                                                           
                run();                                                                                                                                                                                                                                         
            };                                                                                                                                                                                                                                                 
            poll();                                                                                                                                                                                                                                            
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            