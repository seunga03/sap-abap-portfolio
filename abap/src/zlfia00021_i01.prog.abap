MODULE user_command_0100 INPUT.
  CASE ok_code.

    WHEN 'BACK'.
      LEAVE TO SCREEN 0.

    WHEN 'SAVE'.
      PERFORM set_dummy_0200.
      call screen 200.
  ENDCASE.
ENDMODULE.
