sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/mvc/Controller",                                                                                                                                                                                                                              
    "sap/ui/model/odata/v4/ODataModel",                                                                                                                                                                                                                        
    "cm05ovp/ext/common/FilterHelper"                                                                                                                                                                                                                          
], function (Controller, ODataModel, FilterHelper) {                                                                                                                                                                                                           
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var SERVICE_URL = "/sap/opu/odata4/sap/zui_exception_stat_o4/srvd/sap/zui_exception_stat/0001/";                                                                                                                                                           
                                                                                                                                                                                                                                                               
    function pct(n) { return Math.round(n * 1000) / 10; }                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
    return Controller.extend("cm05ovp.ext.monthCompare.MonthCompare", {                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
        onInit: function () {                                                                                                                                                                                                                                  
            this._oModel = new ODataModel({                                                                                                                                                                                                                    
                serviceUrl: SERVICE_URL,                                                                                                                                                                                                                       
                synchronizationMode: "None",                                                                                                                                                                                                                   
                operationMode: "Server",                                                                                                                                                                                                                       
                groupId: "$direct"                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
            FilterHelper.subscribe(this._load.bind(this));                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _load: function (aIgnored, mCond) {                                                                                                                                                                                                                    
            // 월 비교 카드는 '발생월' 필터를 제외하고 나머지 필터만 적용                                                                                                                                                                                                              
            var aFilters = FilterHelper.toFilters(mCond, ["crmon"]);                                                                                                                                                                                           
            this._oModel.bindList("/ExceptionStat", null, null, aFilters)                                                                                                                                                                                      
                .requestContexts(0, 1000)                                                                                                                                                                                                                      
                .then(function (aCtx) {                                                                                                                                                                                                                        
                    this._render(aCtx.map(function (c) { return c.getObject(); }));                                                                                                                                                                            
                }.bind(this))                                                                                                                                                                                                                                  
                .catch(function (e) {                                                                                                                                                                                                                          
                    this._set("<div style='padding:16px;color:#cf5555'>데이터 로딩 실패: " + e.message + "</div>");                                                                                                                                                   
                }.bind(this));                                                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _set: function (sHtml) {                                                                                                                                                                                                                               
            this.byId("monthHtml").setContent(sHtml);                                                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _summary: function (m, keys) {                                                                                                                                                                                                                         
            var ks = keys.filter(function (k) { return k !== "-"; });                                                                                                                                                                                          
            if (ks.length < 2) { return ""; }                                                                                                                                                                                                                  
            var prev = m[ks[ks.length - 2]], cur = m[ks[ks.length - 1]];                                                                                                                                                                                       
            var curKey = ks[ks.length - 1];                                                                                                                                                                                                                    
            var diff = cur.t - prev.t;                                                                                                                                                                                                                         
            var pRate = prev.t ? (prev.t - prev.d) / prev.t : 0;                                                                                                                                                                                               
            var cRate = cur.t ? (cur.t - cur.d) / cur.t : 0;                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            var txt = curKey + "은 전월보다 " +                                                                                                                                                                                                                     
                (diff > 0 ? diff + "건 늘었고, " : diff < 0 ? (-diff) + "건 줄었고, " : "건수가 같고, ") +                                                                                                                                                                  
                "미결 비율이 " + pct(pRate) + "% → " + pct(cRate) + "%로 " +                                                                                                                                                                                         
                (cRate > pRate ? "높아졌어요." : cRate < pRate ? "낮아졌어요." : "같아요.");                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var warn = cRate > pRate;                                                                                                                                                                                                                          
            return "<div style='margin-top:12px;padding:10px 12px;border-radius:10px;font-size:13px;" +                                                                                                                                                        
                   (warn ? "background:#fdf3dc;color:#b8860b" : "background:#e6f6ee;color:#2a8a60") + "'>" + txt + "</div>";                                                                                                                                   
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _render: function (rows) {                                                                                                                                                                                                                             
            var m = {};                                                                                                                                                                                                                                        
            rows.forEach(function (r) {                                                                                                                                                                                                                        
                var k = r.crmon || "-";                                                                                                                                                                                                                        
                m[k] = m[k] || { t: 0, d: 0 };                                                                                                                                                                                                                 
                m[k].t += Number(r.TotalCnt) || 0;                                                                                                                                                                                                             
                m[k].d += (Number(r.ClosedCnt) || 0) + (Number(r.RjctCnt) || 0);                                                                                                                                                                               
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var keys = Object.keys(m).sort();                                                                                                                                                                                                                  
            var html = "<div style='min-height:120px;padding:16px;font-family:Malgun Gothic,sans-serif;color:#3b4358'>";                                                                                                                                       
            if (!keys.length) {                                                                                                                                                                                                                                
                html += "<div style='color:#7a8296'>표시할 데이터가 없어요</div>";                                                                                                                                                                                       
            }                                                                                                                                                                                                                                                  
            keys.forEach(function (k) {                                                                                                                                                                                                                        
                var v = m[k], open = v.t - v.d;                                                                                                                                                                                                                
                var dw = v.t ? (v.d / v.t * 100) : 0;                                                                                                                                                                                                          
                html += "<div style='margin-bottom:20px'>" +                                                                                                                                                                                                   
                          "<div style='display:flex;font-size:13px;margin-bottom:6px'>" +                                                                                                                                                                      
                            "<b style='color:#2c3347;flex:1'>" + k + "</b>" +                                                                                                                                                                                  
                            "<span style='color:#7a8296;font-size:12px'>" + v.t + "건 · 미결 " + open + "</span>" +                                                                                                                                               
                          "</div>" +                                                                                                                                                                                                                           
                          "<div style='display:flex;height:18px;border-radius:9px;overflow:hidden;background:#eceff5'>" +                                                                                                                                      
                            "<div style='width:" + (100 - dw) + "%;background:#eab94d'></div>" +                                                                                                                                                               
                            "<div style='width:" + dw + "%;background:#5fb98f'></div>" +                                                                                                                                                                       
                          "</div></div>";                                                                                                                                                                                                                      
            });                                                                                                                                                                                                                                                
            html += "<div style='font-size:11px;color:#7a8296'>노랑 = 미결 · 초록 = 종료·반려</div>" +                                                                                                                                                                   
                    this._summary(m, keys) + "</div>";                                                                                                                                                                                                         
            this._set(html);                                                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            