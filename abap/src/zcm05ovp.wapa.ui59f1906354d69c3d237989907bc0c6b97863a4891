sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/mvc/Controller",                                                                                                                                                                                                                              
    "sap/ui/model/odata/v4/ODataModel",                                                                                                                                                                                                                        
    "cm05ovp/ext/common/FilterHelper"                                                                                                                                                                                                                          
], function (Controller, ODataModel, FilterHelper) {                                                                                                                                                                                                           
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var SERVICE_URL = "/sap/opu/odata4/sap/zui_exception_stat_o4/srvd/sap/zui_exception_stat/0001/";                                                                                                                                                           
                                                                                                                                                                                                                                                               
    return Controller.extend("cm05ovp.ext.statusDonut.StatusDonut", {                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
        onInit: function () {                                                                                                                                                                                                                                  
            this._oModel = new ODataModel({                                                                                                                                                                                                                    
                serviceUrl: SERVICE_URL,                                                                                                                                                                                                                       
                synchronizationMode: "None",                                                                                                                                                                                                                   
                operationMode: "Server",                                                                                                                                                                                                                       
                groupId: "$direct"                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
            FilterHelper.subscribe(this._load.bind(this));                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _load: function (aFilters) {                                                                                                                                                                                                                           
            this._oModel.bindList("/ExceptionStat", null, null, aFilters)                                                                                                                                                                                      
                .requestContexts(0, 1000)                                                                                                                                                                                                                      
                .then(function (aCtx) {                                                                                                                                                                                                                        
                    this._render(aCtx.map(function (c) { return c.getObject(); }));                                                                                                                                                                            
                }.bind(this))                                                                                                                                                                                                                                  
                .catch(function (e) {                                                                                                                                                                                                                          
                    this._set("<div style='padding:16px;color:#cf5555'>데이터 로딩 실패: " + e.message + "</div>");                                                                                                                                                   
                }.bind(this));                                                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _set: function (sHtml) {                                                                                                                                                                                                                               
            this.byId("donutHtml").setContent(sHtml);                                                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _render: function (rows) {                                                                                                                                                                                                                             
            var sum = function (f) {                                                                                                                                                                                                                           
                return rows.reduce(function (a, r) { return a + (Number(r[f]) || 0); }, 0);                                                                                                                                                                    
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Soft Pastel 색 (보라는 토큰에 없어서 추가한 색)                                                                                                                                                                                                               
            var segs = [                                                                                                                                                                                                                                       
                { name: "접수대기",   n: sum("OpenCnt"),   color: "#eab94d" },                                                                                                                                                                                     
                { name: "처리중",     n: sum("ProgCnt"),   color: "#6f9bec" },                                                                                                                                                                                    
                { name: "조치실행중", n: sum("ActnCnt"),   color: "#a78bdb" },                                                                                                                                                                                      
                { name: "종료",       n: sum("ClosedCnt"), color: "#5fb98f" },                                                                                                                                                                                   
                { name: "반려",       n: sum("RjctCnt"),   color: "#a3abbd" }                                                                                                                                                                                    
            ];                                                                                                                                                                                                                                                 
            var total = segs.reduce(function (a, s) { return a + s.n; }, 0);                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            var R = 60, C = 2 * Math.PI * R, off = 0;                                                                                                                                                                                                          
            var circles = segs.filter(function (s) { return s.n > 0; }).map(function (s) {                                                                                                                                                                     
                var len = s.n / total * C;                                                                                                                                                                                                                     
                var el = "<circle cx='80' cy='80' r='" + R + "' stroke='" + s.color +                                                                                                                                                                          
                         "' stroke-dasharray='" + len.toFixed(1) + " " + C.toFixed(1) +                                                                                                                                                                        
                         "' stroke-dashoffset='" + (-off).toFixed(1) + "'/>";                                                                                                                                                                                  
                off += len;                                                                                                                                                                                                                                    
                return el;                                                                                                                                                                                                                                     
            }).join("");                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            var legend = segs.map(function (s) {                                                                                                                                                                                                               
                return "<div style='display:flex;align-items:center;gap:6px;margin:3px 0'>" +                                                                                                                                                                  
                       "<span style='width:9px;height:9px;border-radius:2px;background:" + s.color + "'></span>" +                                                                                                                                             
                       "<span style='flex:1;font-size:12px;color:#7a8296'>" + s.name + "</span>" +                                                                                                                                                             
                       "<b style='font-size:12px;color:#3b4358'>" + s.n + "</b></div>";                                                                                                                                                                        
            }).join("");                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            var D = 170; // 도넛 크기(px). 150 / 170 / 190 중에서 고르세요                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var legend = segs.map(function (s) {                                                                                                                                                                                                               
                return "<div style='display:flex;align-items:center;gap:8px;margin:5px 0'>" +                                                                                                                                                                  
                       "<span style='width:10px;height:10px;border-radius:2px;background:" + s.color + "'></span>" +                                                                                                                                           
                       "<span style='flex:1;font-size:13px;color:#7a8296'>" + s.name + "</span>" +                                                                                                                                                             
                       "<b style='font-size:13px;color:#3b4358'>" + s.n + "</b></div>";                                                                                                                                                                        
            }).join("");                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            this._set(                                                                                                                                                                                                                                         
                "<div style='min-height:180px;padding:12px 20px;font-family:Malgun Gothic,sans-serif;color:#3b4358;display:flex;align-items:center'>" +                                                                                                        
                  "<div style='display:flex;align-items:center;gap:24px;width:100%'>" +                                                                                                                                                                        
                    "<div style='position:relative;width:" + D + "px;height:" + D + "px;flex:none'>" +                                                                                                                                                         
                      "<svg viewBox='0 0 160 160' width='" + D + "' height='" + D + "' role='img' aria-label='상태 분포 도넛'>" +                                                                                                                                    
                        "<circle cx='80' cy='80' r='" + R + "' fill='none' stroke='#eceff5' stroke-width='22'/>" +                                                                                                                                             
                        "<g transform='rotate(-90 80 80)' fill='none' stroke-width='22'>" + circles + "</g>" +                                                                                                                                                 
                      "</svg>" +                                                                                                                                                                                                                               
                      "<div style='position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center'>" +                                                                                                                 
                        "<span style='font-size:32px;font-weight:700;color:#2c3347;line-height:1'>" + total + "</span>" +                                                                                                                                      
                        "<span style='font-size:12px;color:#7a8296'>전체</span></div>" +                                                                                                                                                                         
                    "</div>" +                                                                                                                                                                                                                                 
                    "<div style='flex:1;min-width:0'>" + legend + "</div>" +                                                                                                                                                                                   
                  "</div>" +                                                                                                                                                                                                                                   
                "</div>");                                                                                                                                                                                                                                     
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            