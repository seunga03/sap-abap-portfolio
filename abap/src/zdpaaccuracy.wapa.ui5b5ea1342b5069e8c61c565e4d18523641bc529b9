                                                                                                                                                                                                                                                               
sap.ui.define([], function () {                                                                                                                                                                                                                                
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    function toNumber(value) {                                                                                                                                                                                                                                 
        const n = Number(value);                                                                                                                                                                                                                               
        return Number.isFinite(n) ? n : 0;                                                                                                                                                                                                                     
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
        // 활성 버전 추출                                                                                                                                                                                                                                            
        getActiveForecasts: function (rows) {                                                                                                                                                                                                                  
            return rows.filter(function (row) {                                                                                                                                                                                                                
                return row.Activ === "X";                                                                                                                                                                                                                      
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 과거 버전 추출                                                                                                                                                                                                                                            
        getHistoryForecasts: function (rows) {                                                                                                                                                                                                                 
            return rows.filter(function (row) {                                                                                                                                                                                                                
                return row.Activ !== "X";                                                                                                                                                                                                                      
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 활성 예측 KPI 계산                                                                                                                                                                                                                                        
        calculateActiveKpi: function (rows) {                                                                                                                                                                                                                  
            const active = this.getActiveForecasts(rows);                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            const adjusted = active.filter(function (row) {                                                                                                                                                                                                    
                return Math.abs(                                                                                                                                                                                                                               
                    toNumber(row.Aiqty) - toNumber(row.Fiqty)                                                                                                                                                                                                  
                ) > 0.000001;                                                                                                                                                                                                                                  
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            const waiting = active.filter(function (row) {                                                                                                                                                                                                     
                return row.EvalStatus === "WAIT";                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            return {                                                                                                                                                                                                                                           
                activeCount: active.length,                                                                                                                                                                                                                    
                adjustedCount: adjusted.length,                                                                                                                                                                                                                
                adjustmentRate: active.length                                                                                                                                                                                                                  
                    ? adjusted.length / active.length * 100                                                                                                                                                                                                    
                    : 0,                                                                                                                                                                                                                                       
                waitingCount: waiting.length                                                                                                                                                                                                                   
            };                                                                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 플랜트·자재·예측대상기간별 버전 그룹 생성                                                                                                                                                                                                                             
        groupForecastVersions: function (rows) {                                                                                                                                                                                                               
            const groups = new Map();                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            rows.forEach(function (row) {                                                                                                                                                                                                                      
                const key = JSON.stringify([                                                                                                                                                                                                                   
                    row.Werks,                                                                                                                                                                                                                                 
                    row.Matnr,                                                                                                                                                                                                                                 
                    row.Fcdat,                                                                                                                                                                                                                                 
                    row.Tcdat,                                                                                                                                                                                                                                 
                    row.Meins                                                                                                                                                                                                                                  
                ]);                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                if (!groups.has(key)) {                                                                                                                                                                                                                        
                    groups.set(key, {                                                                                                                                                                                                                          
                        key: key,                                                                                                                                                                                                                              
                        werks: row.Werks,                                                                                                                                                                                                                      
                        matnr: row.Matnr,                                                                                                                                                                                                                      
                        fcdat: row.Fcdat,                                                                                                                                                                                                                      
                        tcdat: row.Tcdat,                                                                                                                                                                                                                      
                        meins: row.Meins,                                                                                                                                                                                                                      
                        rows: []                                                                                                                                                                                                                               
                    });                                                                                                                                                                                                                                        
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                groups.get(key).rows.push(row);                                                                                                                                                                                                                
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            return Array.from(groups.values())                                                                                                                                                                                                                 
                .map(function (group) {                                                                                                                                                                                                                        
                    // 실제 생성 시간순 정렬&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                    
                    group.rows.sort(function (a, b) {                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                        // 날짜: YYYY-MM-DD 또는 YYYYMMDD                                                                                                                                                                                                          
                        function normalizeDate(value) {                                                                                                                                                                                                        
                            return String(value || "").replace(/-/g, "");                                                                                                                                                                                      
                        }                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                        // 시간: HH:mm:ss 또는 HHmmss                                                                                                                                                                                                              
                        function normalizeTime(value) {                                                                                                                                                                                                        
                            return String(value || "").replace(/:/g, "");                                                                                                                                                                                      
                        }                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                        const dateA = normalizeDate(a.Cdate);                                                                                                                                                                                                  
                        const dateB = normalizeDate(b.Cdate);                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                        const timeA = normalizeTime(a.Ctime);                                                                                                                                                                                                  
                        const timeB = normalizeTime(b.Ctime);                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                        // 생성일시가 모두 존재하면 날짜·시간순 정렬                                                                                                                                                                                                             
                        if (dateA && dateB && timeA && timeB) {                                                                                                                                                                                                
                            const dateCompare = dateA.localeCompare(dateB);                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                            if (dateCompare !== 0) {                                                                                                                                                                                                           
                                return dateCompare;                                                                                                                                                                                                            
                            }                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                            const timeCompare = timeA.localeCompare(timeB);                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                            if (timeCompare !== 0) {                                                                                                                                                                                                           
                                return timeCompare;                                                                                                                                                                                                            
                            }                                                                                                                                                                                                                                  
                        }                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                        // 생성일시가 없거나 동일하면 예측번호로 보조 정렬                                                                                                                                                                                                          
                        return String(a.Fcsno)                                                                                                                                                                                                                 
                            .localeCompare(String(b.Fcsno)) ||                                                                                                                                                                                                 
                            String(a.Iteno)                                                                                                                                                                                                                    
                            .localeCompare(String(b.Iteno));                                                                                                                                                                                                   
                    });                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                    group.versionCount = group.rows.length;                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                    group.activeCount = group.rows.filter(                                                                                                                                                                                                     
                        function (row) {                                                                                                                                                                                                                       
                            return row.Activ === "X";                                                                                                                                                                                                          
                        }                                                                                                                                                                                                                                      
                    ).length;                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                    group.label =                                                                                                                                                                                                                              
                        group.werks + " / " +                                                                                                                                                                                                                  
                        group.matnr + " / " +                                                                                                                                                                                                                  
                        group.fcdat + " ~ " +                                                                                                                                                                                                                  
                        group.tcdat +                                                                                                                                                                                                                          
                        " (" + group.versionCount + "건)";                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                    return group;                                                                                                                                                                                                                              
                })                                                                                                                                                                                                                                             
                .sort(function (a, b) {                                                                                                                                                                                                                        
                    return a.werks.localeCompare(b.werks) ||                                                                                                                                                                                                   
                        a.matnr.localeCompare(b.matnr) ||                                                                                                                                                                                                      
                        a.fcdat.localeCompare(b.fcdat);                                                                                                                                                                                                        
                });                                                                                                                                                                                                                                            
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
        // 활성 예측의 정확도 평가 KPI 계산                                                                                                                                                                                                                                
        calculateAccuracyKpi: function (rows) {                                                                                                                                                                                                                
            const active = this.getActiveForecasts(rows);                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            const completed = active.filter(function (row) {                                                                                                                                                                                                   
                return row.EvalStatus === "DONE" &&                                                                                                                                                                                                            
                       row.EvalEligible === "X";                                                                                                                                                                                                               
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            const inProgress = active.filter(function (row) {                                                                                                                                                                                                  
                return row.EvalStatus === "PROG";                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            const waiting = active.filter(function (row) {                                                                                                                                                                                                     
                return row.EvalStatus === "WAIT";                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 평가 완료 데이터의 단위 확인                                                                                                                                                                                                                                
            const units = new Set(                                                                                                                                                                                                                             
                completed.map(function (row) {                                                                                                                                                                                                                 
                    return String(row.Meins || "");                                                                                                                                                                                                            
                })                                                                                                                                                                                                                                             
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // 서로 다른 수량 단위는 합산하지 않음                                                                                                                                                                                                                            
            const sameUnit = units.size <= 1;                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            let actualSum = 0;                                                                                                                                                                                                                                 
            let aiAbsSum = 0;                                                                                                                                                                                                                                  
            let finalAbsSum = 0;                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            if (sameUnit) {                                                                                                                                                                                                                                    
                completed.forEach(function (row) {                                                                                                                                                                                                             
                    actualSum += toNumber(row.ActualQty);                                                                                                                                                                                                      
                    aiAbsSum += toNumber(row.AiAbsErr);                                                                                                                                                                                                        
                    finalAbsSum += toNumber(row.FiAbsErr);                                                                                                                                                                                                     
                });                                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 실제 수요량 합계가 0이면 WAPE 산출 불가                                                                                                                                                                                                                       
            const wapeAvailable =                                                                                                                                                                                                                              
                completed.length > 0 &&                                                                                                                                                                                                                        
                sameUnit &&                                                                                                                                                                                                                                    
                actualSum > 0;                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            return {                                                                                                                                                                                                                                           
                activeCount: active.length,                                                                                                                                                                                                                    
                completedCount: completed.length,                                                                                                                                                                                                              
                inProgressCount: inProgress.length,                                                                                                                                                                                                            
                waitingCount: waiting.length,                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                wapeAvailable: wapeAvailable,                                                                                                                                                                                                                  
                mixedUnits: !sameUnit,                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                aiWape: wapeAvailable                                                                                                                                                                                                                          
                    ? aiAbsSum / actualSum * 100                                                                                                                                                                                                               
                    : null,                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                finalWape: wapeAvailable                                                                                                                                                                                                                       
                    ? finalAbsSum / actualSum * 100                                                                                                                                                                                                            
                    : null,                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                // 양수이면 담당자 조정 후 절대오차 감소                                                                                                                                                                                                                       
                adjustmentEffect:                                                                                                                                                                                                                              
                    completed.length > 0 && sameUnit                                                                                                                                                                                                           
                        ? aiAbsSum - finalAbsSum                                                                                                                                                                                                               
                        : null,                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                unit: sameUnit                                                                                                                                                                                                                                 
                    ? Array.from(units)[0] || ""                                                                                                                                                                                                               
                    : ""                                                                                                                                                                                                                                       
            };                                                                                                                                                                                                                                                 
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
    };                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               