                } else {                                                                                                                                                                                                                                       
                    applyFilters.push(fields[field] + (operator === FilterOperator.GT ? " gt " : " eq ") + literal(field, from));                                                                                                                              
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
            if (selection) {                                                                                                                                                                                                                                   
                if (definition.date) { add(definition.date, FilterOperator.BT, selection.from, selection.to); }                                                                                                                                                
