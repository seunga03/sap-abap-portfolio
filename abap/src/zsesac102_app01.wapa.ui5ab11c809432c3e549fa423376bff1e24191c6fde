        _quickPeriod: function (kind) {                                                                                                                                                                                                                        
            var now = new Date();                                                                                                                                                                                                                              
            var from = new Date(now.getFullYear(), now.getMonth(), 1);                                                                                                                                                                                         
            var to = new Date(now.getFullYear(), now.getMonth(), now.getDate());                                                                                                                                                                               
            if (kind === "last") { from = new Date(now.getFullYear(), now.getMonth() - 1, 1); to = new Date(now.getFullYear(), now.getMonth(), 0); }                                                                                                           
            if (kind === "year") { from = new Date(now.getFullYear(), 0, 1); }                                                                                                                                                                                 
            if (kind === "week") { from = new Date(to); from.setDate(from.getDate() - 6); }                                                                                                                                                                    
            var ui = this.getView().getModel("ui");                                                                                                                                                                                                            
            this._dateValid = true;                                                                                                                                                                                                                            
            ui.setProperty("/dateFrom", from); ui.setProperty("/dateTo", to);                                                                                                                                                                                  
