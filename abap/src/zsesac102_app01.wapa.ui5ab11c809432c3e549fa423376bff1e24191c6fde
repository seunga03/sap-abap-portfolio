        },                                                                                                                                                                                                                                                     
        _search: function (rows) {                                                                                                                                                                                                                             
            var query = this.getView().getModel("ui").getProperty("/query").trim().toLowerCase();                                                                                                                                                              
            return query ? rows.filter(function (r) {                                                                                                                                                                                                          
                return [r.matnr, r.maktx, r.werks, r.wname, r.lgort, r.lgobe, r.ebeln, r.ebelp, r.banfn, r.bnfpo, r.mblnr, r.lifnr, r.dashstatus].join(" ").toLowerCase().includes(query);                                                                     
            }) : rows;                                                                                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
        _apply: function () {                                                                                                                                                                                                                                  
            if (!this._period || this._closed) { return; }                                                                                                                                                                                                     
            var ui = this.getView().getModel("ui");                                                                                                                                                                                                            
            var scoped = {};                                                                                                                                                                                                                                   
            ["Stock", "Movement", "PurchaseOrder", "PurchaseRequest", "Shortage"].forEach(function (name) {                                                                                                                                                    
                scoped[name] = this._scope(this._data[name], name === "Shortage" || name === "Movement");                                                                                                                                                      
            }, this);                                                                                                                                                                                                                                          
            this._scoped = scoped;                                                                                                                                                                                                                             
            ui.setProperty("/periodText", dateText(this._period.from) + " ~ " + dateText(this._period.to));                                                                                                                                                    
            var plant = (this._viewSelection || this._selection).plant;                                                                                                                                                                                        
            ui.setProperty("/scopeText", "요약 범위: " + (plant ? (this._plantNames.get(plant) || plant) + " (" + plant + ")" : "전체 플랜트") + " / 기간: PO 생성일 · 이동 전기일 · PR 요청일 / 재고는 현재 기준 / 안전재고는 플랜트 전체 창고 기준");                                                   
                                                                                                                                                                                                                                                               
            var stock = this._search(scoped.Stock).map(function (r) { return this._decorate(r, "stock"); }, this);                                                                                                                                             
            stock.sort(function (a, b) { return (a.werks + a.lgort + a.matnr).localeCompare(b.werks + b.lgort + b.matnr); });                                                                                                                                  
            var shortage = this._search(scoped.Shortage).map(function (r) { return this._decorate(r, "shortage"); }, this);                                                                                                                                    
            var sortField = ui.getProperty("/shortageSort") === "qty" ? "shortqty" : "shortpct";                                                                                                                                                               
            shortage.sort(function (a, b) { return num(b[sortField]) - num(a[sortField]) || (a.werks + a.matnr).localeCompare(b.werks + b.matnr); });                                                                                                          
            shortage.forEach(function (r, i) { r.rank = String(i + 1).padStart(2, "0"); });                                                                                                                                                                    
            var movementType = ui.getProperty("/movementType");                                                                                                                                                                                                
            var movement = this._search(scoped.Movement).filter(function (r) {                                                                                                                                                                                 
                return !movementType || (movementType === "GI" ? r.bwart === "601" || r.bwart === "655" : r.bwart === movementType);                                                                                                                           
            }).map(function (r) { return this._decorate(r, "movement"); }, this);                                                                                                                                                                              
            movement.sort(function (a, b) { return String(b.budat).localeCompare(String(a.budat)) || String(b.mblnr).localeCompare(String(a.mblnr)) || String(a.zeile).localeCompare(String(b.zeile)); });                                                     
            var purchase = this._search(scoped.PurchaseOrder).filter(function (r) { return !ui.getProperty("/openOnly") || num(r.openqty) > 0; })                                                                                                              
                .map(function (r) { return this._decorate(r, "purchase"); }, this);                                                                                                                                                                            
            purchase.sort(function (a, b) { return String(b.bedat).localeCompare(String(a.bedat)) || String(b.ebeln).localeCompare(String(a.ebeln)) || String(a.ebelp).localeCompare(String(b.ebelp)); });                                                     
            var requestStatus = ui.getProperty("/requestStatus");                                                                                                                                                                                              
            var request = this._search(scoped.PurchaseRequest).filter(function (r) { return !requestStatus || r.dashstatus === requestStatus; })                                                                                                               
                .map(function (r) { return this._decorate(r, "request"); }, this);                                                                                                                                                                             
            request.sort(function (a, b) { return String(b.rdate).localeCompare(String(a.rdate)) || String(b.banfn).localeCompare(String(a.banfn)) || String(a.bnfpo).localeCompare(String(b.bnfpo)); });                                                      
            var tables = { stock: stock, shortage: shortage, movement: movement, purchase: purchase, request: request };                                                                                                                                       
            var entityNames = { stock: "Stock", shortage: "Shortage", movement: "Movement", purchase: "PurchaseOrder", request: "PurchaseRequest" };                                                                                                           
            Object.keys(tables).forEach(function (key) {                                                                                                                                                                                                       
                ui.setProperty("/rows/" + key, tables[key]);                                                                                                                                                                                                   
                ui.setProperty("/counts/" + key, this._errors[entityNames[key]] ? "—" : tables[key].length.toLocaleString("ko-KR"));                                                                                                                           
                ui.setProperty("/empty/" + key, this._errors[entityNames[key]] ? "조회에 실패했습니다. 오류 상세를 확인해 주세요." : "조회 조건에 해당하는 자료가 없습니다.");                                                                                                                     
            }, this);                                                                                                                                                                                                                                          
            ui.setProperty("/summaryHtml", this._summaryHtml(scoped));                                                                                                                                                                                         
            ui.setProperty("/plantsHtml", this._plantsHtml(scoped.Stock));                                                                                                                                                                                     
            // 대시보드는 합계와 안전재고 목록만 표시한다. 상세 문서는 별도 서버 조회 결과만 사용한다.                                                                                                                                                                                              
            ["stock", "movement", "purchase", "request"].forEach(function (key) {                                                                                                                                                                              
                ui.setProperty("/rows/" + key, []); ui.setProperty("/counts/" + key, "—");                                                                                                                                                                     
                ui.setProperty("/empty/" + key, "문서 조회를 눌러 주세요.");                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
            if (ui.getProperty("/report") === "shortage") { ui.setProperty("/rows/shortage", []); ui.setProperty("/counts/shortage", "—"); }                                                                                                                   
            this._renderDocumentPage();                                                                                                                                                                                                                        
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _decorate: function (raw, kind) {                                                                                                                                                                                                                      
            var r = Object.assign({}, raw, { kind: kind });                                                                                                                                                                                                    
            var unit = raw.meins || "단위 미등록";                                                                                                                                                                                                                  
            ["stqty", "rsqty", "qisty", "safetyqty", "shortqty", "menge", "rqty", "poqty", "grqty", "openqty", "insqty", "passqty", "failqty", "releasedqty"].forEach(function (key) {                                                                         
                r[key + "Text"] = raw[key] == null ? "—" : this._quantity.format(num(raw[key]));                                                                                                                                                               
            }, this);                                                                                                                                                                                                                                          
            r.shortpctText = raw.shortpct == null ? "—" : num(raw.shortpct).toFixed(2);                                                                                                                                                                        
            r.unitText = unit;                                                                                                                                                                                                                                 
            r.plantText = raw.wname || this._plantNames.get(raw.werks) || text(raw.werks);                                                                                                                                                                     
            var wh = this._storageRows.get(raw.werks + "|" + raw.lgort);                                                                                                                                                                                       
            r.storageText = raw.lgobe || wh && wh.lgobe || text(raw.lgort);                                                                                                                                                                                    
            r.locationText = text(raw.werks) + (raw.lgort ? " / " + raw.lgort : " · 플랜트 기준");                                                                                                                                                                  
            r.materialText = raw.maktx || "명칭 미등록";                                                                                                                                                                                                            
            r.documentText = kind === "movement" ? text(raw.mblnr) + " / " + text(raw.mjahr)                                                                                                                                                                   
                : kind === "request" ? text(raw.banfn) : text(raw.ebeln);                                                                                                                                                                                      
            r.itemText = kind === "movement" ? text(raw.zeile) : kind === "request" ? text(raw.bnfpo) : text(raw.ebelp);                                                                                                                                       
            r.dateText = dateText(kind === "movement" ? raw.budat : kind === "request" ? raw.rdate : raw.bedat);                                                                                                                                               
            r.dueText = dateText(raw.eindt || raw.ndate);                                                                                                                                                                                                      
            r.statusText = raw.dashstatus || "";                                                                                                                                                                                                               
            r.statusState = statusState(r.statusText);                                                                                                                                                                                                         
            r.done = kind === "request" && raw.dashstatus === "재고전환완료" ? "true" : "false";                                                                                                                                                                     
            if (kind === "stock") {                                                                                                                                                                                                                            
                r.statusText = num(raw.stqty) > 0 ? "가용재고 보유" : "가용재고 없음";                                                                                                                                                                                     
                r.statusState = num(raw.stqty) > 0 ? "Success" : "Warning";                                                                                                                                                                                    
            }                                                                                                                                                                                                                                                  
            if (kind === "shortage") { r.statusText = "안전재고 미달"; r.statusState = "Error"; }                                                                                                                                                                    
            if (kind === "movement") {                                                                                                                                                                                                                         
                r.statusText = movementText(raw.bwart);                                                                                                                                                                                                        
                r.statusState = raw.bwart === "101" ? "Success" : raw.bwart === "321" || raw.bwart === "654" ? "Information" : "Warning";                                                                                                                      
            }                                                                                                                                                                                                                                                  
            if (kind === "purchase") {                                                                                                                                                                                                                         
                r.statusText = num(raw.grqty) <= 0 ? "입고대기" : num(raw.openqty) > 0 ? "일부입고" : "입고수량 충족";                                                                                                                                                       
                r.statusState = num(raw.openqty) > 0 ? "Warning" : "Success";                                                                                                                                                                                  
                r.priceText = money(raw.netpr, raw.waers);                                                                                                                                                                                                     
                r.amountText = money(raw.poamount, raw.waers);                                                                                                                                                                                                 
                r.amountNumber = raw.waers ? r.amountText.slice(0, -(raw.waers.length + 1)) : r.amountText;                                                                                                                                                    
            }                                                                                                                                                                                                                                                  
            return r;                                                                                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _card: function (action, color, label, valueHtml, note) {                                                                                                                                                                                              
            var report = this.getView().getModel("ui").getProperty("/report");                                                                                                                                                                                 
            var active = action === report || action === "stock" && report === "overview";                                                                                                                                                                     
            return '<button type="button" class="mmKpi mmTone' + color + (active ? ' mmSelected' : '') + '" data-action="card" data-value="' + esc(action) + '">'                                                                                              
                + '<span class="mmKpiLabel">' + esc(label) + '</span><strong class="mmKpiValue">' + valueHtml + '</strong>'                                                                                                                                    
                + '<span class="mmKpiNote">' + esc(note) + '</span></button>';                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
        _summaryHtml: function (data) {                                                                                                                                                                                                                        
            var count = function (name, value, unit) {                                                                                                                                                                                                         
                var error = this._errors[name];                                                                                                                                                                                                                
                return error ? '<span class="mmMetricUnavailable" title="' + esc(error) + '">' + (/한도/.test(error) ? "조회 범위 초과" : "조회 실패") + '</span>'                                                                                                         
                    : Number(value).toLocaleString("ko-KR") + (unit || "");                                                                                                                                                                                    
            }.bind(this);                                                                                                                                                                                                                                      
            var receipts = data.Movement.filter(function (r) { return r.bwart === "101"; });                                                                                                                                                                   
            var plant = (this._viewSelection || this._selection || {}).plant;                                                                                                                                                                                  
            var plantLabel = plant ? (this._plantNames.get(plant) || plant) + " (" + plant + ")" : "전체 플랜트";                                                                                                                                                   
            var issues = data.Movement.filter(function (r) { return r.bwart === "601" || r.bwart === "655"; });                                                                                                                                                
            var open = data.PurchaseOrder.filter(function (r) { return num(r.openqty) > 0; });                                                                                                                                                                 
            var currencies = new Map();                                                                                                                                                                                                                        
            var missingAmounts = 0;                                                                                                                                                                                                                            
            data.PurchaseOrder.forEach(function (r) {                                                                                                                                                                                                          
                var code = String(r.waers || "").trim().toUpperCase();                                                                                                                                                                                         
                if (r.poamount == null || r.poamount === "") { missingAmounts++; return; }                                                                                                                                                                     
                // 통화 없는 0원 초기값을 별도 통화처럼 표시하지 않는다. 비영 금액은 보존한다.                                                                                                                                                                                                
                var parsed;                                                                                                                                                                                                                                    
                try { parsed = decimal(r.poamount); } catch (e) { missingAmounts++; return; }                                                                                                                                                                  
                if (!code && parsed.value === 0n) { return; }                                                                                                                                                                                                  
                if (!currencies.has(code)) { currencies.set(code, []); }                                                                                                                                                                                       
                currencies.get(code).push(r.poamount);                                                                                                                                                                                                         
            });                                                                                                                                                                                                                                                
            var amountHtml = this._errors.PurchaseOrder ? count("PurchaseOrder", 0) : currencies.size ? Array.from(currencies).sort().map(function (entry) {                                                                                                   
                var value = sumDecimals(entry[1]);                                                                                                                                                                                                             
                var parts = value.split(".");                                                                                                                                                                                                                  
                parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");                                                                                                                                                                                     
                var formatted = entry[0] ? money(value, entry[0]) : parts.join(".");                                                                                                                                                                           
                var number = entry[0] ? formatted.slice(0, -(entry[0].length + 1)) : formatted;                                                                                                                                                                
                return '<span class="mmMoneyLine" title="' + esc(formatted + (entry[0] ? "" : " · 통화 미등록")) + '"><span class="mmAmountNumber">' + esc(number) + '</span><small class="mmCurrency">' + esc(entry[0] || "통화 미등록") + '</small></span>';           
            }).join("") : "0";                                                                                                                                                                                                                                 
            if (missingAmounts && !this._errors.PurchaseOrder) { amountHtml += '<small class="mmMoneyWarning">금액 미등록 ' + missingAmounts + '건 별도 확인</small>'; }                                                                                                 
            var html = '<div class="mmDashboard"><div class="mmSummaryScope">' + esc(plantLabel) + ' · 요약 현황</div><div class="mmKpis">'                                                                                                                        
                + this._card("stock", "N", "재고 품목", count("Stock", distinct(data.Stock, ["matnr"])), "자재번호 중복 제외 · 현재")                                                                                                                                        
                + this._card("purchase", "B", "발주금액", amountHtml, "PO 생성일 기준 · 통화별 합계")                                                                                                                                                                        
                + this._card("receipt", "G", "입고 문서", count("Movement", distinct(receipts, ["mblnr", "mjahr"]), "건"), "101 · 문서번호+연도 기준")                                                                                                                      
                + this._card("issue", "B", "출고 문서", count("Movement", distinct(issues, ["mblnr", "mjahr"]), "건"), "601·655 · 문서 중복 제외")                                                                                                                        
                + this._card("open", "Y", "미입고 PO 품목", count("PurchaseOrder", open.length, "건"), "발주분 미입고량 > 0")                                                                                                                                               
                + this._card("shortage", "R", "안전재고 미달", count("Shortage", data.Shortage.length, "건"), (plant ? "선택 플랜트 전체 창고" : "전체 플랜트") + " 기준 · 현재") + '</div>';                                                                                           
            html += '<div class="mmCharts">' + this._ring(data.PurchaseRequest) + this._movementBars(data.Movement) + this._shortageBars(data.Shortage) + '</div></div>';                                                                                      
            return html;                                                                                                                                                                                                                                       
        },                                                                                                                                                                                                                                                     
        _ring: function (rows) {                                                                                                                                                                                                                               
            var groups = STAGES.map(function (stage) { return Object.assign({}, stage, { count: rows.filter(function (r) { return r.dashstatus === stage.text; }).length }); });                                                                               
            var total = groups.reduce(function (n, stage) { return n + stage.count; }, 0);                                                                                                                                                                     
            var angle = 0;                                                                                                                                                                                                                                     
            var parts = [];                                                                                                                                                                                                                                    
            groups.forEach(function (stage) {                                                                                                                                                                                                                  
                if (stage.count) { var end = angle + stage.count / total * 360; parts.push(COLOR[stage.color].line + " " + angle + "deg " + end + "deg"); angle = end; }                                                                                       
            });                                                                                                                                                                                                                                                
            var failed = !!this._errors.PurchaseRequest;                                                                                                                                                                                                       
            var legend = failed ? '<p class="mmUnavailable">구매요청 조회 실패</p>' : groups.map(function (stage) {                                                                                                                                                    
                return '<button type="button" class="mmLegendRow" data-action="stage" data-value="' + esc(stage.text) + '"><i style="background:' + COLOR[stage.color].line + '"></i><span>' + esc(stage.text) + '</span><b>' + stage.count + '</b><small>' + +
(total ? Math.round(stage.count / total * 100) : 0) + '%</small></button>';                                                                                                                                                                                    
            }).join("");                                                                                                                                                                                                                                       
            return '<section class="mmChart"><h2>구매 · 입고 진행 건수</h2><div class="mmRingLayout"><div class="mmRing" role="img" aria-label="진행 중 PR 품목 ' + total + '건" style="background:'                                                                         
                + (parts.length ? "conic-gradient(" + parts.join(",") + ")" : COLOR.N.bg) + '"><div><strong>' + (failed ? "—" : total + "건") + '</strong><small>PR 품목 기준</small></div></div><div class="mmLegend">' + legend                                   
                + '</div></div><p class="mmChartFoot">' + (failed ? "오류 상세를 확인해 주세요." : "승인 전·취소 등 " + (rows.length - total) + "건 제외 · 범례를 누르면 목록 조회") + '</p></section>';                                                                                     
        },                                                                                                                                                                                                                                                     
        _movementBars: function (rows) {                                                                                                                                                                                                                       
            var end = new Date(this._period.to + "T00:00:00");                                                                                                                                                                                                 
            var days = [];                                                                                                                                                                                                                                     
            for (var i = 6; i >= 0; i--) { var d = new Date(end); d.setDate(d.getDate() - i); if (day(d) >= this._period.from) { days.push(day(d)); } }                                                                                                        
            var points = days.map(function (date) {                                                                                                                                                                                                            
                var daily = rows.filter(function (r) { return String(r.budat).replace(/-/g, "").slice(0, 8) === date.replace(/-/g, ""); });                                                                                                                    
                return { date: date, receipt: distinct(daily.filter(function (r) { return r.bwart === "101"; }), ["mblnr", "mjahr"]), issue: distinct(daily.filter(function (r) { return r.bwart === "601" || r.bwart === "655"; }), ["mblnr", "mjahr"]) };    
            });                                                                                                                                                                                                                                                
            var max = Math.max.apply(null, [1].concat(points.map(function (p) { return Math.max(p.receipt, p.issue); })));                                                                                                                                     
            var html = this._errors.Movement ? '<p class="mmUnavailable">자재이동 조회 실패</p>' : points.map(function (p) {                                                                                                                                           
                return '<div class="mmDayColumn" role="img" aria-label="' + esc(p.date) + ' 입고 ' + p.receipt + '건, 출고 ' + p.issue + '건">'                                                                                                                      
                    + '<div class="mmVerticalPair"><div class="mmVerticalTrack"><div class="mmVerticalBar mmGreen" style="height:' + p.receipt / max * 100 + '%"><span>' + p.receipt + '</span></div></div>'                                                   
                    + '<div class="mmVerticalTrack"><div class="mmVerticalBar mmBlue" style="height:' + p.issue / max * 100 + '%"><span>' + p.issue + '</span></div></div></div>'                                                                              
                    + '<span class="mmDayLabel">' + esc(p.date.slice(5).replace("-", ".")) + '</span></div>';                                                                                                                                                  
            }).join("");                                                                                                                                                                                                                                       
            return '<section class="mmChart"><h2>기간 종료일 기준 최근 7일 입출고</h2><div class="mmMiniLegend"><span><i class="mmGreen"></i>입고</span><span><i class="mmBlue"></i>출고</span></div><div class="mmDayBars">' + html + '</div><p class="mmChartFoot">101 입고 · 6+
01/655 출고 · 내부 전환 제외</p></section>';                                                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
        _shortageBars: function (rows) {                                                                                                                                                                                                                       
            var map = new Map();                                                                                                                                                                                                                               
            var selectedPlant = (this._viewSelection || this._selection || {}).plant;                                                                                                                                                                          
            this._plantNames.forEach(function (name, plant) { if (!selectedPlant || plant === selectedPlant) { map.set(plant, 0); } }, this);                                                                                                                  
            rows.forEach(function (r) { map.set(r.werks, (map.get(r.werks) || 0) + 1); });                                                                                                                                                                     
            var list = Array.from(map).sort(function (a, b) { return b[1] - a[1] || String(a[0]).localeCompare(String(b[0])); });                                                                                                                              
            var max = Math.max.apply(null, [1].concat(list.map(function (p) { return p[1]; })));                                                                                                                                                               
            var html = this._errors.Shortage ? '<p class="mmUnavailable">안전재고 조회 실패</p>' : list.map(function (p) {                                                                                                                                             
                return '<button type="button" class="mmHbarRow" data-action="plant-shortage" data-value="' + esc(p[0]) + '"><span title="' + esc(p[0]) + '">' + esc(this._plantNames.get(p[0]) || p[0]) + '</span><div class="mmTrack"><i style="width:' + p[1+
] / max * 100 + '%;background:' + COLOR.R.line + '"></i></div><b>' + p[1] + '건</b></button>';                                                                                                                                                                  
            }, this).join("");                                                                                                                                                                                                                                 
            return '<section class="mmChart"><h2>플랜트별 안전재고 미달 품목</h2><div class="mmPlantBars">' + html + '</div><p class="mmChartFoot">플랜트 전체 가용재고 기준 · 창고 필터 미적용</p></section>';                                                                              
        },                                                                                                                                                                                                                                                     
        _plantsHtml: function (rows) {                                                                                                                                                                                                                         
            if (this._errors.Stock) { return '<div class="mmEmpty">현재 재고 조회에 실패했습니다.</div>'; }                                                                                                                                                                 
            var plants = new Map();                                                                                                                                                                                                                            
            rows.forEach(function (r) {                                                                                                                                                                                                                        
                if (!plants.has(r.werks)) { plants.set(r.werks, new Map()); }                                                                                                                                                                                  
                var warehouses = plants.get(r.werks);                                                                                                                                                                                                          
                if (!warehouses.has(r.lgort)) { warehouses.set(r.lgort, []); }                                                                                                                                                                                 
                warehouses.get(r.lgort).push(r);                                                                                                                                                                                                               
            });                                                                                                                                                                                                                                                
            if (!rows.length) { return '<div class="mmEmpty">선택한 범위에 재고 품목 기록이 없습니다.</div>'; }                                                                                                                                                                 
            return '<div class="mmPlantGroups">' + Array.from(plants).sort().map(function (plant) {                                                                                                                                                            
                var whHtml = Array.from(plant[1]).sort().map(function (warehouse) {                                                                                                                                                                            
                    var items = warehouse[1];                                                                                                                                                                                                                  
                    var wh = this._storageRows.get(plant[0] + "|" + warehouse[0]);                                                                                                                                                                             
                    var name = wh && wh.lgobe || items[0].lgobe || "명칭 미등록";                                                                                                                                                                                   
                    var available = distinct(items.filter(function (r) { return num(r.stqty) > 0; }), ["matnr"]);                                                                                                                                              
                    var inspection = distinct(items.filter(function (r) { return num(r.qisty) > 0; }), ["matnr"]);                                                                                                                                             
                    return '<button type="button" class="mmWarehouse" data-action="warehouse" data-value="' + esc(plant[0] + "|" + warehouse[0]) + '"><span class="mmWarehouseTitle">' + esc(name) + '<small>' + esc(warehouse[0]) + '</small></span><span cla+
ss="mmWarehouseStats"><span><b>' + distinct(items, ["matnr"]) + '</b>등록 품목</span><span><b>' + available + '</b>가용재고 품목</span><span><b>' + inspection + '</b>검사재고 품목</span></span><span class="mmWarehouseLink">소속 품목 보기 →</span></button>';                    
                }, this).join("");                                                                                                                                                                                                                             
                return '<section class="mmPlantGroup"><h3>' + esc(this._plantNames.get(plant[0]) || plant[0]) + '<small>' + esc(plant[0]) + '</small></h3><div class="mmWarehouses">' + whHtml + '</div></section>';                                           
            }, this).join("") + '</div>';                                                                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onAfterRendering: function () {                                                                                                                                                                                                                        
            // 생성된 Basic 앱의 Shell 너비 제한을 해제한다.                                                                                                                                                                                                                 
            for (var parent = this.getView().getParent(); parent; parent = parent.getParent()) {                                                                                                                                                               
                if (parent.isA && parent.isA("sap.m.Shell") && parent.getAppWidthLimited()) { parent.setAppWidthLimited(false); }                                                                                                                              
            }                                                                                                                                                                                                                                                  
            // HTML 내용 갱신 후에도 유지되는 View 루트에서 클릭을 처리한다.                                                                                                                                                                                                         
            var root = this.getView().getDomRef();                                                                                                                                                                                                             
            if (!root) { return; }                                                                                                                                                                                                                             
            root.onclick = function (e) {                                                                                                                                                                                                                      
                var button = e.target.closest("button[data-action]");                                                                                                                                                                                          
                if (button && root.contains(button)) { this._htmlAction(button.dataset.action, button.dataset.value); }                                                                                                                                        
            }.bind(this);                                                                                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
        _htmlAction: function (action, value) {                                                                                                                                                                                                                
            var ui = this.getView().getModel("ui");                                                                                                                                                                                                            
            ui.setProperty("/query", ""); ui.setProperty("/openOnly", false); ui.setProperty("/requestStatus", "");                                                                                                                                            
            if (action === "warehouse") {                                                                                                                                                                                                                      
                ui.setProperty("/plant", value.split("|")[0]); ui.setProperty("/storage", value.split("|")[1]); ui.setProperty("/report", "stock");                                                                                                            
            } else if (action === "plant-shortage") {                                                                                                                                                                                                          
                ui.setProperty("/plant", value); ui.setProperty("/storage", ""); ui.setProperty("/report", "shortage");                                                                                                                                        
            } else if (action === "stage") {                                                                                                                                                                                                                   
                ui.setProperty("/requestStatus", value); ui.setProperty("/report", "request");                                                                                                                                                                 
            } else if (action === "card") {                                                                                                                                                                                                                    
                if (value === "receipt" || value === "issue") {                                                                                                                                                                                                
                    ui.setProperty("/movementType", value === "receipt" ? "101" : "GI"); ui.setProperty("/report", "movement");                                                                                                                                
                } else if (value === "open") { ui.setProperty("/report", "purchase"); ui.setProperty("/openOnly", true); }                                                                                                                                     
                else { ui.setProperty("/report", value); }                                                                                                                                                                                                     
            }                                                                                                                                                                                                                                                  
            if (action === "warehouse" || action === "plant-shortage") { this._setPlantScope(); }                                                                                                                                                              
            else { this._clearDocuments(); }                                                                                                                                                                                                                   
            this._apply();                                                                                                                                                                                                                                     
            var toolbar = this.byId("reportToolbar").getDomRef();                                                                                                                                                                                              
            if (toolbar) { toolbar.scrollIntoView({ behavior: "smooth", block: "start" }); }                                                                                                                                                                   
        },                                                                                                                                                                                                                                                     
        onRowPress: async function (event) {                                                                                                                                                                                                                   
            var row = event.getSource().getBindingContext("ui").getObject();                                                                                                                                                                                   
            var ui = this.getView().getModel("ui"), binding;                                                                                                                                                                                                   
            if (ui.getProperty("/busy")) { return; }                                                                                                                                                                                                           
            var linked = { rows: [], total: 0, note: "연결 자료는 문서 조회에서 조건을 지정해 확인할 수 있습니다." };                                                                                                                                                                   
            // 원문은 요약을 여는 시점이 아니라 사용자가 행을 선택할 때만 최대 50건 조회한다.                                                                                                                                                                                                  
            if (row.kind !== "request") {                                                                                                                                                                                                                      
                try {                                                                                                                                                                                                                                          
                    ui.setProperty("/busy", true);                                                                                                                                                                                                             
                    var base = this._documents && this._documents.report === row.kind ? this._documents.selection : this._selection;                                                                                                                           
                    var selection = Object.assign({}, base, { plant: row.werks, storage: row.lgort || "", materialFrom: row.matnr, materialTo: "" });                                                                                                          
                    var options = row.ebeln ? { purchaseOrder: row.ebeln, purchaseItem: row.ebelp }                                                                                                                                                            
                        : row.kind === "movement" ? { documentFrom: row.mblnr } : {};                                                                                                                                                                          
                    binding = await this._createBinding("Movement", selection, options);                                                                                                                                                                       
                    var contexts = await binding.requestContexts(0, 50);                                                                                                                                                                                       
                    linked.rows = contexts.map(function (c) { return lowerRow(c.getObject()); });                                                                                                                                                              
                    linked.total = binding.isLengthFinal() ? binding.getLength() : linked.rows.length;                                                                                                                                                         
                    linked.note = "선택 문서의 조회 기간·플랜트·창고·자재 기준 · 연결 " + linked.total + "건 중 " + linked.rows.length + "건 표시 · 누적 실적과 다를 수 있습니다.";                                                                                                                 
                } catch (e) { linked.note = "연결 자재이동 조회 실패: " + (e.message || e); }                                                                                                                                                                            
                finally { if (binding) { this._releaseBinding(binding); } ui.setProperty("/busy", false); }                                                                                                                                                    
            }                                                                                                                                                                                                                                                  
            this._showDetail(row, linked);                                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
        _showDetail: function (row, linked) {                                                                                                                                                                                                                  
            if (this._dialog) { this._dialog.destroy(); this._dialog = null; }                                                                                                                                                                                 
            var isMaterial = row.kind === "stock" || row.kind === "shortage";                                                                                                                                                                                  
            var title = isMaterial ? row.matnr + " · " + row.materialText : row.documentText + " / " + row.itemText;                                                                                                                                           
            var fields = [["자재", row.matnr + " · " + row.materialText], ["플랜트", row.plantText + " (" + row.werks + ")"]];                                                                                                                                      
            if (row.lgort) { fields.push(["창고", row.storageText + " (" + row.lgort + ")"]); }                                                                                                                                                                  
            if (row.kind === "purchase") {                                                                                                                                                                                                                     
                fields = fields.concat([["공급업체", row.lifnr], ["발주일", row.dateText], ["납품예정일", row.dueText], ["단가", row.priceText], ["발주금액", row.amountText], ["구매요청", text(row.banfn) + " / " + text(row.bnfpo)]]);                                            
            } else if (row.kind === "request") {                                                                                                                                                                                                               
                fields = fields.concat([["요청일", row.dateText], ["필요일", row.dueText], ["승인상태", row.astattext || row.astat], ["원본 진행상태", row.pstattext || row.pstat]]);                                                                                          
            } else if (row.kind === "movement") {                                                                                                                                                                                                              
                fields = fields.concat([["전기일", row.dateText], ["이동유형", row.statusText], ["수량", row.mengeText + " " + row.unitText], ["구매오더", text(row.ebeln) + " / " + text(row.ebelp)]]);                                                                    
            }                                                                                                                                                                                                                                                  
            var html = '<div class="mmDetail"><div class="mmDetailStatus mmTone' + (row.statusState === "Error" ? "R" : row.statusState === "Success" ? "G" : "B") + '">' + esc(row.statusText) + '</div><dl class="mmDetailFields">'                          
                + fields.map(function (f) { return '<div><dt>' + esc(f[0]) + '</dt><dd>' + esc(text(f[1])) + '</dd></div>'; }).join("") + '</dl>';                                                                                                             
            if (row.kind === "purchase" || row.kind === "request") {                                                                                                                                                                                           
                html += '<div class="mmFlow">' + [                                                                                                                                                                                                             
                    [row.kind === "request" ? "요청" : "주문", row.kind === "request" ? row.rqtyText : row.mengeText],                                                                                                                                             
                    ["101 입고", row.grqtyText], ["합격 / 불량", row.passqtyText + " / " + row.failqtyText], ["321·654 전환", row.releasedqtyText]                                                                                                                     
                ].map(function (step) { return '<div><span>' + esc(step[0]) + '</span><b>' + esc(step[1]) + '</b><small>' + esc(row.unitText) + '</small></div>'; }).join("") + '</div>';                                                                      
            }                                                                                                                                                                                                                                                  
            if (isMaterial) {                                                                                                                                                                                                                                  
                var stocks = (this._data.Stock || []).filter(function (r) { return r.werks === row.werks && r.matnr === row.matnr; });                                                                                                                         
                html += '<h3>플랜트 내 창고별 현재재고</h3>' + this._detailTable(stocks, [["창고", "lgort"], ["가용", "stqty"], ["예약", "rsqty"], ["검사", "qisty"], ["단위", "meins"]]);                                                                                          
                if (row.kind === "shortage") { html += '<p>안전재고 ' + esc(row.safetyqtyText) + ' · 부족수량 ' + esc(row.shortqtyText) + ' ' + esc(row.unitText) + ' · 부족률 ' + esc(row.shortpctText) + '%</p>'; }                                                     
            }                                                                                                                                                                                                                                                  
            var movements = (linked ? linked.rows : this._documents && this._documents.name === "Movement" ? this._documents.rows : []).filter(function (r) {                                                                                                  
                if (row.kind === "purchase") { return r.ebeln === row.ebeln && r.ebelp === row.ebelp; }                                                                                                                                                        
                if (row.kind === "request") {                                                                                                                                                                                                                  
                    return (this._data.PurchaseOrder || []).some(function (p) { return p.banfn === row.banfn && p.bnfpo === row.bnfpo && p.matnr === row.matnr && p.ebeln === r.ebeln && p.ebelp === r.ebelp; });                                              
                }                                                                                                                                                                                                                                              
                if (row.kind === "movement" && !row.ebeln) { return r.mblnr === row.mblnr && r.mjahr === row.mjahr; }                                                                                                                                          
                return r.werks === row.werks && r.matnr === row.matnr && (isMaterial ? !row.lgort || r.lgort === row.lgort : r.ebeln === row.ebeln && r.ebelp === row.ebelp && !!row.ebeln);                                                                   
            }, this);                                                                                                                                                                                                                                          
            html += '<h3>선택 기간 내 연결 자재이동</h3>' + this._detailTable(movements, [["문서번호", "mblnr"], ["연도", "mjahr"], ["품목", "zeile"], ["이동유형", "bwart"], ["전기일", "budat"], ["수량", "menge"], ["단위", "meins"]])                                                    
                + '<p class="mmDetailNote">' + esc(linked ? linked.note : "연결 목록은 현재 조회한 문서 페이지의 자료입니다. 누적 실적과 다를 수 있습니다.") + '</p></div>';                                                                                                                    
            var dialog = new Dialog(this.createId("detailDialog"), {                                                                                                                                                                                           
                title: title, contentWidth: "64rem", contentHeight: "36rem", resizable: true, draggable: true,                                                                                                                                                 
                content: [new HTML(this.createId("detailHtml"), { content: html, sanitizeContent: false })],                                                                                                                                                   
                endButton: new Button(this.createId("detailClose"), { text: "닫기", press: function () { dialog.close(); } }),                                                                                                                                   
                afterClose: function () { dialog.destroy(); if (this._dialog === dialog) { this._dialog = null; } }.bind(this)                                                                                                                                 
            });                                                                                                                                                                                                                                                
            dialog.addStyleClass("mmDetailDialog sapUiSizeCompact");                                                                                                                                                                                           
            this.getView().addDependent(dialog); this._dialog = dialog; dialog.open();                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
        _detailTable: function (rows, columns) {                                                                                                                                                                                                               
            if (!rows.length) { return '<p class="mmEmpty">현재 조회 범위에 연결 자료가 없습니다.</p>'; }                                                                                                                                                                      
            return '<div class="mmDetailTableWrap"><table class="mmDetailTable"><thead><tr>' + columns.map(function (c) { return '<th>' + esc(c[0]) + '</th>'; }).join("") + '</tr></thead><tbody>'                                                            
                + rows.map(function (r) { return '<tr>' + columns.map(function (c) {                                                                                                                                                                           
                    var value = ["stqty", "rsqty", "qisty", "menge"].includes(c[1]) ? this._quantity.format(num(r[c[1]])) : c[1] === "budat" ? dateText(r[c[1]]) : c[1] === "bwart" ? movementText(r[c[1]]) : text(r[c[1]]);                                   
                    return '<td>' + esc(value) + '</td>';                                                                                                                                                                                                      
                }, this).join("") + '</tr>'; }, this).join("") + '</tbody></table></div>';                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
        onShowErrors: function () {                                                                                                                                                                                                                            
            MessageBox.error(Object.keys(this._errors).map(function (name) { return ENTITY[name].label + " (" + name + ")\n" + this._errors[name]; }, this).join("\n\n"));                                                                                     
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               