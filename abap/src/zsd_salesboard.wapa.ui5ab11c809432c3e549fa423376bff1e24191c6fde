    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "sap/m/MessageBox",                                                                                                                                                                                                                                        
    "sap/ui/model/odata/v2/ODataModel",                                                                                                                                                                                                                        
    "sap/m/Dialog",                                                                                                                                                                                                                                            
    "sap/m/Button",                                                                                                                                                                                                                                            
    "sap/ui/core/HTML"                                                                                                                                                                                                                                         
], function (Controller, JSONModel, Filter, FilterOperator, Sorter, DateFormat, NumberFormat, MessageToast, MessageBox, ODataModel,                                                                                                                            
             Dialog, Button, HTML) {                                                                                                                                                                                                                           
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    // ZCL_CM_KPI_HTML 과 같은 색 (R 빨강 / Y 노랑 / G 초록 / B 파랑 / N 회색)                                                                                                                                                                                               
    var COLOR = { R: "#ee7d7d", Y: "#eab94d", G: "#5fb98f", B: "#6f9bec", N: "#a3abbd" };                                                                                                                                                                      
                                                                                                                                                                                                                                                               
    var STAGES = [                                                                                                                                                                                                                                             
        { key: "SO", label: "SO 수주",     color: "B", state: "Indication05" },                                                                                                                                                                                  
        { key: "DO", label: "DO 출고문서", color: "Y", state: "Indication03" },                                                                                                                                                                                    
        { key: "GI", label: "GI 출고처리", color: "R", state: "Indication02" },                                                                                                                                                                                    
        { key: "BI", label: "BI 청구",     color: "G", state: "Indication04" }                                                                                                                                                                                   
    ];                                                                                                                                                                                                                                                         
    var DUES = [                                                                                                                                                                                                                                               
        { key: "지연", color: "R", state: "Error",   icon: "sap-icon://error" },                                                                                                                                                                                 
        { key: "임박", color: "Y", state: "Warning", icon: "sap-icon://alert" },                                                                                                                                                                                 
        { key: "정상", color: "G", state: "Success", icon: "sap-icon://sys-enter-2" },                                                                                                                                                                           
        { key: "완료", color: "B", state: "None",    icon: "" },                                                                                                                                                                                                 
        { key: "미정", color: "N", state: "None",    icon: "" }                                                                                                                                                                                                  
    ];                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    var CSS =                                                                                                                                                                                                                                                  
        ".kd{font-family:'Malgun Gothic','72',Arial,sans-serif;color:#3b4358;background:#f6f7fb;padding:12px 16px 4px}" +                                                                                                                                      
        ".kd-t{font-size:14px;font-weight:bold;color:#2c3347;margin-bottom:10px}" +                                                                                                                                                                            
        ".kd-row{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:10px}" +                                                                                                                                                                                   
        ".kd-card{flex:1 1 150px;min-width:150px;padding:10px 16px;background:#eef0f4;border-radius:14px;cursor:pointer;border:2px solid transparent;box-sizing:border-box}" +                                                                                 
        ".kd-card:hover{filter:brightness(.97)}.kd-card.on{border-color:#3b4358}" +                                                                                                                                                                            
        ".kd-l{font-size:12px;color:#7a8296}.kd-v{font-size:24px;font-weight:bold;color:#3b4358}.kd-s{font-size:12px;color:#7a8296}" +                                                                                                                         
        ".cR{background:#fdeaea}.cR .kd-v{color:#cf5555}.cY{background:#fdf3dc}.cY .kd-v{color:#b8860b}" +                                                                                                                                                     
        ".cG{background:#e6f6ee}.cG .kd-v{color:#2a8a60}.cB{background:#e8f0fd}.cB .kd-v{color:#3563c9}" +                                                                                                                                                     
        ".kd-w{flex:1 1 280px;min-width:280px;height:210px;box-sizing:border-box;padding:10px 16px;background:#fff;border-radius:14px;box-shadow:0 1px 3px rgba(60,70,100,.1);overflow:hidden}" +                                                              
        ".kd-wt{font-size:12px;font-weight:bold;color:#7a8296;margin-bottom:8px}" +                                                                                                                                                                            
        ".kd-ring{display:flex;align-items:center;gap:16px}" +                                                                                                                                                                                                 
        ".kd-lg div{margin:4px 0;white-space:nowrap;font-size:12px}" +                                                                                                                                                                                         
        ".kd-sq{display:inline-block;width:9px;height:9px;margin-right:6px;border-radius:3px}" +                                                                                                                                                               
        ".kd-hr{display:flex;align-items:center;margin:9px 0;font-size:12px}" +                                                                                                                                                                                
        ".kd-hl{width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}" +                                                                                                                                                                      
        ".kd-ht{flex:1;height:10px;background:#eceff5;border-radius:10px;overflow:hidden}" +                                                                                                                                                                   
        ".kd-hf{display:block;height:10px;border-radius:10px}" +                                                                                                                                                                                               
        ".kd-hv{width:64px;text-align:right;font-weight:bold}" +                                                                                                                                                                                               
        ".kd-cols{display:flex;align-items:flex-end;gap:6px;height:150px;overflow-x:auto}" +                                                                                                                                                                   
        ".kd-cc{min-width:32px;text-align:center}" +                                                                                                                                                                                                           
        ".kd-cv{font-size:10px}.kd-cb{margin:2px auto;width:18px;border-radius:8px 8px 3px 3px}.kd-cx{font-size:10px;color:#7a8296}" +                                                                                                                         
        ".kd-f{font-size:11px;color:#7a8296;margin:2px 0 6px}.kd-nd{color:#98a2b3}" +                                                                                                                                                                          
        "tr[data-done='Y'] .sapMText,tr[data-done='Y'] .sapMObjectNumber *{text-decoration:line-through;color:#98a2b3 !important}" +                                                                                                                           
        // 바로 처리할 행 강조 : R = 납기 지남, Y = 3일 이내 또는 청구 대기                                                                                                                                                                                                         
        "tr[data-act='R'] td{background:#fff3f3 !important}tr[data-act='R'] td:first-child{box-shadow:inset 4px 0 0 #ee7d7d}" +                                                                                                                                
        "tr[data-act='Y'] td{background:#fffaeb !important}tr[data-act='Y'] td:first-child{box-shadow:inset 4px 0 0 #eab94d}";                                                                                                                                 
                                                                                                                                                                                                                                                               
    function esc(s) {                                                                                                                                                                                                                                          
        return String(s === undefined || s === null ? "" : s)                                                                                                                                                                                                  
            .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");                                                                                                                                                       
    }                                                                                                                                                                                                                                                          
    function fmt1(n) {                                                                                                                                                                                                                                         
        return NumberFormat.getFloatInstance({ maxFractionDigits: 1, groupingEnabled: true }).format(n);                                                                                                                                                       
    }                                                                                                                                                                                                                                                          
    function utcDay(d) {                                                                                                                                                                                                                                       
        return new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));                                                                                                                                                                                 
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    return Controller.extend("zsd.salesboard.controller.Main", {                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
        onInit: function () {                                                                                                                                                                                                                                  
            this._oDate = DateFormat.getDateInstance({ pattern: "yyyy.MM.dd", UTC: true });                                                                                                                                                                    
            this._stage = "";                                                                                                                                                                                                                                  
            this._query = "";                                                                                                                                                                                                                                  
            // ALP 에서 잘 동작한 분석용 서비스에 직접 연결 ($batch 없이 읽기)                                                                                                                                                                                                      
            this._oData = new ODataModel("/sap/opu/odata/sap/ZSD_DASH_ANA_SB/", { json: true, useBatch: false });                                                                                                                                              
            var now = new Date();                                                                                                                                                                                                                              
            this.getView().setModel(new JSONModel({                                                                                                                                                                                                            
                from: new Date(now.getFullYear(), now.getMonth(), 1),                                                                                                                                                                                          
                to: new Date(now.getFullYear(), now.getMonth() + 1, 0),                                                                                                                                                                                        
                rows: [],                                                                                                                                                                                                                                      
                html: "",                                                                                                                                                                                                                                      
                listTitle: "판매오더 목록"                                                                                                                                                                                                                           
            }), "dash");                                                                                                                                                                                                                                       
            this._load();                                                                                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ---------- 조건 ----------                                                                                                                                                                                                                            
        onQuick: function (oEvent) {                                                                                                                                                                                                                           
            var key = oEvent.getSource().data("key"),                                                                                                                                                                                                          
                now = new Date(), from, to;                                                                                                                                                                                                                    
            if (key === "LM") {                                                                                                                                                                                                                                
                from = new Date(now.getFullYear(), now.getMonth() - 1, 1);                                                                                                                                                                                     
                to = new Date(now.getFullYear(), now.getMonth(), 0);                                                                                                                                                                                           
            } else if (key === "TY") {                                                                                                                                                                                                                         
                from = new Date(now.getFullYear(), 0, 1);                                                                                                                                                                                                      
                to = new Date(now.getFullYear(), 11, 31);                                                                                                                                                                                                      
            } else {                                                                                                                                                                                                                                           
                from = new Date(now.getFullYear(), now.getMonth(), 1);                                                                                                                                                                                         
                to = new Date(now.getFullYear(), now.getMonth() + 1, 0);                                                                                                                                                                                       
            }                                                                                                                                                                                                                                                  
            var m = this.getView().getModel("dash");                                                                                                                                                                                                           
            m.setProperty("/from", from);                                                                                                                                                                                                                      
            m.setProperty("/to", to);                                                                                                                                                                                                                          
            this._load();                                                                                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onSearch: function () {                                                                                                                                                                                                                                
            this._load();                                                                                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ---------- 데이터 읽기 ----------                                                                                                                                                                                                                        
        _load: function () {                                                                                                                                                                                                                                   
            var oView = this.getView(),                                                                                                                                                                                                                        
                m = oView.getModel("dash"),                                                                                                                                                                                                                    
                from = m.getProperty("/from"),                                                                                                                                                                                                                 
                to = m.getProperty("/to") || from;                                                                                                                                                                                                             
            if (!from) {                                                                                                                                                                                                                                       
                MessageToast.show("주문일 기간을 골라 주세요");                                                                                                                                                                                                           
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
            oView.setBusy(true);                                                                                                                                                                                                                               
            this._oData.read("/ZV_SD_DASH_ANA", {                                                                                                                                                                                                              
                filters: [new Filter("OrderDate", FilterOperator.BT, utcDay(from), utcDay(to))],                                                                                                                                                               
                urlParameters: {                                                                                                                                                                                                                               
                    "$select": "SoNumber,OrderDate,Customer,CustomerName,SoStatus,DueStatus,TotalAmount,Currency,ActualGI,BillDate," +                                                                                                                         
                        "ReqDate,DoNumber,PlannedGI,BillNo,ShortItems,LeadDays"                                                                                                                                                                                
                },                                                                                                                                                                                                                                             
                success: function (oData) {                                                                                                                                                                                                                    
                    oView.setBusy(false);                                                                                                                                                                                                                      
                    // 기간 거르기는 브라우저에서 (서버의 날짜 조건 처리 오류 회피)                                                                                                                                                                                                     
                    var tFrom = utcDay(from).getTime(), tTo = utcDay(to).getTime();                                                                                                                                                                            
                    // 요청납기일·출하예정일은 문자(yyyyMMdd)로 받아서 날짜로 바꿈. 이상한 값은 빈 값 처리                                                                                                                                                                                    
                    var toDate = function (v) {                                                                                                                                                                                                                
                        var m = /^(\d{4})(\d{2})(\d{2})$/.exec(v || "");                                                                                                                                                                                       
                        if (!m || m[1] === "0000") { return null; }                                                                                                                                                                                            
                        var d = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));                                                                                                                                                                                   
                        return d.getUTCMonth() === +m[2] - 1 ? d : null;                                                                                                                                                                                       
                    };                                                                                                                                                                                                                                         
                    (oData.results || []).forEach(function (r) {                                                                                                                                                                                               
                        r.ReqDate = toDate(r.ReqDate);                                                                                                                                                                                                         
                        r.PlannedGI = toDate(r.PlannedGI);                                                                                                                                                                                                     
                    });                                                                                                                                                                                                                                        
                    var aRes = (oData.results || []).filter(function (r) {                                                                                                                                                                                     
                        var t = r.OrderDate ? r.OrderDate.getTime() : -1;                                                                                                                                                                                      
                        return t >= tFrom && t <= tTo;                                                                                                                                                                                                         
                    }).sort(function (a, b) {                                                                                                                                                                                                                  
                        return (b.OrderDate || 0) - (a.OrderDate || 0) || String(b.SoNumber).localeCompare(String(a.SoNumber));                                                                                                                                
                    });                                                                                                                                                                                                                                        
                    this._show(aRes, from, to);                                                                                                                                                                                                                
                }.bind(this),                                                                                                                                                                                                                                  
                error: function (oErr) {                                                                                                                                                                                                                       
                    oView.setBusy(false);                                                                                                                                                                                                                      
                    var sMsg = (oErr && (oErr.statusCode + " " + (oErr.responseText || oErr.message))) || "";                                                                                                                                                  
                    MessageBox.error("데이터를 읽지 못했어요.\n\n" + sMsg.substring(0, 600));                                                                                                                                                                            
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ---------- 주문 1건의 진행 상황 · 지연 사유 판단 ----------                                                                                                                                                                                                       
        _judge: function (r, stKey, today) {                                                                                                                                                                                                                   
            var D = 86400000, f = this._oShort,                                                                                                                                                                                                                
                req = r.ReqDate ? r.ReqDate.getTime() : null,                                                                                                                                                                                                  
                left = req !== null ? Math.round((req - today) / D) : null,                                                                                                                                                                                    
                dueTxt = left === null ? "요청납기일 없음" : (left < 0 ? "납기 " + (-left) + "일 지남" : "납기 D-" + left),                                                                                                                                                  
                o = { reason: "", state: "None", icon: "", main: "", sub: "" };                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            if (stKey === "BI") {                                                                                                                                                                                                                              
                o.main = "청구 완료"; o.state = "Success"; o.icon = "sap-icon://sys-enter-2";                                                                                                                                                                      
                o.sub = "청구 " + (r.BillNo || "") + (r.BillDate ? " · " + f.format(r.BillDate) : "");                                                                                                                                                           
                return o;                                                                                                                                                                                                                                      
            }                                                                                                                                                                                                                                                  
            if (stKey === "GI") {                                                                                                                                                                                                                              
                o.main = "청구 대기"; o.state = "Warning"; o.icon = "sap-icon://pending";                                                                                                                                                                          
                o.sub = "출고 " + (r.ActualGI ? f.format(r.ActualGI) : "") + " · 청구문서 생성 필요";                                                                                                                                                                    
                return o;                                                                                                                                                                                                                                      
            }                                                                                                                                                                                                                                                  
            if (stKey === "DO") {                                                                                                                                                                                                                              
                o.main = "출고처리 대기";                                                                                                                                                                                                                            
                o.sub = "출고문서 " + (r.DoNumber || "") + (r.PlannedGI ? " · 출하예정 " + f.format(r.PlannedGI) : "");                                                                                                                                                
                if (left !== null && left < 0) {                                                                                                                                                                                                               
                    o.reason = "출고처리 지연"; o.state = "Error"; o.icon = "sap-icon://error"; o.main = "출고처리 지연 · 출고처리 필요";                                                                                                                                        
                } else {                                                                                                                                                                                                                                       
                    o.state = left !== null && left <= 3 ? "Warning" : "Information"; o.icon = "sap-icon://shipping-status";                                                                                                                                   
                }                                                                                                                                                                                                                                              
                return o;                                                                                                                                                                                                                                      
            }                                                                                                                                                                                                                                                  
            // SO : 조달 여부로 나눔                                                                                                                                                                                                                                  
            if (r.ShortItems > 0) {                                                                                                                                                                                                                            
                var exp = r.LeadDays > 0 && r.OrderDate ? new Date(r.OrderDate.getTime() + r.LeadDays * D) : null;                                                                                                                                             
                o.main = "조달중" + (exp ? " · 입고예정 " + f.format(exp) : " · 입고예정 미정");                                                                                                                                                                            
                if (exp && exp.getTime() < today) {                                                                                                                                                                                                            
                    // 입고예정일이 지났는데 아직 부족 → 입고 지연                                                                                                                                                                                                               
                    o.reason = "조달 지연"; o.state = "Error"; o.icon = "sap-icon://error";                                                                                                                                                                        
                    o.main = "입고 지연 · 입고예정 " + f.format(exp) + " 지남";                                                                                                                                                                                          
                    o.sub = "품목 " + r.ShortItems + "개 아직 미입고 · MM 확인 필요";                                                                                                                                                                                      
                } else if ((exp && req !== null && exp.getTime() > req) || (left !== null && left < 0)) {                                                                                                                                                      
                    o.reason = "조달 지연"; o.state = "Error"; o.icon = "sap-icon://error";                                                                                                                                                                        
                    o.sub = "납기 내 조달 불가" + (req !== null ? " (요청 " + f.format(r.ReqDate) + ")" : "") + " · 품목 " + r.ShortItems + "개 부족";                                                                                                                       
                } else {                                                                                                                                                                                                                                       
                    o.state = "Warning"; o.icon = "sap-icon://lateness";                                                                                                                                                                                       
                    o.sub = "납기 내 조달 가능";                                                                                                                                                                                                                      
                }                                                                                                                                                                                                                                              
                return o;                                                                                                                                                                                                                                      
            }                                                                                                                                                                                                                                                  
            o.main = "재고확보 · 출고문서 생성 필요";                                                                                                                                                                                                                      
            if (left !== null && left < 0) {                                                                                                                                                                                                                   
                o.reason = "출고 지시 지연"; o.state = "Error"; o.icon = "sap-icon://error";                                                                                                                                                                         
                o.sub = "재고는 있으나 출고 지시 안 됨";                                                                                                                                                                                                                   
            } else {                                                                                                                                                                                                                                           
                o.state = left !== null && left <= 3 ? "Warning" : "Information"; o.icon = "sap-icon://inventory";                                                                                                                                             
                o.sub = "재고 배정 완료";                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
            return o;                                                                                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _show: function (aRaw, from, to) {                                                                                                                                                                                                                     
            var that = this,                                                                                                                                                                                                                                   
                fNum = NumberFormat.getFloatInstance({ groupingEnabled: true, maxFractionDigits: 0 }),                                                                                                                                                         
                now = new Date(), today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()),                                                                                                                                                          
                cnt = { SO: 0, DO: 0, GI: 0, BI: 0 },                                                                                                                                                                                                          
                ext = { short: 0, stock: 0 },                                                                                                                                                                                                                  
                why = { "조달 지연": 0, "출고 지시 지연": 0, "출고처리 지연": 0, over: 0, exp: 0 },                                                                                                                                                                            
                cust = {}, sum = 0;                                                                                                                                                                                                                            
            this._oShort = DateFormat.getDateInstance({ pattern: "MM.dd", UTC: true });                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            var aRows = aRaw.map(function (r) {                                                                                                                                                                                                                
                var st = STAGES.filter(function (s) { return s.key === r.SoStatus; })[0] || STAGES[0],                                                                                                                                                         
                    amt = parseFloat(r.TotalAmount) || 0,                                                                                                                                                                                                      
                    od = r.OrderDate,                                                                                                                                                                                                                          
                    j = that._judge(r, st.key, today),                                                                                                                                                                                                         
                    dd = { text: "", state: "None" };                                                                                                                                                                                                          
                // 영업이 지금 바로 할 수 있는 일 : 출고문서 생성(재고확보 SO) / 출고처리(DO) / 청구(GI)                                                                                                                                                                                   
                // 조달중 SO 는 MM 입고를 기다려야 해서 제외                                                                                                                                                                                                                  
                var canDo = (st.key === "SO" && !(r.ShortItems > 0)) || st.key === "DO" || st.key === "GI",                                                                                                                                                    
                    act = "N";                                                                                                                                                                                                                                 
                if (canDo) {                                                                                                                                                                                                                                   
                    var dl0 = r.ReqDate ? Math.round((r.ReqDate.getTime() - today) / 86400000) : null;                                                                                                                                                         
                    if (st.key !== "GI" && dl0 !== null && dl0 < 0) { act = "R"; }                                                                                                                                                                             
                    else if (st.key === "GI" || (dl0 !== null && dl0 <= 3)) { act = "Y"; }                                                                                                                                                                     
                }                                                                                                                                                                                                                                              
                if (r.ReqDate && (st.key === "SO" || st.key === "DO")) {                                                                                                                                                                                       
                    var dl = Math.round((r.ReqDate.getTime() - today) / 86400000);                                                                                                                                                                             
                    dd.text = dl > 0 ? "D-" + dl : (dl === 0 ? "D-day" : "D+" + (-dl) + " 지남");                                                                                                                                                                
                    dd.state = dl < 0 ? "Error" : (dl <= 3 ? "Warning" : "None");                                                                                                                                                                              
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                cnt[st.key]++;                                                                                                                                                                                                                                 
                if (st.key === "SO") { ext[r.ShortItems > 0 ? "short" : "stock"]++; }                                                                                                                                                                          
                if (j.reason) {                                                                                                                                                                                                                                
                    why[j.reason]++;                                                                                                                                                                                                                           
                    // 기한 초과 = 요청납기일이 이미 지남 / 지연 예상 = 아직 안 지났지만 입고예정이 납기보다 늦음                                                                                                                                                                                  
                    if (r.ReqDate && r.ReqDate.getTime() < today) { why.over++; } else { why.exp++; }                                                                                                                                                          
                }                                                                                                                                                                                                                                              
                sum += amt;                                                                                                                                                                                                                                    
                var cn = r.CustomerName || r.Customer;                                                                                                                                                                                                         
                cust[cn] = (cust[cn] || 0) + amt;                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                return Object.assign({}, r, {                                                                                                                                                                                                                  
                    done: st.key === "BI" ? "Y" : "N",                                                                                                                                                                                                         
                    act: act,                                                                                                                                                                                                                                  
                    stageText: st.label,                                                                                                                                                                                                                       
                    stageState: st.state,                                                                                                                                                                                                                      
                    progMain: j.main,                                                                                                                                                                                                                          
                    progSub: j.sub,                                                                                                                                                                                                                            
                    progState: j.state,                                                                                                                                                                                                                        
                    progIcon: j.icon,                                                                                                                                                                                                                          
                    reason: j.reason,                                                                                                                                                                                                                          
                    amountText: fNum.format(amt),                                                                                                                                                                                                              
                    orderDate: od ? that._oDate.format(od) : "",                                                                                                                                                                                               
                    reqDate: r.ReqDate ? that._oDate.format(r.ReqDate) : "",                                                                                                                                                                                   
                    actualGI: r.ActualGI ? that._oDate.format(r.ActualGI) : "",                                                                                                                                                                                
                    billDate: r.BillDate ? that._oDate.format(r.BillDate) : "",                                                                                                                                                                                
                    // 요청납기일 옆 D-day (출고 끝난 건은 표시 안 함)                                                                                                                                                                                                         
                    dText: dd.text, dState: dd.state,                                                                                                                                                                                                          
                    // 출고일 : 완료면 "날짜 출고완", 출고문서만 있으면 "예정 날짜"                                                                                                                                                                                                   
                    giText: r.ActualGI ? that._oDate.format(r.ActualGI) + " 출고완"                                                                                                                                                                               
                          : (r.PlannedGI ? "예정 " + that._oDate.format(r.PlannedGI) : "—"),                                                                                                                                                                     
                    // 청구일 : 완료면 "날짜 청구완" (청구 예정일은 데이터가 없어 표시 안 함)                                                                                                                                                                                             
                    biText: r.BillDate ? that._oDate.format(r.BillDate) + " 청구완" : "—"                                                                                                                                                                         
                });                                                                                                                                                                                                                                            
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var m = this.getView().getModel("dash");                                                                                                                                                                                                           
            this._rows = aRows;                                                                                                                                                                                                                                
            m.setProperty("/rows", this._sortRows(aRows));                                                                                                                                                                                                     
            this._counts = cnt;                                                                                                                                                                                                                                
            this._total = aRows.length;                                                                                                                                                                                                                        
