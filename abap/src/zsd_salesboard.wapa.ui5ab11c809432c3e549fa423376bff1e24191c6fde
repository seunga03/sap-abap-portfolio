                row("합계금액", "<b style='color:#3563c9'>" + esc(r.amountText) + " " + esc(r.Currency) + "</b>") +                                                                                                                                                
                row("요청납기일", esc(r.reqDate || "—")) + "</div>" +                                                                                                                                                                                               
                "<div style='font-size:12px;font-weight:700;color:#7a8296;margin-bottom:2px'>문서 흐름</div>" + flow;                                                                                                                                              
            var sec = "<div style='font-size:12px;font-weight:700;color:#7a8296;margin:14px 0 6px'>품목별 조달 현황</div>",                                                                                                                                           
                end = "</div>";                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            if (!this._oDlg) {                                                                                                                                                                                                                                 
                this._oDlgHtml = new HTML({ sanitizeContent: false });                                                                                                                                                                                         
                this._oDlg = new Dialog({                                                                                                                                                                                                                      
                    contentWidth: "640px",                                                                                                                                                                                                                     
                    content: [this._oDlgHtml],                                                                                                                                                                                                                 
                    endButton: new Button({ text: "닫기", press: function () { this._oDlg.close(); }.bind(this) })                                                                                                                                               
                });                                                                                                                                                                                                                                            
                this.getView().addDependent(this._oDlg);                                                                                                                                                                                                       
            }                                                                                                                                                                                                                                                  
            this._oDlg.setTitle(r.SoNumber);                                                                                                                                                                                                                   
            this._oDlgHtml.setContent(html + sec + "<div style='font-size:12px;color:#a3abbd'>품목 불러오는 중…</div>" + end);                                                                                                                                        
            this._oDlg.open();                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // 품목별 조달 현황 (ZTMMA00150 기준 : 주문 / 출고됨 / 재고배정 / 부족)                                                                                                                                                                                                
            var that = this, so = r.SoNumber;                                                                                                                                                                                                                  
            this._dlgSo = so;                                                                                                                                                                                                                                  
            this._oData.read("/ZV_SD_PROC_ITEM", {                                                                                                                                                                                                             
                filters: [new Filter("SoNumber", FilterOperator.EQ, so)],                                                                                                                                                                                      
                success: function (oData) {                                                                                                                                                                                                                    
                    if (that._dlgSo !== so) { return; }                                                                                                                                                                                                        
                    that._oDlgHtml.setContent(html + sec + that._itemTable(oData.results || [], r) + end);                                                                                                                                                     
                },                                                                                                                                                                                                                                             
                error: function () {                                                                                                                                                                                                                           
                    if (that._dlgSo !== so) { return; }                                                                                                                                                                                                        
                    that._oDlgHtml.setContent(html + sec + "<div style='font-size:12px;color:#cf5555'>품목 정보를 읽지 못했어요.</div>" + end);                                                                                                                           
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _itemTable: function (items, r) {                                                                                                                                                                                                                      
            if (!items.length) {                                                                                                                                                                                                                               
                return "<div style='font-size:12px;color:#a3abbd'>예약재고(ZTMMA00150)에 품목 정보가 없어요.</div>";                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
            var f = this._oShort, D = 86400000,                                                                                                                                                                                                                
                now = new Date(), today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()),                                                                                                                                                          
                q = function (v) { var n = parseFloat(v) || 0; return String(Math.round(n * 1000) / 1000); },                                                                                                                                                  
                th = "padding:6px 6px;text-align:right;color:#7a8296;font-weight:600;border-bottom:1px solid #e4e8ef",                                                                                                                                         
                td = "padding:6px 6px;text-align:right;border-bottom:1px solid #f0f2f6";                                                                                                                                                                       
            items.sort(function (a, b) { return String(a.ItemNo).localeCompare(String(b.ItemNo)); });                                                                                                                                                          
            var body = items.map(function (it) {                                                                                                                                                                                                               
                var ord = parseFloat(it.OrderQty) || 0, iss = parseFloat(it.IssuedQty) || 0, sh = parseFloat(it.ShortQty) || 0,                                                                                                                                
                    st, col;                                                                                                                                                                                                                                   
                if (sh > 0) {                                                                                                                                                                                                                                  
                    var exp = it.LeadDays > 0 && r.OrderDate ? new Date(r.OrderDate.getTime() + it.LeadDays * D) : null,                                                                                                                                       
                        over = exp && exp.getTime() < today,                                                                                                                                                                                                   
                        late = over || (exp && r.ReqDate && exp.getTime() > r.ReqDate.getTime());                                                                                                                                                              
                    st = over ? "입고 지연 · 예정 " + f.format(exp) + " 지남"                                                                                                                                                                                          
                              : "조달중 · " + (exp ? "입고예정 " + f.format(exp) : "입고예정 미정");                                                                                                                                                                        
                    col = late ? "#cf5555" : "#b8891f";                                                                                                                                                                                                        
                } else if (ord > 0 && iss >= ord) {                                                                                                                                                                                                            
                    st = "출고완료"; col = "#3a9a6e";                                                                                                                                                                                                              
                } else {                                                                                                                                                                                                                                       
                    st = "재고확보"; col = "#3563c9";                                                                                                                                                                                                              
                }                                                                                                                                                                                                                                              
                return "<tr><td style='" + td + ";text-align:left'>" + esc(String(it.ItemNo).replace(/^0+/, "")) + "</td>" +                                                                                                                                   
                    "<td style='" + td + ";text-align:left;font-weight:600'>" + esc(it.Material) + "</td>" +                                                                                                                                                   
                    "<td style='" + td + "'>" + q(it.OrderQty) + " " + esc(it.Unit || "") + "</td>" +                                                                                                                                                          
                    "<td style='" + td + "'>" + q(it.IssuedQty) + "</td>" +                                                                                                                                                                                    
                    "<td style='" + td + "'>" + q(it.ReservedQty) + "</td>" +                                                                                                                                                                                  
                    "<td style='" + td + ";color:" + (sh > 0 ? "#cf5555;font-weight:700" : "#a3abbd") + "'>" + q(it.ShortQty) + "</td>" +                                                                                                                      
                    "<td style='" + td + ";text-align:left;color:" + col + ";font-weight:600;white-space:nowrap'>" + esc(st) +                                                                                                                                 
                    (sh > 0 ? "<div style='font-weight:400;color:#7a8296;font-size:10px'>Lead Time " + esc(it.LeadDays) + "일</div>" : "") + "</td></tr>";                                                                                                      
            }).join("");                                                                                                                                                                                                                                       
            return "<table style='width:100%;border-collapse:collapse;font-size:12px'>" +                                                                                                                                                                      
                "<tr><th style='" + th + ";text-align:left'>품목</th><th style='" + th + ";text-align:left'>자재</th><th style='" + th + "'>주문</th>" +                                                                                                             
                "<th style='" + th + "'>출고됨</th><th style='" + th + "'>재고배정</th><th style='" + th + "'>부족</th><th style='" + th + ";text-align:left'>상태</th></tr>" +                                                                                           
                body + "</table>";                                                                                                                                                                                                                             
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onListSearch: function (oEvent) {                                                                                                                                                                                                                      
            this._query = oEvent.getParameter("newValue") || "";                                                                                                                                                                                               
            this._applyListFilter();                                                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _applyListFilter: function () {                                                                                                                                                                                                                        
            var aF = [];                                                                                                                                                                                                                                       
            if (this._stage === "RISK") {                                                                                                                                                                                                                      
                aF.push(new Filter("reason", FilterOperator.NE, ""));                                                                                                                                                                                          
            } else if (this._stage) {                                                                                                                                                                                                                          
                aF.push(new Filter("SoStatus", FilterOperator.EQ, this._stage));                                                                                                                                                                               
            }                                                                                                                                                                                                                                                  
            if (this._query) {                                                                                                                                                                                                                                 
                aF.push(new Filter({                                                                                                                                                                                                                           
                    filters: [                                                                                                                                                                                                                                 
                        new Filter("SoNumber", FilterOperator.Contains, this._query),                                                                                                                                                                          
                        new Filter("CustomerName", FilterOperator.Contains, this._query)                                                                                                                                                                       
                    ],                                                                                                                                                                                                                                         
                    and: false                                                                                                                                                                                                                                 
                }));                                                                                                                                                                                                                                           
            }                                                                                                                                                                                                                                                  
            this.byId("list").getBinding("items").filter(aF.length ? new Filter({ filters: aF, and: true }) : []);                                                                                                                                             
                                                                                                                                                                                                                                                               
            var st = STAGES.filter(function (s) { return s.key === this._stage; }.bind(this))[0],                                                                                                                                                              
                nRisk = (this.getView().getModel("dash").getProperty("/rows") || []).filter(function (r) { return r.reason; }).length,                                                                                                                         
                title = this._stage === "RISK" ? "판매오더 목록 · 납기 지연 " + nRisk + "건" : st ? "판매오더 목록 · " + st.label + " " + (this._counts ? this._counts[st.key] : 0) + "건"                                                                                       
                           : "판매오더 목록 · 전체 " + (this._total || 0) + "건";                                                                                                                                                                                       
            this.getView().getModel("dash").setProperty("/listTitle", title);                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               