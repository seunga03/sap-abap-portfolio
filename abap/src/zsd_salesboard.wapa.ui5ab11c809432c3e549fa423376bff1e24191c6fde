        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ---------- 목록 정렬 : 급한 순 / 납기순 / 최신순 / 진행단계순 ----------                                                                                                                                                                                              
        onSortChange: function (oEvent) {                                                                                                                                                                                                                      
            this._sortMode = oEvent.getParameter("item").getKey();                                                                                                                                                                                             
            if (this._rows) {                                                                                                                                                                                                                                  
                this.getView().getModel("dash").setProperty("/rows", this._sortRows(this._rows));                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _sortRows: function (aRows) {                                                                                                                                                                                                                          
            var mode = this._sortMode || "URG",                                                                                                                                                                                                                
                STEP = { SO: 0, DO: 1, GI: 2, BI: 3 },                                                                                                                                                                                                         
                req = function (r) { return r.ReqDate ? r.ReqDate.getTime() : 9e15; },                                                                                                                                                                         
                newest = function (a, b) {                                                                                                                                                                                                                     
                    return (b.OrderDate || 0) - (a.OrderDate || 0) || String(b.SoNumber).localeCompare(String(a.SoNumber));                                                                                                                                    
                },                                                                                                                                                                                                                                             
                // 급한 정도 : 0 납기 지나 바로 처리 / 1 조달 지연 / 2 3일 이내·청구 대기 / 3 나머지 진행 중 / 4 청구 완료                                                                                                                                                                      
                urg = function (r) {                                                                                                                                                                                                                           
                    if (r.act === "R") { return 0; }                                                                                                                                                                                                           
                    if (r.reason) { return 1; }                                                                                                                                                                                                                
                    if (r.act === "Y") { return 2; }                                                                                                                                                                                                           
                    return r.SoStatus === "BI" ? 4 : 3;                                                                                                                                                                                                        
                };                                                                                                                                                                                                                                             
            return aRows.slice().sort(function (a, b) {                                                                                                                                                                                                        
                if (mode === "NEW") { return newest(a, b); }                                                                                                                                                                                                   
                if (mode === "REQ") { return ((a.SoStatus === "BI") - (b.SoStatus === "BI")) || req(a) - req(b) || newest(a, b); }                                                                                                                             
                if (mode === "STEP") { return (STEP[a.SoStatus] || 0) - (STEP[b.SoStatus] || 0) || req(a) - req(b) || newest(a, b); }                                                                                                                          
                return urg(a) - urg(b) || req(a) - req(b) || newest(a, b);                                                                                                                                                                                     
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ---------- 카드 + 차트 HTML ----------                                                                                                                                                                                                                  
        _buildHtml: function (total, sum, cnt, ext, why, cust, from, to) {                                                                                                                                                                                     
            var that = this,                                                                                                                                                                                                                                   
                risk = why["조달 지연"] + why["출고 지시 지연"] + why["출고처리 지연"],                                                                                                                                                                                        
                h = "<div class='kd'><style>" + CSS + "</style>";                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            h += "<div class='kd-t'>판매 프로세스 현황 · 주문일 " + this._oDate.format(utcDay(from)) +                                                                                                                                                                    
                 " ~ " + this._oDate.format(utcDay(to)) + "</div>";                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            // 건수 카드 (누르면 아래 목록이 그 단계로 걸러짐)                                                                                                                                                                                                                    
            var subs = {                                                                                                                                                                                                                                       
                SO: "조달중 " + ext.short + " · 재고확보 " + ext.stock,                                                                                                                                                                                               
                DO: "출고처리 대기",                                                                                                                                                                                                                                 
                GI: "청구 대기",                                                                                                                                                                                                                                   
                BI: "청구 완료"                                                                                                                                                                                                                                    
            };                                                                                                                                                                                                                                                 
            h += "<div class='kd-row'>";                                                                                                                                                                                                                       
            h += this._card("", "N", "전체 주문", total + "건", "합계 " + fmt1(sum / 100000000) + "억원");                                                                                                                                                              
            STAGES.forEach(function (s) {                                                                                                                                                                                                                      
                h += that._card(s.key, s.color, s.label, cnt[s.key] + "건", subs[s.key]);                                                                                                                                                                       
            });                                                                                                                                                                                                                                                
            h += this._card("RISK", risk > 0 ? "R" : "N", "납기 지연", risk + "건",                                                                                                                                                                                 
                            "기한 초과 " + why.over + " · 지연 예상 " + why.exp);                                                                                                                                                                                      
            h += "</div>";                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            // 차트 3개                                                                                                                                                                                                                                           
            h += "<div class='kd-row'>";                                                                                                                                                                                                                       
            h += this._ring("진행 단계별 건수", STAGES.map(function (s) {                                                                                                                                                                                             
                return { label: s.label, value: cnt[s.key], color: s.color };                                                                                                                                                                                  
            }), total + "건");                                                                                                                                                                                                                                  
            h += this._hbar("납기 지연 원인별 건수", [                                                                                                                                                                                                                  
                { label: "조달 지연",      value: why["조달 지연"],      color: "R" },                                                                                                                                                                                 
                { label: "출고 지시 지연", value: why["출고 지시 지연"], color: "Y" },                                                                                                                                                                                     
                { label: "출고처리 지연",  value: why["출고처리 지연"],  color: "B" }                                                                                                                                                                                      
            ]);                                                                                                                                                                                                                                                
            h += this._hbar("고객별 주문금액 Top 5 (억원)", Object.keys(cust).map(function (k) {                                                                                                                                                                        
                return { label: k, value: cust[k] / 100000000 };                                                                                                                                                                                               
            }).sort(function (a, b) { return b.value - a.value; }).slice(0, 5));                                                                                                                                                                               
            h += "</div>";                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            h += "<div class='kd-f'>카드를 누르면 아래 목록이 걸러져요 · 판매문서를 누르면 상세가 보여요</div></div>";                                                                                                                                                                      
            return h;                                                                                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _card: function (stage, color, label, value, sub) {                                                                                                                                                                                                    
            var on = stage !== null && stage === this._stage ? " on" : "",                                                                                                                                                                                     
                attr = stage === null ? "" : " data-stage='" + stage + "'";                                                                                                                                                                                    
            return "<div class='kd-card c" + color + on + "'" + attr + ">" +                                                                                                                                                                                   
                   "<div class='kd-l'>" + esc(label) + "</div><div class='kd-v'>" + esc(value) + "</div>" +                                                                                                                                                    
                   "<div class='kd-s'>" + esc(sub) + "</div></div>";                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _ring: function (title, items, center) {                                                                                                                                                                                                               
            var total = items.reduce(function (a, i) { return a + i.value; }, 0),                                                                                                                                                                              
                h = "<div class='kd-w'><div class='kd-wt'>" + esc(title) + "</div>";                                                                                                                                                                           
            if (!total) {                                                                                                                                                                                                                                      
                return h + "<span class='kd-nd'>데이터 없음</span></div>";                                                                                                                                                                                          
            }                                                                                                                                                                                                                                                  
            var cum = 0,                                                                                                                                                                                                                                       
                svg = "<svg width='130' height='130' viewBox='0 0 42 42'>" +                                                                                                                                                                                   
                      "<circle cx='21' cy='21' r='15.9155' fill='none' stroke='#eceff5' stroke-width='6.5'></circle>";                                                                                                                                         
            items.forEach(function (i) {                                                                                                                                                                                                                       
                if (!i.value) { return; }                                                                                                                                                                                                                      
                var p = i.value / total * 100;                                                                                                                                                                                                                 
                svg += "<circle cx='21' cy='21' r='15.9155' fill='none' stroke='" + COLOR[i.color] + "' stroke-width='6.5'" +                                                                                                                                  
                       " stroke-dasharray='" + p.toFixed(2) + " " + (100 - p).toFixed(2) + "'" +                                                                                                                                                               
                       " stroke-dashoffset='" + (25 - cum).toFixed(2) + "'></circle>";                                                                                                                                                                         
                cum += p;                                                                                                                                                                                                                                      
            });                                                                                                                                                                                                                                                
            svg += "<text x='21' y='23.5' text-anchor='middle' font-size='6' font-weight='bold' fill='#3b4358'>" +                                                                                                                                             
                   esc(center) + "</text></svg>";                                                                                                                                                                                                              
            var lg = "<div class='kd-lg'>";                                                                                                                                                                                                                    
            items.forEach(function (i) {                                                                                                                                                                                                                       
                lg += "<div><span class='kd-sq' style='background:" + COLOR[i.color] + "'></span>" + esc(i.label) + " " +                                                                                                                                      
                      i.value + " (" + Math.round(i.value / total * 100) + "%)</div>";                                                                                                                                                                         
            });                                                                                                                                                                                                                                                
            return h + "<div class='kd-ring'>" + svg + lg + "</div></div></div>";                                                                                                                                                                              
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _hbar: function (title, items) {                                                                                                                                                                                                                       
            var max = items.reduce(function (a, i) { return Math.max(a, i.value); }, 0),                                                                                                                                                                       
                h = "<div class='kd-w'><div class='kd-wt'>" + esc(title) + "</div>";                                                                                                                                                                           
            if (!items.length) {                                                                                                                                                                                                                               
                return h + "<span class='kd-nd'>데이터 없음</span></div>";                                                                                                                                                                                          
            }                                                                                                                                                                                                                                                  
            items.forEach(function (i) {                                                                                                                                                                                                                       
                var w = max > 0 ? Math.max(2, Math.round(i.value / max * 100)) : 0;                                                                                                                                                                            
                h += "<div class='kd-hr'><span class='kd-hl' title='" + esc(i.label) + "'>" + esc(i.label) + "</span>" +                                                                                                                                       
                     "<span class='kd-ht'><span class='kd-hf' style='background:" + COLOR[i.color || "B"] + ";width:" + w + "%'></span></span>" +                                                                                                              
                     "<span class='kd-hv'>" + fmt1(i.value) + "</span></div>";                                                                                                                                                                                 
            });                                                                                                                                                                                                                                                
            return h + "</div>";                                                                                                                                                                                                                               
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _trend: function (title, items) {                                                                                                                                                                                                                      
            var max = items.reduce(function (a, i) { return Math.max(a, i.value); }, 0),                                                                                                                                                                       
                h = "<div class='kd-w'><div class='kd-wt'>" + esc(title) + "</div>";                                                                                                                                                                           
