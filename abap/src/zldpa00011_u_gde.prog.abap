  APPEND 'IAowMDAwMDM5ODg4IDAwMDAwIG4gCnRyYWlsZXIKPDwKL0lEIApbPDA1YjRiNzM0Mjc3OWM0NTZhMGUyZjkyNjA1OGI1NzhmPjwwNWI0YjczNDI3NzljNDU2YTBlMmY5MjYwNThiNTc4Zj5dCiUgUmVwb3J0TGFiIGdlbmVyYXRlZCBQREYgZG9jdW1lbnQgLS0gZGln' TO lt_b64.
  APPEND 'ZXN0IChvcGVuc291cmNlKQoKL0luZm8gMTQgMCBSCi9Sb290IDEzIDAgUgovU2l6ZSAxOAo+PgpzdGFydHhyZWYKNDI3MDIKJSVFT0YK' TO lt_b64.

  " 2) 조각을 하나의 문자열로 이어 붙인다
  LOOP AT lt_b64 ASSIGNING <lv_line>.
    CONCATENATE lv_b64 <lv_line> INTO lv_b64.
  ENDLOOP.

  " 3) base64 -> 바이트(xstring) 변환
  CALL METHOD cl_http_utility=>decode_x_base64
    EXPORTING
      encoded = lv_b64
    RECEIVING
      decoded = lv_xpdf.

  " 4) xstring -> 바이너리 테이블 변환 (gui_download 용)
  CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
    EXPORTING
      buffer        = lv_xpdf
    IMPORTING
      output_length = lv_len
    TABLES
      binary_tab    = lt_bin.

  " 5) 저장 위치 묻기 (기본 파일명 지정)
  cl_gui_frontend_services=>file_save_dialog(
    EXPORTING
      default_extension = 'pdf'
      default_file_name = 'ZDP11_사용가이드.pdf'
      file_filter       = 'PDF (*.pdf)|*.pdf'
    CHANGING
      filename          = lv_fname
      path              = lv_path
      fullpath          = lv_full
      user_action       = lv_act
    EXCEPTIONS
      OTHERS            = 1 ).
  IF sy-subrc <> 0 OR lv_act <> cl_gui_frontend_services=>action_ok.
    RETURN.        " 취소하면 아무 것도 하지 않음
  ENDIF.

  " 6) PC에 저장
  cl_gui_frontend_services=>gui_download(
    EXPORTING
      bin_filesize = lv_len
      filename     = lv_full
      filetype     = 'BIN'
    CHANGING
      data_tab     = lt_bin
    EXCEPTIONS
      OTHERS       = 1 ).
  IF sy-subrc = 0.
    MESSAGE '사용 가이드를 저장했습니다.' TYPE 'S'.
  ELSE.
    MESSAGE '사용 가이드 저장에 실패했습니다.' TYPE 'S' DISPLAY LIKE 'E'.
  ENDIF.

ENDFORM.
