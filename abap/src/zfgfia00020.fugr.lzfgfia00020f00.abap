*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: ZVFIA00010......................................*
FORM GET_DATA_ZVFIA00010.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZTFIA00070 WHERE
(VIM_WHERETAB) .
    CLEAR ZVFIA00010 .
ZVFIA00010-MANDT =
ZTFIA00070-MANDT .
ZVFIA00010-BNKAC =
ZTFIA00070-BNKAC .
ZVFIA00010-BANKA =
ZTFIA00070-BANKA .
ZVFIA00010-BANKN =
ZTFIA00070-BANKN .
ZVFIA00010-ERDAT =
ZTFIA00070-ERDAT .
ZVFIA00010-ERZET =
ZTFIA00070-ERZET .
ZVFIA00010-ERNAM =
ZTFIA00070-ERNAM .
ZVFIA00010-AEDAT =
ZTFIA00070-AEDAT .
ZVFIA00010-AEZET =
ZTFIA00070-AEZET .
ZVFIA00010-AENAM =
ZTFIA00070-AENAM .
<VIM_TOTAL_STRUC> = ZVFIA00010.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZVFIA00010 .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZVFIA00010.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZVFIA00010-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZTFIA00070 WHERE
  BNKAC = ZVFIA00010-BNKAC .
    IF SY-SUBRC = 0.
    DELETE ZTFIA00070 .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZTFIA00070 WHERE
  BNKAC = ZVFIA00010-BNKAC .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZTFIA00070.
    ENDIF.
ZTFIA00070-MANDT =
ZVFIA00010-MANDT .
ZTFIA00070-BNKAC =
ZVFIA00010-BNKAC .
ZTFIA00070-BANKA =
ZVFIA00010-BANKA .
ZTFIA00070-BANKN =
ZVFIA00010-BANKN .
ZTFIA00070-ERDAT =
ZVFIA00010-ERDAT .
ZTFIA00070-ERZET =
ZVFIA00010-ERZET .
ZTFIA00070-ERNAM =
ZVFIA00010-ERNAM .
ZTFIA00070-AEDAT =
ZVFIA00010-AEDAT .
ZTFIA00070-AEZET =
ZVFIA00010-AEZET .
ZTFIA00070-AENAM =
ZVFIA00010-AENAM .
    IF SY-SUBRC = 0.
    UPDATE ZTFIA00070 ##WARN_OK.
    ELSE.
    INSERT ZTFIA00070 .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZVFIA00010-UPD_FLAG,
STATUS_ZVFIA00010-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
