ZTFIA00070-ERZET .
ZVFIA00010-ERNAM =
ZTFIA00070-ERNAM .
ZVFIA00010-AEDAT =
ZTFIA00070-AEDAT .
ZVFIA00010-AEZET =
ZTFIA00070-AEZET .
