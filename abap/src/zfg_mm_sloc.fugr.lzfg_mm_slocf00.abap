FORM GET_DATA_ZVMMA00050.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZTCMA00150 WHERE
(VIM_WHERETAB) .
    CLEAR ZVMMA00050 .
ZVMMA00050-MANDT =
ZTCMA00150-MANDT .
ZVMMA00050-LGORT =
ZTCMA00150-LGORT .
ZVMMA00050-WERKS =
ZTCMA00150-WERKS .
ZVMMA00050-LGOBE =
ZTCMA00150-LGOBE .
ZVMMA00050-VSTEL =
ZTCMA00150-VSTEL .
ZVMMA00050-LAND1 =
ZTCMA00150-LAND1 .
ZVMMA00050-ACTYN =
ZTCMA00150-ACTYN .
ZVMMA00050-ERDAT =
ZTCMA00150-ERDAT .
ZVMMA00050-ERZET =
ZTCMA00150-ERZET .
ZVMMA00050-ERNAM =
ZTCMA00150-ERNAM .
ZVMMA00050-AEDAT =
ZTCMA00150-AEDAT .
ZVMMA00050-AEZET =
ZTCMA00150-AEZET .
ZVMMA00050-AENAM =
ZTCMA00150-AENAM .
<VIM_TOTAL_STRUC> = ZVMMA00050.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZVMMA00050 .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZVMMA00050.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZVMMA00050-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZTCMA00150 WHERE
  LGORT = ZVMMA00050-LGORT AND
  WERKS = ZVMMA00050-WERKS .
    IF SY-SUBRC = 0.
    DELETE ZTCMA00150 .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZTCMA00150 WHERE
  LGORT = ZVMMA00050-LGORT AND
  WERKS = ZVMMA00050-WERKS .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZTCMA00150.
    ENDIF.
ZTCMA00150-MANDT =
ZVMMA00050-MANDT .
ZTCMA00150-LGORT =
ZVMMA00050-LGORT .
ZTCMA00150-WERKS =
ZVMMA00050-WERKS .
ZTCMA00150-LGOBE =
ZVMMA00050-LGOBE .
ZTCMA00150-VSTEL =
ZVMMA00050-VSTEL .
ZTCMA00150-LAND1 =
ZVMMA00050-LAND1 .
ZTCMA00150-ACTYN =
ZVMMA00050-ACTYN .
ZTCMA00150-ERDAT =
ZVMMA00050-ERDAT .
ZTCMA00150-ERZET =
ZVMMA00050-ERZET .
ZTCMA00150-ERNAM =
ZVMMA00050-ERNAM .
ZTCMA00150-AEDAT =
ZVMMA00050-AEDAT .
ZTCMA00150-AEZET =
ZVMMA00050-AEZET .
ZTCMA00150-AENAM =
ZVMMA00050-AENAM .
    IF SY-SUBRC = 0.
    UPDATE ZTCMA00150 ##WARN_OK.
    ELSE.
    INSERT ZTCMA00150 .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZVMMA00050-UPD_FLAG,
STATUS_ZVMMA00050-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
