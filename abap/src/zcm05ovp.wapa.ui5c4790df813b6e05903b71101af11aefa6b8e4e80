sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/mvc/Controller",                                                                                                                                                                                                                              
    "sap/ui/model/odata/v4/ODataModel",                                                                                                                                                                                                                        
    "cm05ovp/ext/common/FilterHelper"                                                                                                                                                                                                                          
], function (Controller, ODataModel, FilterHelper) {                                                                                                                                                                                                           
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var SERVICE_URL = "/sap/opu/odata4/sap/zui_exception_stat_o4/srvd/sap/zui_exception_stat/0001/";                                                                                                                                                           
                                                                                                                                                                                                                                                               
    return Controller.extend("cm05ovp.ext.kpiCard.KpiCard", {                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        onInit: function () {                                                                                                                                                                                                                                  
            this._oModel = new ODataModel({                                                                                                                                                                                                                    
                serviceUrl: SERVICE_URL,                                                                                                                                                                                                                       
                synchronizationMode: "None",                                                                                                                                                                                                                   
                operationMode: "Server",                                                                                                                                                                                                                       
                groupId: "$direct"                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
            FilterHelper.subscribe(this._load.bind(this));                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _load: function (aFilters) {                                                                                                                                                                                                                           
            this._oModel.bindList("/ExceptionStat", null, null, aFilters)                                                                                                                                                                                      
                .requestContexts(0, 1000)                                                                                                                                                                                                                      
                .then(function (aCtx) {                                                                                                                                                                                                                        
                    this._render(aCtx.map(function (c) { return c.getObject(); }));                                                                                                                                                                            
                }.bind(this))                                                                                                                                                                                                                                  
                .catch(function (e) {                                                                                                                                                                                                                          
                    this._set("<div style='padding:16px;color:#cf5555'>데이터 로딩 실패: " + e.message + "</div>");                                                                                                                                                   
                }.bind(this));                                                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
        _set: function (sHtml) {                                                                                                                                                                                                                               
            this.byId("kpiHtml").setContent(sHtml);                                                                                                                                                                                                            
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _render: function (rows) {                                                                                                                                                                                                                             
            var sum = function (f) {                                                                                                                                                                                                                           
                return rows.reduce(function (a, r) { return a + (Number(r[f]) || 0); }, 0);                                                                                                                                                                    
            };                                                                                                                                                                                                                                                 
            var total = sum("TotalCnt");                                                                                                                                                                                                                       
            var open = sum("OpenCnt") + sum("ProgCnt") + sum("ActnCnt");                                                                                                                                                                                       
            var done = sum("ClosedCnt") + sum("RjctCnt");                                                                                                                                                                                                      
            var rate = total ? Math.round(done / total * 1000) / 10 : 0;                                                                                                                                                                                       
            var avgDays = sum("DoneDays"), avgCnt = sum("DoneCnt");                                                                                                                                                                                            
            var avg = avgCnt ? Math.round(avgDays / avgCnt * 10) / 10 : "-";                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            var tile = function (bg, fg, label, value, unit) {                                                                                                                                                                                                 
                return "<div style='flex:1;background:" + bg + ";border-radius:14px;padding:14px 16px'>" +                                                                                                                                                     
                       "<div style='font-size:12px;color:#7a8296'>" + label + "</div>" +                                                                                                                                                                       
                       "<div style='font-size:34px;font-weight:700;color:" + fg + ";margin-top:4px'>" +                                                                                                                                                        
                       value + "<span style='font-size:13px;font-weight:400;margin-left:3px'>" + unit + "</span></div></div>";                                                                                                                                 
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            this._set(                                                                                                                                                                                                                                         
                "<div style='min-height:150px;padding:16px;font-family:Malgun Gothic,sans-serif;color:#3b4358'>" +                                                                                                                                             
                  "<div style='font-size:15px;font-weight:700;color:#2c3347;margin-bottom:12px'>Exception 한눈에 보기</div>" +                                                                                                                                      
                  "<div style='display:flex;gap:10px'>" +                                                                                                                                                                                                      
                    tile("#eef0f4", "#3b4358", "전체", total, "건") +                                                                                                                                                                                             
                    tile("#fdf3dc", "#b8860b", "미결", open, "건") +                                                                                                                                                                                              
                    tile("#e6f6ee", "#2a8a60", "처리율", rate, "%") +                                                                                                                                                                                             
                    tile("#e8f0fd", "#3563c9", "평균 처리일", avg, "일") +                                                                                                                                                                                           
                  "</div>" +                                                                                                                                                                                                                                   
                  "<div style='margin-top:14px;height:8px;background:#eceff5;border-radius:4px'>" +                                                                                                                                                            
                    "<div style='width:" + rate + "%;height:8px;background:#5fb98f;border-radius:4px'></div></div>" +                                                                                                                                          
                  "<div style='margin-top:6px;font-size:12px;color:#7a8296'>종료 + 반려 " + done + "건 / 전체 " + total + "건</div>" +                                                                                                                                 
                "</div>");                                                                                                                                                                                                                                     
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            