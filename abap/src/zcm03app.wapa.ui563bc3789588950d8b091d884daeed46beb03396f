sap.ui.define([                                                                                                                                                                                                                                                
  "sap/m/Dialog", "sap/m/Button", "sap/m/Label", "sap/m/TextArea", "sap/m/VBox",                                                                                                                                                                               
  "sap/m/MessageToast", "sap/m/MessageBox"                                                                                                                                                                                                                     
], function (Dialog, Button, Label, TextArea, VBox, MessageToast, MessageBox) {                                                                                                                                                                                
  "use strict";                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
  function getNamespace(oModel) {                                                                                                                                                                                                                              
    return oModel.getMetaModel().requestObject("/$EntityContainer").then(function (s) {                                                                                                                                                                        
      return s.substring(0, s.lastIndexOf("."));                                                                                                                                                                                                               
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  function getCtx(oEvent) {                                                                                                                                                                                                                                    
    var oBtn = oEvent && oEvent.getSource ? oEvent.getSource() : null;                                                                                                                                                                                         
    return { btn: oBtn, ctx: oBtn && oBtn.getBindingContext() };                                                                                                                                                                                               
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  // 공통 실행기: 상태 확인 → 액션 호출 → 갱신 → 결과 안내                                                                                                                                                                                                                        
  function run(oEvent, cfg) {                                                                                                                                                                                                                                  
    var o = getCtx(oEvent);                                                                                                                                                                                                                                    
    if (!o.ctx) { MessageBox.error("대상 예외 건을 찾지 못했습니다."); return; }                                                                                                                                                                                            
    var oCtx = o.ctx, oModel = oCtx.getModel();                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
    oCtx.requestProperty("prsta").then(function (sSta) {                                                                                                                                                                                                       
      if (cfg.states.indexOf(sSta) < 0) {                                                                                                                                                                                                                      
        MessageToast.show(cfg.stateMsg);                                                                                                                                                                                                                       
        return;                                                                                                                                                                                                                                                
      }                                                                                                                                                                                                                                                        
      return getNamespace(oModel).then(function (sNs) {                                                                                                                                                                                                        
        if (o.btn) { o.btn.setEnabled(false); }          // 더블클릭 방지                                                                                                                                                                                            
        var oOp = oModel.bindContext(sNs + "." + cfg.action + "(...)", oCtx);                                                                                                                                                                                  
        if (cfg.params) {                                                                                                                                                                                                                                      
          Object.keys(cfg.params).forEach(function (k) { oOp.setParameter(k, cfg.params[k]); });                                                                                                                                                               
        }                                                                                                                                                                                                                                                      
        return oOp.execute().then(function () {                                                                                                                                                                                                                
          var oRes = oOp.getBoundContext() && oOp.getBoundContext().getObject();                                                                                                                                                                               
          oCtx.refresh();                                 // 헤더·이력·후속요청 표 갱신                                                                                                                                                                                   
          cfg.done(oRes && oRes.prsta);                                                                                                                                                                                                                        
        });                                                                                                                                                                                                                                                    
      });                                                                                                                                                                                                                                                      
       }).catch(function (oErr) {                                                                                                                                                                                                                              
      var sMsg = (oErr && oErr.message) || cfg.errMsg;                                                                                                                                                                                                         
      if (/not enabled/i.test(sMsg)) {                                                                                                                                                                                                                         
        sMsg = cfg.notEnabledMsg || "현재 상태에서는 실행할 수 없는 작업입니다.";                                                                                                                                                                                                
      }                                                                                                                                                                                                                                                        
      MessageBox.error(sMsg);                                                                                                                                                                                                                                  
    }).finally(function () {                                                                                                                                                                                                                                   
      if (o.btn) { o.btn.setEnabled(true); }                                                                                                                                                                                                                   
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  function openCloseDialog(oEvent) {                                                                                                                                                                                                                           
    var oMemo = new TextArea({ width: "100%", rows: 3, maxLength: 200, placeholder: "종료 메모" });                                                                                                                                                                
    var oDlg = new Dialog({                                                                                                                                                                                                                                    
      title: "종료",                                                                                                                                                                                                                                             
      contentWidth: "26rem",                                                                                                                                                                                                                                   
      content: [new VBox({ items: [new Label({ text: "종료 메모" }), oMemo] })                                                                                                                                                                                     
        .addStyleClass("sapUiSmallMargin")],                                                                                                                                                                                                                   
      beginButton: new Button({                                                                                                                                                                                                                                
        text: "종료", type: "Emphasized",                                                                                                                                                                                                                        
       press: function () {                                                                                                                                                                                                                                    
          var sMemo = oMemo.getValue().trim();                                                                                                                                                                                                                 
          if (!sMemo) {                                                                                                                                                                                                                                        
            oMemo.setValueState("Error");                                                                                                                                                                                                                      
            oMemo.setValueStateText("처리 결과 메모를 입력해 주세요.");                                                                                                                                                                                                     
            return;                                                                                                                                                                                                                                            
          }                                                                                                                                                                                                                                                    
          oDlg.close();                                                                                                                                                                                                                                        
          run(oEvent, {                                                                                                                                                                                                                                        
            action: "close", states: ["ACTN"], params: { memo: sMemo },                                                                                                                                                                                        
            stateMsg: "조치 실행 상태에서만 종료할 수 있습니다.",                                                                                                                                                                                                               
            errMsg: "종료에 실패했습니다.",                                                                                                                                                                                                                             
            done: function () { MessageToast.show("종료되었습니다."); }                                                                                                                                                                                               
          });                                                                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
      }),                                                                                                                                                                                                                                                      
      endButton: new Button({ text: "취소", press: function () { oDlg.close(); } }),                                                                                                                                                                             
      afterClose: function () { oDlg.destroy(); }                                                                                                                                                                                                              
    });                                                                                                                                                                                                                                                        
    oDlg.open();                                                                                                                                                                                                                                               
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  return {                                                                                                                                                                                                                                                     
    onStart: function (oEvent) {                                                                                                                                                                                                                               
      run(oEvent, {                                                                                                                                                                                                                                            
        action: "assignToMe", states: ["OPEN"],                                                                                                                                                                                                                
        stateMsg: "접수 상태에서만 처리를 시작할 수 있습니다.",                                                                                                                                                                                                                  
        errMsg: "처리 시작에 실패했습니다.",                                                                                                                                                                                                                              
        done: function () { MessageToast.show("처리를 시작했습니다."); }                                                                                                                                                                                                
      });                                                                                                                                                                                                                                                      
    },                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    onRecheck: function (oEvent) {                                                                                                                                                                                                                             
      run(oEvent, {                                                                                                                                                                                                                                            
        action: "recheck", states: ["ACTN"],                                                                                                                                                                                                                   
        stateMsg: "조치 실행 상태에서만 재검증할 수 있습니다.",                                                                                                                                                                                                                  
        errMsg: "재검증에 실패했습니다.",                                                                                                                                                                                                                                
        done: function (sNew) {                                                                                                                                                                                                                                
          if (sNew === "CLSD") {                                                                                                                                                                                                                               
            MessageToast.show("재검증을 통과해 종결되었습니다.");                                                                                                                                                                                                            
          } else {                                                                                                                                                                                                                                             
            // 실패: 상태는 조치 실행(ACTN) 유지 — 사유는 처리 이력에 기록됨                                                                                                                                                                                                         
            MessageBox.warning("재검증을 통과하지 못했습니다. 조치 실행 상태가 유지됩니다. 사유는 처리 이력을 확인해 주세요.");                                                                                                                                                                       
          }                                                                                                                                                                                                                                                    
        }                                                                                                                                                                                                                                                      
      });                                                                                                                                                                                                                                                      
    },                                                                                                                                                                                                                                                         
    onReleaseHold: function (oEvent) {                                                                                                                                                                                                                         
      run(oEvent, {                                                                                                                                                                                                                                            
        action: "releaseHold", states: ["ACTN"],                                                                                                                                                                                                               
        stateMsg: "조치 실행 상태에서만 Hold를 해제할 수 있습니다.",                                                                                                                                                                                                             
        errMsg: "Hold 해제에 실패했습니다.",                                                                                                                                                                                                                            
        notEnabledMsg: "지금은 Hold를 해제할 수 없습니다. 후속 요청 처리가 끝났는지 확인해 주세요.",                                                                                                                                                                                        
        done: function () { MessageToast.show("Hold가 해제되었습니다."); }                                                                                                                                                                                             
      });                                                                                                                                                                                                                                                      
    },                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    onClose: function (oEvent) { openCloseDialog(oEvent); }                                                                                                                                                                                                    
  };                                                                                                                                                                                                                                                           
});                                                                                                                                                                                                                                                            