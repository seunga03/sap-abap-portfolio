sap.ui.define([                                                                                                                                                                                                                                                
  "sap/m/Dialog", "sap/m/Button", "sap/m/Label", "sap/m/ComboBox", "sap/m/TextArea",                                                                                                                                                                           
  "sap/m/Text", "sap/m/Title", "sap/m/Popover", "sap/m/VBox", "sap/m/ObjectStatus",                                                                                                                                                                            
  "sap/m/MessageToast", "sap/m/MessageBox", "sap/ui/core/Item",                                                                                                                                                                                                
  "sap/ui/model/Filter", "sap/ui/model/FilterOperator"                                                                                                                                                                                                         
], function (Dialog, Button, Label, ComboBox, TextArea, Text, Title, Popover, VBox,                                                                                                                                                                            
             ObjectStatus, MessageToast, MessageBox, Item, Filter, FilterOperator) {                                                                                                                                                                           
  "use strict";                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
  var VH = {                                                                                                                                                                                                                                                   
    set:  "/ActionTypeVH",  // 서비스에 노출된 엔티티셋 이름                                                                                                                                                                                                                
    key:  "ActionType",         // 조치 코드 필드                                                                                                                                                                                                                    
    text: "ActionName",         // 조치명 필드                                                                                                                                                                                                                      
    src:  "AllowedSrtyp"                    // 허용 발생출처(SRTYP) 필드. 없으면 빈 문자열 → 전체 목록                                                                                                                                                                            
  };                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
  function getNamespace(oModel) {                                                                                                                                                                                                                              
    return oModel.getMetaModel().requestObject("/$EntityContainer").then(function (s) {                                                                                                                                                                        
      return s.substring(0, s.lastIndexOf("."));                                                                                                                                                                                                               
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
  function loadCodes(oModel, sSrtyp) {                                                                                                                                                                                                                         
    // 서버 필터 대신 전체 조회 후 클라이언트에서 SRTYP로 거름 (메타데이터 타입 문제 회피)                                                                                                                                                                                                     
    return oModel.bindList(VH.set).requestContexts(0, 200).then(function (aCtx) {                                                                                                                                                                              
      var aRows = aCtx.map(function (c) { return c.getObject(); });                                                                                                                                                                                            
      console.log("[CM03] VH rows:", aRows.length, "sample:", aRows[0]);                                                                                                                                                                                       
      if (!VH.src || !sSrtyp) { return aRows; }                                                                                                                                                                                                                
      return aRows.filter(function (r) {                                                                                                                                                                                                                       
        return String(r[VH.src] || "").trim() === sSrtyp;                                                                                                                                                                                                      
      });                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  function requestAi(oModel, oCtx, sNs) {                                                                                                                                                                                                                      
    var oOp = oModel.bindContext(sNs + ".getAiRecommend(...)", oCtx);                                                                                                                                                                                          
    return oOp.execute().then(function () {                                                                                                                                                                                                                    
      return Object.assign({}, oOp.getBoundContext().getObject());                                                                                                                                                                                             
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  function openDialog(oCtx, oModel, sExnum, sSrtyp, sNs) {                                                                                                                                                                                                     
    var sAiKey = "";                                                                                                                                                                                                                                           
    var oHideTimer = null;                                                                                                                                                                                                                                     
    var oDotTimer = null;                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
    // ── 컨트롤 ──                                                                                                                                                                                                                                               
    var oHint = new Text({ text: "AI 추천을 불러오는 중…" }).addStyleClass("sapUiTinyMarginTop");                                                                                                                                                                      
    var oCombo = new ComboBox({ width: "100%", placeholder: "조치유형 선택" });                                                                                                                                                                                      
    var oBadge = new ObjectStatus({                                                                                                                                                                                                                            
      text: "AI 추천", icon: "sap-icon://lightbulb", state: "Information", visible: false                                                                                                                                                                        
    }).addStyleClass("sapUiTinyMarginTop");                                                                                                                                                                                                                    
    var oMemo = new TextArea({ width: "100%", rows: 3, maxLength: 200, placeholder: "조치 메모" });                                                                                                                                                                
                                                                                                                                                                                                                                                               
    // ── 호버 말풍선 (근거) ──                                                                                                                                                                                                                                       
    var oWhyTitle = new Title({ text: "AI 추천 근거", level: "H5" });                                                                                                                                                                                              
    var oWhyText = new Text({ text: "" });                                                                                                                                                                                                                     
    var oWhyMeta = new Text({ text: "" }).addStyleClass("sapUiTinyMarginTop");                                                                                                                                                                                 
    var oWhy = new Popover({                                                                                                                                                                                                                                   
      showHeader: false, placement: "Right", contentWidth: "22rem",                                                                                                                                                                                            
      content: [new VBox({ items: [oWhyTitle, oWhyText, oWhyMeta] }).addStyleClass("sapUiSmallMargin")]                                                                                                                                                        
    });                                                                                                                                                                                                                                                        
    function showWhy(oOpener) {                                                                                                                                                                                                                                
      clearTimeout(oHideTimer);                                                                                                                                                                                                                                
      if (sAiKey && !oWhy.isOpen()) { oWhy.openBy(oOpener); }                                                                                                                                                                                                  
    }                                                                                                                                                                                                                                                          
    function hideWhySoon() {                                                                                                                                                                                                                                   
      clearTimeout(oHideTimer);                                                                                                                                                                                                                                
      oHideTimer = setTimeout(function () { if (oWhy.isOpen()) { oWhy.close(); } }, 150);                                                                                                                                                                      
    }                                                                                                                                                                                                                                                          
    [oCombo, oBadge].forEach(function (o) {                                                                                                                                                                                                                    
      o.addEventDelegate({                                                                                                                                                                                                                                     
        onmouseover: function () { showWhy(o); },                                                                                                                                                                                                              
        onmouseout:  hideWhySoon                                                                                                                                                                                                                               
      });                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
    oCombo.attachSelectionChange(function () {                                                                                                                                                                                                                 
      oCombo.setValueState("None");                                                                                                                                                                                                                            
      oBadge.setVisible(!!sAiKey && oCombo.getSelectedKey() === sAiKey);                                                                                                                                                                                       
    });                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
    // ── 확정 ──                                                                                                                                                                                                                                                
    function onConfirm() {                                                                                                                                                                                                                                     
      var sKey = oCombo.getSelectedKey();                                                                                                                                                                                                                      
      if (!sKey) {                                                                                                                                                                                                                                             
        oCombo.setValueState("Error");                                                                                                                                                                                                                         
        oCombo.setValueStateText("조치유형을 선택해 주세요.");                                                                                                                                                                                                            
        return;                                                                                                                                                                                                                                                
      }                                                                                                                                                                                                                                                        
      oDlg.setBusy(true);                                                                                                                                                                                                                                      
      var oOp = oModel.bindContext(sNs + ".decideAction(...)", oCtx);                                                                                                                                                                                          
      oOp.setParameter("acttp", sKey);                                                                                                                                                                                                                         
      oOp.setParameter("memo", oMemo.getValue());                                                                                                                                                                                                              
      oOp.setParameter("ai_acttp", sAiKey);   // 추천 코드 → 채택/거절 기록용                                                                                                                                                                                             
      oOp.execute().then(function () {                                                                                                                                                                                                                         
        oDlg.close();                                                                                                                                                                                                                                          
        oCtx.refresh();                                                                                                                                                                                                                                        
        MessageToast.show("조치가 결정되었습니다.");                                                                                                                                                                                                                     
      }).catch(function (oErr) {                                                                                                                                                                                                                               
        oDlg.setBusy(false);                                                                                                                                                                                                                                   
        MessageBox.error((oErr && oErr.message) || "조치 결정에 실패했습니다.");                                                                                                                                                                                          
      });                                                                                                                                                                                                                                                      
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    var oDlg = new Dialog({                                                                                                                                                                                                                                    
      title: "조치 결정 · " + sExnum,                                                                                                                                                                                                                              
      contentWidth: "28rem",                                                                                                                                                                                                                                   
      content: [                                                                                                                                                                                                                                               
        new VBox({                                                                                                                                                                                                                                             
          items: [                                                                                                                                                                                                                                             
            new Label({ text: "조치유형", required: true, labelFor: oCombo }),                                                                                                                                                                                     
            oCombo, oBadge, oHint,                                                                                                                                                                                                                             
            new Label({ text: "조치 메모" }).addStyleClass("sapUiSmallMarginTop"),                                                                                                                                                                                 
            oMemo                                                                                                                                                                                                                                              
          ]                                                                                                                                                                                                                                                    
        }).addStyleClass("sapUiSmallMargin")                                                                                                                                                                                                                   
      ],                                                                                                                                                                                                                                                       
      beginButton: new Button({ text: "조치 결정", type: "Emphasized", press: onConfirm }),                                                                                                                                                                        
      endButton: new Button({ text: "취소", press: function () { oDlg.close(); } }),                                                                                                                                                                             
            afterClose: function () { clearTimeout(oHideTimer); clearInterval(oDotTimer); oWhy.destroy(); oDlg.destroy(); }                                                                                                                                    
    });                                                                                                                                                                                                                                                        
    oDlg.open();                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
        // ── 허용 코드 목록 + AI 추천 ──                                                                                                                                                                                                                              
    var iDots = 0;                                                                                                                                                                                                                                             
    oCombo.setPlaceholder("AI 추천 분석 중…");                                                                                                                                                                                                                      
    oDotTimer = setInterval(function () {                                                                                                                                                                                                                      
      iDots = (iDots + 1) % 4;                                                                                                                                                                                                                                 
      oHint.setText("AI가 추천 조치를 분석하고 있어요" + ".".repeat(iDots === 0 ? 3 : iDots) +                                                                                                                                                                              
                    " 잠시만 기다려 주세요.");                                                                                                                                                                                                                          
    }, 400);                                                                                                                                                                                                                                                   
    function doneLoading() {                                                                                                                                                                                                                                   
      clearInterval(oDotTimer);                                                                                                                                                                                                                                
      oCombo.setPlaceholder("조치유형 선택");                                                                                                                                                                                                                        
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    loadCodes(oModel, sSrtyp).then(function (aCodes) {                                                                                                                                                                                                         
      aCodes.forEach(function (c) {                                                                                                                                                                                                                            
        oCombo.addItem(new Item({ key: c[VH.key], text: c[VH.key] + " " + (c[VH.text] || "") }));                                                                                                                                                              
      });                                                                                                                                                                                                                                                      
    }).catch(function () {                                                                                                                                                                                                                                     
      MessageToast.show("조치 코드 목록을 불러오지 못했습니다.");                                                                                                                                                                                                              
    }).then(function () {                                                                                                                                                                                                                                      
      return requestAi(oModel, oCtx, sNs);                                                                                                                                                                                                                     
    }).then(function (r) {                                                                                                                                                                                                                                     
      doneLoading();                                                                                                                                                                                                                                           
      if (r.success === "X" && r.acttp) {                                                                                                                                                                                                                      
        sAiKey = r.acttp;                                                                                                                                                                                                                                      
        if (!oCombo.getItemByKey(sAiKey)) {                                                                                                                                                                                                                    
          oCombo.addItem(new Item({ key: sAiKey, text: sAiKey + " " + (r.actnm || "") }));                                                                                                                                                                     
        }                                                                                                                                                                                                                                                      
        if (!oCombo.getSelectedKey()) {                                                                                                                                                                                                                        
          oCombo.setSelectedKey(sAiKey);                                                                                                                                                                                                                       
          oBadge.setVisible(true);                                                                                                                                                                                                                             
        }                                                                                                                                                                                                                                                      
        oWhyText.setText(r.reason || "근거 정보가 없습니다.");                                                                                                                                                                                                          
        oWhyMeta.setText("추천: " + sAiKey + " " + (r.actnm || "") + " · 참고 사례 " + (r.cnt || 0) + "건");                                                                                                                                                          
        oHint.setText("AI가 추천한 조치입니다. 조치유형이나 배지에 마우스를 올리면 근거를 볼 수 있어요.");                                                                                                                                                                                      
      } else {                                                                                                                                                                                                                                                 
        oHint.setText("AI가 이번 건에 대한 추천을 만들지 못했어요. 직접 조치를 선택해 주세요.");                                                                                                                                                                                           
      }                                                                                                                                                                                                                                                        
    }).catch(function (oErr) {                                                                                                                                                                                                                                 
      doneLoading();                                                                                                                                                                                                                                           
      console.error("[CM03] getAiRecommend failed", oErr);                                                                                                                                                                                                     
      oHint.setText("AI 호출에 실패했어요(연결 오류). 직접 조치를 선택하거나 팝업을 닫고 다시 열어 주세요.");                                                                                                                                                                                    
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
&nbsp;&nbsp;                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
  return {                                                                                                                                                                                                                                                     
    onDecide: function (oArg, aSelectedContexts) {                                                                                                                                                                                                             
      var oCtx = (oArg && oArg.getSource) ? oArg.getSource().getBindingContext() : oArg;                                                                                                                                                                       
      oCtx = oCtx || (aSelectedContexts && aSelectedContexts[0]);                                                                                                                                                                                              
      if (!oCtx) { MessageBox.error("대상 예외 건을 찾지 못했습니다."); return; }                                                                                                                                                                                           
      var oModel = oCtx.getModel();                                                                                                                                                                                                                            
      oCtx.requestProperty("prsta").then(function (sSta) {                                                                                                                                                                                                     
        if (sSta !== "PROG") {                                                                                                                                                                                                                                 
          MessageToast.show("처리중 상태에서만 조치를 결정할 수 있습니다.");                                                                                                                                                                                                      
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
        return Promise.all([oCtx.requestProperty("exnum"), oCtx.requestProperty("srtyp"), getNamespace(oModel)])                                                                                                                                               
          .then(function (a) { openDialog(oCtx, oModel, a[0], a[1], a[2]); });                                                                                                                                                                                 
      });                                                                                                                                                                                                                                                      
    }                                                                                                                                                                                                                                                          
  };                                                                                                                                                                                                                                                           
});                                                                                                                                                                                                                                                            