sap.ui.define([                                                                                                                                                                                                                                                
    "sap/m/Dialog",                                                                                                                                                                                                                                            
    "sap/m/Button",                                                                                                                                                                                                                                            
    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "sap/ui/core/HTML",                                                                                                                                                                                                                                        
    "sap/ui/model/Filter",                                                                                                                                                                                                                                     
    "sap/ui/model/odata/v4/ODataModel",                                                                                                                                                                                                                        
    "sap/ui/model/odata/v2/ODataModel",                                                                                                                                                                                                                        
    "cm05ovp/ext/common/NavHelper",                                                                                                                                                                                                                            
    "cm05ovp/ext/common/FilterHelper",                                                                                                                                                                                                                         
    "sap/ui/core/routing/HashChanger"                                                                                                                                                                                                                          
], function (Dialog, Button, MessageToast, HTML, Filter, ODataModelV4, ODataModelV2, NavHelper, FilterHelper, HashChanger) {                                                                                                                                   
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var STAT_URL = "/sap/opu/odata4/sap/zui_exception_stat_o4/srvd/sap/zui_exception_stat/0001/";                                                                                                                                                              
    var CM03_URL = "/sap/opu/odata/sap/ZUI_EXCEPTION_O2/";                                                                                                                                                                                                     
    var GRP = { MM: "자재(MM)", FI: "재무(FI)", QM: "품질(QM)", BOTH: "공동(BOTH)" };                                                                                                                                                                                  
    var STATUS = { OPEN: "접수대기", PROG: "처리중", ACTN: "조치실행중", CLSD: "종료", RJCT: "반려" };                                                                                                                                                                         
    var STATUS_COLOR = {                                                                                                                                                                                                                                       
        OPEN: "#fdf3dc;color:#b8860b",                                                                                                                                                                                                                         
        PROG: "#e8f0fd;color:#3563c9",                                                                                                                                                                                                                         
        ACTN: "#efe8fb;color:#7a58c4"                                                                                                                                                                                                                          
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
    var _v4, _v2;                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    function num(v) { return Number(v) || 0; }                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
    function tile(bg, fg, label, value, unit) {                                                                                                                                                                                                                
        return "<div style='flex:1;min-width:110px;background:" + bg + ";border-radius:14px;padding:12px 16px'>" +                                                                                                                                             
               "<div style='font-size:12px;color:#7a8296'>" + label + "</div>" +                                                                                                                                                                               
               "<div style='font-size:26px;font-weight:700;color:" + fg + ";margin-top:2px'>" + value +                                                                                                                                                        
               "<span style='font-size:12px;font-weight:400;margin-left:3px'>" + unit + "</span></div></div>";                                                                                                                                                 
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    function box(title, inner) {                                                                                                                                                                                                                               
        return "<div style='background:#fff;border-radius:14px;box-shadow:0 1px 3px rgba(60,70,100,.1);overflow:hidden;margin-bottom:16px'>" +                                                                                                                 
               "<div style='padding:14px 20px;border-bottom:1px solid #eceff5;font-size:14px;font-weight:700;color:#2c3347'>" + title + "</div>" +                                                                                                             
               "<div style='padding:20px'>" + inner + "</div></div>";                                                                                                                                                                                          
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    function donut(seg, total) {                                                                                                                                                                                                                               
        var C = 2 * Math.PI * 60, off = 0, circles = "";                                                                                                                                                                                                       
        seg.forEach(function (s) {                                                                                                                                                                                                                             
            var len = total ? s.n / total * C : 0;                                                                                                                                                                                                             
            circles += "<circle cx='80' cy='80' r='60' stroke='" + s.color + "' stroke-dasharray='" + len + " " + C +                                                                                                                                          
                       "' stroke-dashoffset='" + (-off) + "'></circle>";                                                                                                                                                                                       
            off += len;                                                                                                                                                                                                                                        
        });                                                                                                                                                                                                                                                    
        var legend = seg.map(function (s) {                                                                                                                                                                                                                    
            return "<div style='display:flex;align-items:center;gap:8px;margin:4px 0;font-size:13px'>" +                                                                                                                                                       
                   "<span style='width:10px;height:10px;border-radius:2px;background:" + s.color + "'></span>" +                                                                                                                                               
                   "<span style='width:80px;color:#7a8296'>" + s.name + "</span><b>" + s.n + "</b></div>";                                                                                                                                                     
        }).join("");                                                                                                                                                                                                                                           
        return "<div style='display:flex;align-items:center;gap:24px;flex-wrap:wrap'>" +                                                                                                                                                                       
               "<div style='position:relative;width:128px;height:128px'>" +                                                                                                                                                                                    
               "<svg viewBox='0 0 160 160' width='128' height='128'><circle cx='80' cy='80' r='60' fill='none' stroke='#eceff5' stroke-width='22'></circle>" +                                                                                                 
               "<g transform='rotate(-90 80 80)' fill='none' stroke-width='22'>" + circles + "</g></svg>" +                                                                                                                                                    
               "<div style='position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center'>" +                                                                                                                        
               "<span style='font-size:26px;font-weight:700;color:#2c3347;line-height:1'>" + total + "</span>" +                                                                                                                                               
               "<span style='font-size:11px;color:#7a8296'>전체</span></div></div>" +                                                                                                                                                                            
               "<div>" + legend + "</div></div>";                                                                                                                                                                                                              
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    function build(rows, list, title, allRows, label) {                                                                                                                                                                                                        
        var t = rows.reduce(function (a, r) { return a + num(r.TotalCnt); }, 0);                                                                                                                                                                               
        var od = rows.reduce(function (a, r) { return a + num(r.OpenCnt); }, 0);                                                                                                                                                                               
        var pg = rows.reduce(function (a, r) { return a + num(r.ProgCnt); }, 0);                                                                                                                                                                               
        var ac = rows.reduce(function (a, r) { return a + num(r.ActnCnt); }, 0);                                                                                                                                                                               
        var cl = rows.reduce(function (a, r) { return a + num(r.ClosedCnt); }, 0);                                                                                                                                                                             
        var rj = rows.reduce(function (a, r) { return a + num(r.RjctCnt); }, 0);                                                                                                                                                                               
        var open = od + pg + ac, done = cl + rj;                                                                                                                                                                                                               
        var rate = t ? Math.round(done / t * 1000) / 10 : 0;                                                                                                                                                                                                   
        var avgDays = rows.reduce(function (a, r) { return a + num(r.DoneDays); }, 0);                                                                                                                                                                         
        var avgCnt  = rows.reduce(function (a, r) { return a + num(r.DoneCnt); }, 0);                                                                                                                                                                          
        var avg = avgCnt ? Math.round(avgDays / avgCnt * 10) / 10 : "-";                                                                                                                                                                                       
        var kpis = "<div style='display:flex;gap:10px;flex-wrap:wrap'>" +                                                                                                                                                                                      
            tile("#eef0f4", "#3b4358", "전체", t, "건") +                                                                                                                                                                                                         
            tile("#fdf3dc", "#b8860b", "미결", open, "건") +                                                                                                                                                                                                      
            tile("#e6f6ee", "#2a8a60", "처리율", rate, "%") +                                                                                                                                                                                                     
            tile("#e8f0fd", "#3563c9", "평균 처리일", avg, "일") + "</div>";                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
        var seg = [                                                                                                                                                                                                                                            
            { name: "접수대기", n: od, color: "#eab94d" }, { name: "처리중", n: pg, color: "#6f9bec" },                                                                                                                                                               
            { name: "조치실행중", n: ac, color: "#a78bdb" }, { name: "종료", n: cl, color: "#5fb98f" },                                                                                                                                                               
            { name: "반려", n: rj, color: "#a3abbd" }                                                                                                                                                                                                            
        ];                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        var m = {};                                                                                                                                                                                                                                            
        allRows.forEach(function (r) {                                                                                                                                                                                                                         
            var k = r.crmon || "-";                                                                                                                                                                                                                            
            m[k] = m[k] || { t: 0, d: 0 };                                                                                                                                                                                                                     
            m[k].t += num(r.TotalCnt);                                                                                                                                                                                                                         
            m[k].d += num(r.ClosedCnt) + num(r.RjctCnt);                                                                                                                                                                                                       
        });                                                                                                                                                                                                                                                    
        var months = Object.keys(m).sort().map(function (k) {                                                                                                                                                                                                  
            var v = m[k], dw = v.t ? v.d / v.t * 100 : 0;                                                                                                                                                                                                      
            return "<div style='display:flex;align-items:center;gap:12px;margin-bottom:14px'>" +                                                                                                                                                               
                   "<b style='width:60px;font-size:13px;color:#2c3347'>" + k + "</b>" +                                                                                                                                                                        
                   "<div style='flex:1;display:flex;height:20px;border-radius:10px;overflow:hidden;background:#eceff5'>" +                                                                                                                                     
                   "<div style='width:" + (100 - dw) + "%;background:#eab94d'></div><div style='width:" + dw + "%;background:#5fb98f'></div></div>" +                                                                                                          
                   "<span style='width:120px;font-size:12px;color:#7a8296'>" + v.t + "건 · 미결 " + (v.t - v.d) + "</span></div>";                                                                                                                                
        }).join("");                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
        var trs = list.map(function (o) {                                                                                                                                                                                                                      
            var late = num(o.age_days) >= 7;                                                                                                                                                                                                                   
            return "<tr style='border-top:1px solid #eceff5'>" +                                                                                                                                                                                               
                   "<td style='padding:12px 8px;font-weight:700;color:#2c3347'>" + o.exnum + "</td>" +                                                                                                                                                         
                   "<td style='padding:12px 8px'><span style='padding:3px 10px;border-radius:999px;background:" +                                                                                                                                              
                    (STATUS_COLOR[o.prsta] || "#eef0f4;color:#3b4358") + ";font-size:12px'>" +                                                                                                                                                                 
                    (STATUS[o.prsta] || o.prsta) + "</span></td>" +                                                                                                                                                                                            
                   "<td style='padding:12px 8px;color:#7a8296'>" + (GRP[o.owgrp] || o.owgrp) + "</td>" +                                                                                                                                                       
                   "<td style='padding:12px 8px;text-align:right'><span style='padding:3px 10px;border-radius:999px;font-size:12px;background:" +                                                                                                              
                   (late ? "#fdeaea;color:#cf5555" : "#fdf3dc;color:#b8860b") + "'>" + num(o.age_days) + "일</span></td><td style='padding:12px 8px;text-align:right'><a class='cm05GoCm03' data-ex='" + o.exnum +                                              
                    "' style='color:#3563c9;cursor:pointer;font-size:12px'>CM03에서 열기 ›</a></td></tr>";                                                                                                                                                         
        }).join("");                                                                                                                                                                                                                                           
        var table = "<table style='width:100%;border-collapse:collapse;font-size:13px'><thead><tr style='color:#7a8296;text-align:left'>" +                                                                                                                    
                    "<th style='padding:8px;font-weight:500'>Exception 번호</th><th style='padding:8px;font-weight:500'>상태</th>" +                                                                                                                               
                    "<th style='padding:8px;font-weight:500'>담당그룹</th><th style='padding:8px;font-weight:500;text-align:right'>경과일</th><th style='padding:8px;font-weight:500;text-align:right'>이동</th></tr></thead><tbody>" +                                 
                    (trs || "<tr><td colspan='5' style='padding:16px;color:#7a8296'>미결 건이 없어요</td></tr>") + "</tbody></table>";                                                                                                                                
                                                                                                                                                                                                                                                               
        return "<div style='font-family:Malgun Gothic,sans-serif;color:#3b4358;background:#f6f7fb;padding:24px;min-height:100%'>" +                                                                                                                            
                "<div style='display:flex;align-items:center;gap:12px;margin-bottom:16px'>" +                                                                                                                                                                  
                    "<button id='cm05DetailBack' style='border:0;background:#fff;border-radius:999px;padding:6px 14px;" +                                                                                                                                      
                    "box-shadow:0 1px 3px rgba(60,70,100,.1);color:#3563c9;font-size:13px;cursor:pointer'>‹ 뒤로</button>" +                                                                                                                                     
                    "<span style='color:#7a8296;font-size:13px'>Exception 통계 개요 ›</span>" +                                                                                                                                                                    
                    "<b style='font-size:20px;color:#2c3347'>" + title + "</b>" +                                                                                                                                                                              
                    "<span style='font-size:12px;color:#7a8296'>" + label + "</span></div>" +                                                                                                                                                                  
                "<div style='background:#fff;border-radius:14px;box-shadow:0 1px 3px rgba(60,70,100,.1);padding:20px 24px;margin-bottom:16px'>" + kpis + "</div>" +                                                                                            
                "<div style='display:flex;gap:16px;flex-wrap:wrap'>" +                                                                                                                                                                                         
                "<div style='flex:2 1 320px'>" + box("상태 분포 (" + t + "건)", donut(seg, t)) + "</div>" +                                                                                                                                                         
                "<div style='flex:3 1 420px'>" + box("월별 비교", months) + "</div></div>" +                                                                                                                                                                       
                box("미결 Exception (오래된 순, 최대 10건)", table) + "</div>";                                                                                                                                                                                         
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
        function isEQ(c) { return c.operator === "EQ"; }                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
    function monthsOf(mCond) {                                                                                                                                                                                                                                 
        return ((mCond && mCond.crmon) || []).filter(isEQ).map(function (c) { return c.values[0]; });                                                                                                                                                          
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    function labelOf(mCond) {                                                                                                                                                                                                                                  
        var p = monthsOf(mCond);                                                                                                                                                                                                                               
        ((mCond && mCond.owgrp) || []).filter(isEQ).forEach(function (c) {                                                                                                                                                                                     
            p.push(GRP[c.values[0]] || c.values[0]);                                                                                                                                                                                                           
        });                                                                                                                                                                                                                                                    
        return p.length ? "· 필터: " + p.join(" · ") : "";                                                                                                                                                                                                       
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
        /**                                                                                                                                                                                                                                                    
         * @param {string} sSrtyp  발생출처 코드 (SUBC, QM ...)                                                                                                                                                                                                      
         * @param {string} sTitle  화면 제목 (예: 외주 정합성)                                                                                                                                                                                                           
         * @param {object} mCond   상단 필터 조건 (FilterHelper가 넘기는 값)                                                                                                                                                                                              
         */                                                                                                                                                                                                                                                    
        function show(sSrtyp, sTitle, mCond) {                                                                                                                                                                                                                 
            console.log("[DET] open", sSrtyp, JSON.stringify(mCond));                                                                                                                                                                                          
            _v4 = _v4 || new ODataModelV4({ serviceUrl: STAT_URL, synchronizationMode: "None", operationMode: "Server", groupId: "$direct" });                                                                                                                 
            _v2 = _v2 || new ODataModelV2(CM03_URL, { useBatch: false });                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            var oHtml = new HTML({ content: "<div style='padding:24px;color:#7a8296;font-family:Malgun Gothic'>불러오는 중...</div>" });                                                                                                                            
            var oDialog = new Dialog({                                                                                                                                                                                                                         
                stretch: true,                                                                                                                                                                                                                                 
                showHeader: false,                                                                                                                                                                                                                             
                content: [oHtml],                                                                                                                                                                                                                              
                afterClose: function () { oDialog.destroy(); onClosed(); }                                                                                                                                                                                     
            });                                                                                                                                                                                                                                                
            _dlg = oDialog;                                                                                                                                                                                                                                    
            oDialog.open();                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            var aMonths = monthsOf(mCond);                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            // KPI·도넛·월별: 월 필터는 빼고 조회(월별 비교는 전체 월을 보여주기 위해), 나머지 상단 필터는 적용                                                                                                                                                                                     
            var aStatF = FilterHelper.toFilters(mCond, ["srtyp", "crmon"]);                                                                                                                                                                                    
            aStatF.push(new Filter("srtyp", "EQ", sSrtyp));                                                                                                                                                                                                    
            var pStat = _v4.bindList("/ExceptionStat", null, null, aStatF)                                                                                                                                                                                     
                .requestContexts(0, 1000)                                                                                                                                                                                                                      
                .then(function (a) { return a.map(function (c) { return c.getObject(); }); });                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // 표: CM03에는 월 필드가 없어서 월 필터를 발생일(crdat) 범위로 변환                                                                                                                                                                                                     
            var aListF = FilterHelper.toFilters(mCond, ["srtyp", "crmon"]);                                                                                                                                                                                    
            aListF.push(new Filter("srtyp", "EQ", sSrtyp));                                                                                                                                                                                                    
            aListF.push(new Filter({                                                                                                                                                                                                                           
                filters: [                                                                                                                                                                                                                                     
                    new Filter("prsta", "EQ", "OPEN"),                                                                                                                                                                                                         
                    new Filter("prsta", "EQ", "PROG"),                                                                                                                                                                                                         
                    new Filter("prsta", "EQ", "ACTN")                                                                                                                                                                                                          
                ],                                                                                                                                                                                                                                             
                and: false                                                                                                                                                                                                                                     
            }));                                                                                                                                                                                                                                               
            if (aMonths.length) {                                                                                                                                                                                                                              
                var s = aMonths.slice().sort();                                                                                                                                                                                                                
                var f = s[0], l = s[s.length - 1];                                                                                                                                                                                                             
                aListF.push(new Filter("crdat", "BT",                                                                                                                                                                                                          
                    new Date(Date.UTC(+f.slice(0, 4), +f.slice(4, 6) - 1, 1)),                                                                                                                                                                                 
                    new Date(Date.UTC(+l.slice(0, 4), +l.slice(4, 6), 0))));                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            var pList = new Promise(function (res) {                                                                                                                                                                                                           
                _v2.read("/Exception", {                                                                                                                                                                                                                       
                    filters: aListF,                                                                                                                                                                                                                           
                    sorters: [new sap.ui.model.Sorter("crdat", false)],                                                                                                                                                                                        
                    urlParameters: { "$top": 10 },                                                                                                                                                                                                             
                    success: function (d) { res(d.results || []); },                                                                                                                                                                                           
                    error: function () { res([]); }                                                                                                                                                                                                            
                });                                                                                                                                                                                                                                            
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            Promise.all([pStat, pList]).then(function (r) {                                                                                                                                                                                                    
                var all = r[0];                                                                                                                                                                                                                                
                // 선택한 월이 있으면 그 월만 KPI·도넛에 사용, 월별 비교(all)는 전체 월                                                                                                                                                                                                
                var rows = aMonths.length                                                                                                                                                                                                                      
                    ? all.filter(function (x) { return aMonths.indexOf(x.crmon) >= 0; })                                                                                                                                                                       
                    : all;                                                                                                                                                                                                                                     
                oHtml.setContent(build(rows, r[1], sTitle, all, labelOf(mCond)));                                                                                                                                                                              
                setTimeout(function () {                                                                                                                                                                                                                       
                    var b = document.getElementById("cm05DetailBack");                                                                                                                                                                                         
                    if (b) { b.onclick = function () { oDialog.close(); }; }                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
                    document.querySelectorAll(".cm05GoCm03").forEach(function (a) {                                                                                                                                                                            
                        a.onclick = function () {                                                                                                                                                                                                              
                            NavHelper.toCm03(a.getAttribute("data-ex"));                                                                                                                                                                                       
                        };                                                                                                                                                                                                                                     
                    });                                                                                                                                                                                                                                        
                }, 100);                                                                                                                                                                                                                                       
            }).catch(function (e) {                                                                                                                                                                                                                            
                oHtml.setContent("<div style='padding:24px;color:#cf5555'>데이터 로딩 실패: " + e.message + "</div>");                                                                                                                                                
            });                                                                                                                                                                                                                                                
        }                                                                                                                                                                                                                                                      
