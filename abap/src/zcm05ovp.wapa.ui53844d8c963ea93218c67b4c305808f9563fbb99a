        // ── 주소(해시) 연동: …&/detail/SUBC ──                                                                                                                                                                                                                     
    var SRC_NAME = { SUBC: "외주 정합성", QM: "품질 검사", INVC: "송장 정산", RISK: "납기 리스크", PO: "PO" };                                                                                                                                                                   
    var _dlg = null, _bound = false, _pushed = false;                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    function hasher() { return HashChanger.getInstance(); }                                                                                                                                                                                                    
    function parse(sHash) { var m = /^detail\/(\w+)$/.exec(sHash || ""); return m ? m[1] : null; }                                                                                                                                                             
                                                                                                                                                                                                                                                               
    function sync(sHash) {                                                                                                                                                                                                                                     
        var code = parse(sHash);                                                                                                                                                                                                                               
        if (code && !_dlg) {                                                                                                                                                                                                                                   
            show(code, SRC_NAME[code] || code, window.__cm05Cond);                                                                                                                                                                                             
        } else if (!code && _dlg) {                                                                                                                                                                                                                            
            _dlg.close();                                                                                                                                                                                                                                      
        }                                                                                                                                                                                                                                                      
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    function onClosed() {                                                                                                                                                                                                                                      
        _dlg = null;                                                                                                                                                                                                                                           
        if (parse(hasher().getHash())) {            // 닫기 버튼·ESC로 닫은 경우 → 주소에서 detail 제거                                                                                                                                                                       
            if (_pushed) { window.history.back(); } else { hasher().replaceHash(""); }                                                                                                                                                                         
        }                                                                                                                                                                                                                                                      
        _pushed = false;                                                                                                                                                                                                                                       
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    function bind() {                                                                                                                                                                                                                                          
        if (_bound) { return; }                                                                                                                                                                                                                                
        _bound = true;                                                                                                                                                                                                                                         
        hasher().attachEvent("hashChanged", function (e) { sync(e.getParameter("newHash")); });                                                                                                                                                                
        sync(hasher().getHash());                   // 새로고침·주소 직접 입력                                                                                                                                                                                           
    }                                                                                                                                                                                                                                                          
    bind();                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
        open: function (sSrtyp) { _pushed = true; hasher().setHash("detail/" + sSrtyp); }                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            